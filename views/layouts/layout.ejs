<script>
  document.documentElement.classList.add('reveal-ready');

  document.addEventListener('DOMContentLoaded', function () {
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var blocks = Array.prototype.filter.call(
      document.querySelectorAll('main section'),
      function (s) { return !s.querySelector('section'); }
    );
    var vh = function () { return window.innerHeight || document.documentElement.clientHeight; };
    var inView = function (el) { return el.getBoundingClientRect().top < vh() * 0.65; };

    var pending = blocks.slice();
    var anyRevealed = false;
    var drop = function (el) { var i = pending.indexOf(el); if (i > -1) pending.splice(i, 1); };
    var showAnim = function (el) {
      if (el.classList.contains('revealed-instant') || el.classList.contains('is-visible')) return;
      el.classList.add('is-visible'); drop(el); anyRevealed = true;
    };
    var showInstant = function (el) {
      if (el.classList.contains('revealed-instant') || el.classList.contains('is-visible')) return;
      el.classList.add('revealed-instant'); drop(el); anyRevealed = true;
    };

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          showAnim(e.target);
          io.unobserve(e.target);
        });
      }, { threshold: 0, rootMargin: '0px 0px -35% 0px' });
      pending.slice().forEach(function (b) { io.observe(b); });
    }

    var onScroll = function () {
      for (var i = pending.length - 1; i >= 0; i--) {
        if (inView(pending[i])) showAnim(pending[i]);
      }
      if (!pending.length) window.removeEventListener('scroll', onScroll);
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    var revealFirstScreen = function () {
      var h = window.innerHeight || document.documentElement.clientHeight;
      for (var i = pending.length - 1; i >= 0; i--) {
        if (pending[i].getBoundingClientRect().top < h - 24) showAnim(pending[i]);
      }
    };
    window.addEventListener('load', function () {
      revealFirstScreen();
      setTimeout(function () {
        if (blocks[0] && getComputedStyle(blocks[0]).opacity === '0') {
          document.documentElement.classList.remove('reveal-ready');
        }
      }, 1200);
    });
  });
</script>

<!-- Lottie-іконки: програються один раз, коли блок з'являється, і лишаються намальованими -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js" defer></script>
<script>
  (function () {
    function init() {
      if (!window.lottie) return;
      var nodes = Array.prototype.slice.call(document.querySelectorAll('[data-lottie]'));
      if (!nodes.length) return;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      nodes.forEach(function (el) {
        var anim = lottie.loadAnimation({
          container: el,
          renderer: 'svg',
          loop: false,
          autoplay: false,
          path: el.getAttribute('data-lottie')
        });
        var loaded = false, triggered = false, done = false;
        anim.addEventListener('DOMLoaded', function () { loaded = true; if (triggered) run(); });
        function run() {
          if (done || !loaded) return;
          done = true;
          if (reduce) {
            // без анімації — одразу показуємо готову іконку (останній кадр)
            anim.goToAndStop(Math.max(0, anim.totalFrames - 1), true);
          } else {
            anim.goToAndPlay(0, true); // програти раз уперед; loop:false зупинить на останньому кадрі
          }
        }
        function onVisible() {
          if (triggered) return;
          triggered = true;
          run();
        }
        // Запускаємо, коли блок з'являється у полі зору; після цього не скидаємо
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) { onVisible(); io.disconnect(); break; }
            }
          }, { threshold: 0.35 });
          io.observe(el);
        } else {
          onVisible();
        }
      });
    }
    if (document.readyState === 'complete') init();
    else window.addEventListener('load', init);
  })();
</script>

