<!DOCTYPE html>
<html>
<head>
    <title>New Sails App</title>

    <!-- Viewport mobile tag for sensible mobile support -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: { navy: '#012a4a', sky: '#eff6f9', steel: '#527b8d' },
            fontFamily: {
              sans: ['Open Sans', 'Arial', 'sans-serif'],
              display: ['Geologica', 'Arial', 'sans-serif']
            },
            borderRadius: {
              pill: '0.5rem',
              blob: '1.25rem',
              card: '1.875rem',
              hero: '2.1875rem'
            },
            maxWidth: {
              shell: '122rem'
            },
            fontSize: {
              h1: ['clamp(2rem, 0.5rem + 3.125vw, 4rem)', { lineHeight: '1.05', letterSpacing: '-0.03em' }],
              h2: ['clamp(1.25rem, 0.3125rem + 1.953125vw, 2.5rem)', { lineHeight: '1.05', letterSpacing: '-0.03em' }],
              h3: ['clamp(1.125rem, 0.1875rem + 1.171875vw, 1.5rem)', { lineHeight: '1.05', letterSpacing: '-0.03em' }],
              h4: ['1rem', { lineHeight: '1.35' }]
            }
          }
        }
      };
    </script>

    <style>
      /** General */
      @font-face {
        font-family: 'Geologica';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/geologica-cyrillic.woff2') format('woff2');
        unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }
      @font-face {
        font-family: 'Geologica';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/geologica-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Open Sans';
        font-style: normal;
        font-weight: 300 800;
        font-display: swap;
        src: url('/fonts/opensans-cyrillic.woff2') format('woff2');
        unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }
      @font-face {
        font-family: 'Open Sans';
        font-style: normal;
        font-weight: 300 800;
        font-display: swap;
        src: url('/fonts/opensans-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 5rem;
        --reveal-ease: cubic-bezier(.16, 1, .3, 1);
      }

      @view-transition { navigation: auto; }
      ::view-transition-old(root),
      ::view-transition-new(root) { animation-duration: .35s; }

      @media (prefers-reduced-motion: no-preference) {
        html.reveal-ready main section:not(:has(section)) {
          opacity: 0;
          transform: translateY(44px) scale(.94);
          filter: blur(6px);
        }
        html.reveal-ready main section:not(:has(section)).is-visible {
          opacity: 1;
          transform: none;
          filter: none;
          transition: opacity 1.35s var(--reveal-ease),
          transform 1.35s var(--reveal-ease),
          filter 1.35s var(--reveal-ease);
        }

        html.reveal-ready [data-stagger] > * {
          opacity: 0;
          transform: translateY(26px) scale(.97);
        }
        html.reveal-ready main section.is-visible [data-stagger] > * {
          opacity: 1;
          transform: none;
          transition: opacity 1.05s var(--reveal-ease),
          transform 1.05s var(--reveal-ease);
        }
        html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(1)  { transition-delay: 0s;   }
        html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(2)  { transition-delay: .06s; }
        html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(3)  { transition-delay: .12s; }
        html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(4)  { transition-delay: .18s; }
        html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(5)  { transition-delay: .24s; }
        html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(6)  { transition-delay: .30s; }
        html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(7)  { transition-delay: .36s; }
        html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(8)  { transition-delay: .42s; }
        html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(9)  { transition-delay: .48s; }
        html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(n+10) { transition-delay: .54s; }

        html.reveal-ready main section:not(:has(section)).revealed-instant,
        html.reveal-ready main section.revealed-instant [data-stagger] > * {
          opacity: 1;
          transform: none;
          filter: none;
        }
      }

      /** Main page */
      @property --reveal-x {
        syntax: "<percentage>";
        inherits: false;
        initial-value: 34%;
      }

      @keyframes scan-reveal-soft {
        0%, 12% {
          --reveal-x: 34%;
        }

        55%, 85% {
          --reveal-x: 112%;
        }

        100% {
          --reveal-x: 34%;
        }
      }

      @media (min-width: 1536px) {
        @keyframes scan-reveal-soft {
          0%, 12% {
            --reveal-x: 34%;
          }

          55%, 85% {
            --reveal-x: 112%;
          }

          100% {
            --reveal-x: 34%;
          }
        }
      }

      .machine-restored,
      .restored-glow {
        --reveal-x: 34%;

        -webkit-mask-image:
          linear-gradient(
            90deg,
            #000 0,
            #000 calc(var(--reveal-x) - 7rem),
            rgba(0, 0, 0, 0.88) calc(var(--reveal-x) - 3.5rem),
            rgba(0, 0, 0, 0.48) var(--reveal-x),
            rgba(0, 0, 0, 0.14) calc(var(--reveal-x) + 4rem),
            transparent calc(var(--reveal-x) + 7rem),
            transparent 100%
          );

        mask-image:
          linear-gradient(
            90deg,
            #000 0,
            #000 calc(var(--reveal-x) - 7rem),
            rgba(0, 0, 0, 0.88) calc(var(--reveal-x) - 3.5rem),
            rgba(0, 0, 0, 0.48) var(--reveal-x),
            rgba(0, 0, 0, 0.14) calc(var(--reveal-x) + 4rem),
            transparent calc(var(--reveal-x) + 7rem),
            transparent 100%
          );

        animation:
          scan-reveal-soft 10s cubic-bezier(.65, 0, .35, 1) infinite;
      }

      @media (min-width: 1536px) {
        .machine-restored,
        .restored-glow {
          --reveal-x: 34%;
        }
      }

      @keyframes scan-beam {
        0%, 12%  { left: 34%;  opacity: 0; }
        18%      { opacity: 1; }
        50%      { opacity: 1; }
        55%      { left: 100%; opacity: 0; }
        100%     { left: 100%; opacity: 0; }
      }
      @media (min-width: 1536px) {
        @keyframes scan-beam {
          0%, 12%  { left: 34%;  opacity: 0; }
          18%      { opacity: 1; }
          50%      { opacity: 1; }
          55%      { left: 100%; opacity: 0; }
          100%     { left: 100%; opacity: 0; }
        }
      }
      .scan-beam {
        position: absolute; top: -6%; bottom: -6%; left: 0; width: 30px;
        transform: translateX(-50%); pointer-events: none; opacity: 0; z-index: 5;
        mix-blend-mode: screen; filter: blur(.5px);
        background: linear-gradient(90deg,
        transparent 0%,
        rgba(160,215,255,.10) 28%,
        rgba(220,242,255,.95) 50%,
        rgba(160,215,255,.10) 72%,
        transparent 100%);
        box-shadow: 0 0 26px 8px rgba(130,200,255,.55);
        animation: scan-beam 10s cubic-bezier(.65,0,.35,1) infinite;
      }
      .scan-beam::after {
        content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px;
        transform: translateX(-50%); background: rgba(255,255,255,.9);
        box-shadow: 0 0 10px 2px rgba(210,240,255,.9);
      }
      @media (prefers-reduced-motion: reduce) {
        .machine-restored,
        .restored-glow {
          animation: none;
          clip-path: none;

          -webkit-mask-image: none;
          mask-image: none;
        }

        .scan-beam {
          display: none;
        }
      }
      #faq summary::-webkit-details-marker { display: none; }

      /* Переваги у Hero */

      /* Переваги у Hero */

      .hero-benefits {
        display: grid;
        width: 100%;
        gap: 0.75rem;
      }

      .hero-benefit-item {
        position: relative;
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 0.875rem;
        padding: 0.75rem 0;
        border-bottom: 2px solid rgba(82, 123, 141, 0.24);
        text-align: left;
      }

      .hero-benefit-item:last-child {
        border-bottom: 0;
      }

      .hero-benefit-item img {
        height: 40px;
        width: auto;
        flex-shrink: 0;
        object-fit: contain;
      }

      .hero-benefit-sep {
        display: none;
      }

      .hero-benefit-item p {
        min-width: 0;
        margin: 0;
        font-size: 1rem;
        line-height: 1.4;
        color: #15324c;
      }

      /* Десктоп: пункти в один ряд на всю ширину з рівними відступами */
      @media (min-width: 1024px) {
        .hero-benefits {
          display: flex;
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
          gap: 0;
        }

        .hero-benefit-item {
          min-height: 50px;
          flex: 0 1 auto;
          flex-direction: row;
          align-items: center;
          justify-content: center;
          gap: 0.6rem;
          padding: 4px 0;
          border-bottom: 0;
        }

        .hero-benefit-item img {
          height: clamp(34px, 22px + 1.17vw, 40px);
        }

        .hero-benefit-item p {
          margin: 0;
          max-width: 6.5rem;
          font-size: clamp(0.85rem, 0.6rem + 0.4vw, 1rem);
          line-height: 1.2;
          text-align: left;
        }

        .hero-benefit-sep {
          display: block;
          flex: 0 0 auto;
          width: 2px;
          height: 50px;
          background: #527b8d;
        }
      }

      /* Дуже великі екрани: текст пунктів в один рядок */
      @media (min-width: 1536px) {
        .hero-benefit-item p {
          max-width: none;
          white-space: nowrap;
        }
      }

      .hero-cta-icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
      }

      /* Окремий контекст накладання шарів */
      .hero-photo-fade {
        isolation: isolate;
        background: #eef6fa;
      }

      .hero-photo-fade::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 6;
        pointer-events: none;

        background:
          linear-gradient(
            90deg,
            #eef6fa 0%,
            rgba(238, 246, 250, 0.98) 4%,
            rgba(238, 246, 250, 0.82) 8%,
            rgba(238, 246, 250, 0.48) 13%,
            rgba(238, 246, 250, 0.14) 18%,
            transparent 24%
          );
      }

      @media (min-width: 768px) {
        .hero-photo-fade::after {
          display: none;
        }
        .hero-photo-fade {
          background: transparent;
          -webkit-mask-image:
            linear-gradient(90deg, transparent 0%, #000 11%),
            linear-gradient(180deg, transparent 0%, #000 10%, #000 96%, transparent 100%);
          -webkit-mask-composite: source-in;
          mask-image:
            linear-gradient(90deg, transparent 0%, #000 11%),
            linear-gradient(180deg, transparent 0%, #000 10%, #000 96%, transparent 100%);
          mask-composite: intersect;
        }
        .restored-glow {
          display: none;
        }
        .hero-photo-fade .machine-restored {
          filter: none;
        }
        .hero-photo-fade .scan-beam {
          top: 0;
          bottom: 0;
        }
      }

      /* Ноутбучні ширини: сильніше розчиняємо лівий край, щоб верстат менше проступав за текстом */
      @media (min-width: 1201px) and (max-width: 1535px) {
        .hero-photo-fade {
          -webkit-mask-image:
            linear-gradient(90deg, transparent 0%, #000 48%),
            linear-gradient(180deg, transparent 0%, #000 10%, #000 96%, transparent 100%);
          mask-image:
            linear-gradient(90deg, transparent 0%, #000 48%),
            linear-gradient(180deg, transparent 0%, #000 10%, #000 96%, transparent 100%);
        }
      }

      /* Легка технічна сітка та креслярські кола */
      .hero-blueprint-grid {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        overflow: hidden;
        opacity: 0.12;
        mix-blend-mode: multiply;

        background-image:
          linear-gradient(
            rgba(43, 109, 151, 0.62) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(43, 109, 151, 0.62) 1px,
            transparent 1px
          );

        background-size: 42px 42px;

        -webkit-mask-image:
          linear-gradient(
            to left,
            #000 0%,
            #000 76%,
            rgba(0, 0, 0, 0.65) 88%,
            transparent 100%
          );

        mask-image:
          linear-gradient(
            to left,
            #000 0%,
            #000 76%,
            rgba(0, 0, 0, 0.65) 88%,
            transparent 100%
          );
      }

      .hero-blueprint-grid::before {
        content: "";
        position: absolute;
        top: -12%;
        right: -10%;
        width: 84%;
        aspect-ratio: 1;
        border-radius: 50%;

        background:
          repeating-radial-gradient(
            circle at center,
            transparent 0 62px,
            rgba(43, 109, 151, 0.9) 63px 64px,
            transparent 65px 106px
          );
      }

      .hero-blueprint-grid::after {
        content: "";
        position: absolute;
        top: 4%;
        right: 0;
        width: 72%;
        height: 72%;

        background:
          linear-gradient(
            90deg,
            transparent 49.85%,
            rgba(43, 109, 151, 0.85) 50%,
            transparent 50.15%
          ),
          linear-gradient(
            transparent 49.85%,
            rgba(43, 109, 151, 0.85) 50%,
            transparent 50.15%
          );
      }

      /* Вихідне пошкоджене зображення */
      .machine-broken {
        z-index: 1;
      }

      /* Відновлене зображення */
      .machine-restored {
        z-index: 2;

        filter:
          brightness(1.06)
          contrast(1.02)
          saturate(1.05);
      }

      /* М’яке підсвічування відновленої частини */
      .restored-glow {
        position: absolute;
        inset: 0;
        z-index: 4;
        pointer-events: none;

        background:
          radial-gradient(
            ellipse at 78% 46%,
            rgba(255, 255, 255, 0.46) 0%,
            rgba(192, 226, 255, 0.22) 25%,
            rgba(108, 183, 234, 0.10) 46%,
            transparent 68%
          ),
          linear-gradient(
            90deg,
            transparent 42%,
            rgba(184, 222, 250, 0.08) 68%,
            rgba(255, 255, 255, 0.16) 100%
          );

        mix-blend-mode: screen;
        filter: blur(9px);
      }

      /* Блок послуг */

      .services-primary-card,
      .services-secondary-card {
        box-shadow: 0 16px 42px rgba(7, 49, 78, 0.07);
      }

      /* Креслярський декор головної картки */
      .services-primary-card::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 35%;
        pointer-events: none;
        opacity: 0.12;

        background-image:
          linear-gradient(
            rgba(43, 109, 151, 0.32) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(43, 109, 151, 0.32) 1px,
            transparent 1px
          ),
          radial-gradient(
            circle at 65% 42%,
            transparent 0 62px,
            rgba(43, 109, 151, 0.55) 63px 64px,
            transparent 65px 108px,
            rgba(43, 109, 151, 0.4) 109px 110px,
            transparent 111px
          );

        background-size:
          34px 34px,
          34px 34px,
          100% 100%;

        -webkit-mask-image:
          linear-gradient(to left, #000 0%, #000 60%, transparent 100%);

        mask-image:
          linear-gradient(to left, #000 0%, #000 60%, transparent 100%);
      }

      /* Крапковий декор нижніх карток */
      .services-secondary-card::after {
        content: "";
        position: absolute;
        right: -14px;
        bottom: -14px;
        width: 240px;
        height: 240px;
        pointer-events: none;
        opacity: 0.2;

        background-image:
          radial-gradient(
            circle,
            rgba(43, 109, 151, 0.7) 1.4px,
            transparent 1.6px
          );

        background-size: 12px 12px;

        -webkit-mask-image:
          radial-gradient(circle at bottom right, #000 0%, transparent 82%);

        mask-image:
          radial-gradient(circle at bottom right, #000 0%, transparent 82%);
      }

      .service-feature-list {
        display: grid;
        gap: 0.65rem;
      }

      .service-feature-list li {
        position: relative;
        padding-left: 1.7rem;
        line-height: 1.35;
      }

      .service-feature-list li::before {
        content: "✓";
        position: absolute;
        top: 0.05rem;
        left: 0;
        display: flex;
        width: 1.1rem;
        height: 1.1rem;
        align-items: center;
        justify-content: center;
        border: 1px solid #527b8d;
        border-radius: 999px;
        color: #527b8d;
        font-size: 0.7rem;
        font-weight: 700;
      }

      @media (max-width: 767px) {
        .services-primary-card::after {
          width: 55%;
          opacity: 0.07;
        }

        .services-secondary-card::after {
          opacity: 0.12;
        }
      }

      /** Services */
      .fade-left {
        -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 28%);
        mask-image: linear-gradient(to right, transparent 0%, #000 28%);
      }

      .fade-right {
        -webkit-mask-image: linear-gradient(to left, transparent 0%, #000 28%);
        mask-image: linear-gradient(to left, transparent 0%, #000 28%);
      }

      .service-section {
        position: relative;
      }

      .service-sticky-heading {
        /* Непрозорий фон без backdrop-filter — інакше position: sticky
           не працює на мобільних/сенсорних браузерах (Chrome/Safari) */
        background: #eff6f9;
      }

      .service-number {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 9999px;
        background: #012a4a;
        color: #fff;
      }

      .service-image {
        isolation: isolate;
        background: #e5f1f7;
      }

      .service-image::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        opacity: 0.11;
        background-image:
          linear-gradient(rgba(43, 109, 151, 0.52) 1px, transparent 1px),
          linear-gradient(90deg, rgba(43, 109, 151, 0.52) 1px, transparent 1px);
        background-size: 38px 38px;
        mix-blend-mode: multiply;
      }

      .service-image:has(.fade-left)::after {
        -webkit-mask-image:
          linear-gradient(to right, transparent 0%, #000 28%);
        mask-image:
          linear-gradient(to right, transparent 0%, #000 28%);
      }

      .service-image:has(.fade-right)::after {
        -webkit-mask-image:
          linear-gradient(to left, transparent 0%, #000 28%);
        mask-image:
          linear-gradient(to left, transparent 0%, #000 28%);
      }

      .service-image img {
        z-index: 0;
      }

      .service-card {
        position: relative;
        overflow: hidden;
        border: 1px solid transparent;
        box-shadow: 0 16px 42px rgba(7, 49, 78, 0.07);
      }

      .service-card::after {
        content: "";
        position: absolute;
        right: -1rem;
        bottom: -1rem;
        width: 8rem;
        height: 8rem;
        pointer-events: none;
        opacity: 0.14;
        background-image:
          radial-gradient(circle, rgba(43, 109, 151, 0.75) 1.3px, transparent 1.5px);
        background-size: 11px 11px;
        -webkit-mask-image:
          radial-gradient(circle at bottom right, #000 0%, transparent 72%);
        mask-image:
          radial-gradient(circle at bottom right, #000 0%, transparent 72%);
      }

      .check-list {
        display: grid;
        gap: 0.55rem;
      }

      .check-list li {
        position: relative;
        padding-left: 1.1rem;
        line-height: 1.45;
      }

      .check-list li::before {
        content: "";
        position: absolute;
        top: 0.62rem;
        left: 0.15rem;
        width: 0.375rem;
        height: 0.375rem;
        border-radius: 999px;
        background: #527b8d;
      }

      @media (max-width: 767px) {
        .service-image::after {
          opacity: 0.07;
        }
      }

      /* Вступний блок сторінки послуг */

      .services-intro {
        isolation: isolate;
      }

      .services-intro::after {
        content: "";
        position: absolute;
        top: -12rem;
        right: -10rem;
        width: 34rem;
        height: 34rem;
        border: 1px solid rgba(43, 109, 151, 0.12);
        border-radius: 50%;
        pointer-events: none;
      }

      .services-intro::before {
        content: "";
        position: absolute;
        top: -5rem;
        right: -3rem;
        width: 22rem;
        height: 22rem;
        border: 1px solid rgba(43, 109, 151, 0.16);
        border-radius: 50%;
        pointer-events: none;
      }

      .services-intro-grid {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0.08;

        background-image:
          linear-gradient(
            rgba(43, 109, 151, 0.55) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(43, 109, 151, 0.55) 1px,
            transparent 1px
          );

        background-size: 42px 42px;

        -webkit-mask-image:
          linear-gradient(
            to left,
            #000 0%,
            rgba(0, 0, 0, 0.75) 40%,
            transparent 75%
          );

        mask-image:
          linear-gradient(
            to left,
            #000 0%,
            rgba(0, 0, 0, 0.75) 40%,
            transparent 75%
          );
      }

      @media (max-width: 767px) {
        .services-intro::before {
          top: -6rem;
          right: -8rem;
        }

        .services-intro::after {
          display: none;
        }

        .services-intro-grid {
          opacity: 0.055;
        }
      }

      /* Сторінка "Наші проекти" */
      #views-wrap { transition: opacity .18s ease; }
      .project-card-border {
        border: 2px solid #527b8d;
        border-radius: 1.875rem;
        clip-path: inset(0 50% 0 50% round 1.875rem);
        transition: clip-path .5s cubic-bezier(.16, 1, .3, 1);
      }
      .project-card:hover .project-card-border,
      .project-card:focus-visible .project-card-border { clip-path: inset(0 0 0 0 round 1.875rem); }
      .project-row-border {
        border: 2px solid #527b8d;
        clip-path: inset(0 50% 0 50%);
        transition: clip-path .5s cubic-bezier(.16, 1, .3, 1);
      }
      .project-row:hover .project-row-border,
      .project-row:focus-visible .project-row-border { clip-path: inset(0 0 0 0); }
      .req-clamp {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        overflow: hidden;
      }
      @property --cp-x { syntax: '<percentage>'; inherits: false; initial-value: -25%; }
      .card-photo .cp-after {
        --cp-x: -25%;
        -webkit-mask-image: linear-gradient(90deg, #000 0, #000 calc(var(--cp-x) - 2rem), rgba(0,0,0,.55) var(--cp-x), transparent calc(var(--cp-x) + 2rem), transparent 100%);
        mask-image: linear-gradient(90deg, #000 0, #000 calc(var(--cp-x) - 2rem), rgba(0,0,0,.55) var(--cp-x), transparent calc(var(--cp-x) + 2rem), transparent 100%);
        filter: brightness(1.05) saturate(1.04);
        transition: --cp-x 2s cubic-bezier(.65, 0, .35, 1);
      }
      .cp-dragging .cp-after { transition: none; }
      .card-photo .cp-beam {
        position: absolute; top: -6%; bottom: -6%; left: -25%; width: 26px;
        transform: translateX(-50%); pointer-events: none; opacity: 0; z-index: 3;
        mix-blend-mode: screen; filter: blur(.5px);
        background: linear-gradient(90deg, transparent 0%, rgba(160,215,255,.10) 28%, rgba(220,242,255,.95) 50%, rgba(160,215,255,.10) 72%, transparent 100%);
        box-shadow: 0 0 22px 7px rgba(130,200,255,.5);
        transition: left 2s cubic-bezier(.65, 0, .35, 1), opacity .35s ease;
      }
      .card-photo .cp-beam::after {
        content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px;
        transform: translateX(-50%); background: rgba(255,255,255,.9); box-shadow: 0 0 10px 2px rgba(210,240,255,.9);
      }
      .card-photo.cp-play .cp-after { --cp-x: 130%; }
      .card-photo.cp-play .cp-beam { display: block; left: 130%; opacity: 1; }
      .cp-slider { display: none; }
      .cp-track { touch-action: none; cursor: pointer; }
      .cp-handle { touch-action: none; cursor: grab; transition: left .05s linear; }
      .cp-dragging .cp-handle { cursor: grabbing; transition: none; }

      @media (hover: hover) {
        .project-card:hover .cp-after,
        .project-card:focus-visible .cp-after { --cp-x: 130%; }
        .project-card:hover .cp-beam,
        .project-card:focus-visible .cp-beam { left: 130%; opacity: 1; }
      }
      @media (hover: none) {
        .cp-slider { display: block; }
        .card-photo .cp-beam { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .card-photo .cp-after { transition: none; }
        .card-photo .cp-beam { display: none; }
        .cp-handle { transition: none; }
      }
      @media (prefers-reduced-motion: no-preference) {
        html.reveal-ready .reveal-item { opacity: 0; transform: translateY(44px) scale(.94); filter: blur(6px); }
        html.reveal-ready .reveal-item.reveal-in {
          opacity: 1; transform: none; filter: none;
          transition: opacity 1.35s var(--reveal-ease, cubic-bezier(.16, 1, .3, 1)),
                      transform 1.35s var(--reveal-ease, cubic-bezier(.16, 1, .3, 1)),
                      filter 1.35s var(--reveal-ease, cubic-bezier(.16, 1, .3, 1));
        }
      }
      [data-subtitle] { transition: opacity .22s ease, transform .22s var(--reveal-ease, cubic-bezier(.16, 1, .3, 1)); }
      .sort-menu { transform: translateY(-6px); opacity: 0; pointer-events: none; transition: opacity .2s ease, transform .2s var(--reveal-ease, ease); }
      .sort-open .sort-menu { transform: none; opacity: 1; pointer-events: auto; }
      .sort-open .sort-chevron { transform: rotate(180deg); }

      /* Сторінка окремої заявки */
      #stages-details > summary { list-style: none; cursor: pointer; }
      #stages-details > summary::-webkit-details-marker { display: none; }
      #stages-details[open] .stages-chevron { transform: rotate(180deg); }
    </style>

