<style>
    #stages-details .stages-chevron {
        transform: rotate(0deg);
    }

    #stages-details.is-expanded .stages-chevron {
        transform: rotate(180deg);
    }

    #stages-details[open] .stages-chevron {
        transform: rotate(180deg);
    }
</style>

<%
function statusSvg(completed) {
  return completed
    ? '<svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd"/></svg>'
    : '<svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 00-.986.57c-.166.115-.334.126-.45.083L6.3 5.508a1.875 1.875 0 00-2.282.819l-.922 1.597a1.875 1.875 0 00.432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 000 1.139c.015.2-.059.352-.153.43l-.841.692a1.875 1.875 0 00-.432 2.385l.922 1.597a1.875 1.875 0 002.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.35l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 002.28-.819l.923-1.597a1.875 1.875 0 00-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.614 7.614 0 000-1.139c-.016-.2.059-.352.153-.43l.84-.692a1.875 1.875 0 00.433-2.385l-.922-1.597a1.875 1.875 0 00-2.282-.818l-1.02.382c-.114.043-.282.031-.449-.082a7.49 7.49 0 00-.985-.57c-.183-.089-.277-.228-.297-.35l-.179-1.07C15.62 2.912 14.836 2.25 13.92 2.25h-1.843zM12 15.75a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z" clip-rule="evenodd"/></svg>';
}
%>

<div class="min-h-screen bg-sky font-sans text-navy antialiased">
  <main class="mx-auto max-w-shell px-6 py-10 lg:px-8 lg:py-14 xl:px-16 2xl:px-24">

    <a href="/projects<%= completed ? '?status=completed' : '' %>" class="inline-flex items-center gap-2 text-base font-display font-bold text-navy transition hover:text-steel">
      <img class="h-3 w-auto rotate-90 object-contain" src="/images/icons/icon-chevron-inactive.svg" alt="">
      Усі заявки
    </a>

    <div class="mt-5 flex items-center gap-4 text-base text-steel">
      <span class="flex items-center gap-1"><%- statusSvg(completed) %> <%= statusLabel %></span>
      <span>№<%= project.requestNumber %></span>
    </div>

    <div class="mt-6 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">

      <div>
        <h1 class="font-display text-h1 font-normal text-navy"><%= project.title %></h1>

        <h2 class="mt-7 font-display text-h3 font-normal text-navy">Обладнання:</h2>
        <p class="mt-1 text-base text-navy"><%= project.equipment %></p>

        <h2 class="mt-5 font-display text-h3 font-normal text-navy">Тип робіт:</h2>
        <p class="mt-1 text-base text-navy"><%= project.repairType %></p>

        <% if (project.description && project.description.trim()) { %>
          <div
            class="
      mt-8 text-base leading-7 text-navy

      [&_h2]:mb-3
      [&_h2]:mt-8
      [&_h2]:font-display
      [&_h2]:text-h3
      [&_h2]:font-normal
      [&_h2]:text-navy

      [&_h3]:mb-3
      [&_h3]:mt-6
      [&_h3]:font-display
      [&_h3]:text-xl
      [&_h3]:font-normal
      [&_h3]:text-navy

      [&_p]:mb-4
      [&_p]:text-justify

      [&_ul]:mb-4
      [&_ul]:list-disc
      [&_ul]:space-y-2
      [&_ul]:pl-6

      [&_ol]:mb-4
      [&_ol]:list-decimal
      [&_ol]:space-y-2
      [&_ol]:pl-6

      [&_strong]:font-bold
    "
          >
            <%- project.description %>
          </div>
        <% } %>

        <% if (completed && before.length) { %>
          <h3 class="mt-9 font-display text-h3 font-normal text-navy">До:</h3>
          <div class="mt-3 grid grid-cols-2 gap-4">
            <% before.forEach(function (ph) { %>
              <img class="aspect-[4/3] w-full rounded-card object-cover" src="<%= ph.path %>" alt="<%= ph.alt || 'Фото до ремонту' %>" loading="lazy">
            <% }); %>
          </div>
        <% } %>

        <% if (completed && after.length) { %>
          <h3 class="mt-8 font-display text-h3 font-normal text-navy">Після:</h3>
          <div class="mt-3 grid grid-cols-2 gap-4">
            <% after.forEach(function (ph) { %>
              <img class="aspect-[4/3] w-full rounded-card object-cover" src="<%= ph.path %>" alt="<%= ph.alt || 'Фото після ремонту' %>" loading="lazy">
            <% }); %>
          </div>
        <% } %>
      </div>

      <div>
        <% if (mainPhoto && completed) { %>
          <img class="aspect-[16/10] w-full rounded-card object-cover" src="<%= mainPhoto %>" alt="<%= project.title %>">
        <% } %>

        <details id="stages-details" open class="<%= (mainPhoto && completed) ? 'mt-7' : '' %> rounded-card bg-white p-6 shadow-[0_16px_42px_rgba(7,49,78,0.07)]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
            <span class="font-display text-h3 font-normal text-navy">Етапи роботи</span>
            <svg class="stages-chevron h-5 w-5 shrink-0 text-steel transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </summary>

          <div
            data-stages-content
            class="overflow-hidden"
          >
            <ol class="pt-6">
              <% timeline.forEach(function (stage) { %>
                <%
                  const isFuture = !stage.reached;

                  const isCurrentActive =
                    stage.isCurrent &&
                    !completed;

                  const isFinished =
                    stage.done;
                %>

                <li class="flex gap-4">
                  <div
                    class="flex w-5 shrink-0 flex-col items-center self-stretch"
                  >
          <span
            class="<%=
              isFinished
                ? 'bg-navy'
                : isCurrentActive
                  ? 'border-[4px] border-navy bg-white ring-4 ring-navy/10'
                  : 'bg-steel/30'
            %> mt-1 block h-4 w-4 shrink-0 rounded-full"
            aria-hidden="true"
          ></span>

                    <% if (!stage.isLast) { %>
                      <span
                        class="<%=
                          isFinished
                            ? 'bg-navy'
                            : 'bg-steel/30'
                        %> w-0.5 flex-1"
                        aria-hidden="true"
                      ></span>
                    <% } %>
                  </div>

                  <div
                    class="<%= stage.isLast ? '' : 'pb-7' %> min-w-0 <%= isFuture ? 'opacity-45' : '' %>"
                  >
                    <div class="flex flex-wrap items-center gap-2">
                      <p class="text-base font-medium text-navy">
                        <%= stage.label %>
                      </p>

                      <% if (stage.isCurrent && !completed) { %>
                        <span
                          class="rounded-full bg-sky px-2.5 py-0.5 text-xs font-bold text-navy"
                        >
                Поточний етап
              </span>
                      <% } %>

                      <% if (stage.isCurrent && completed) { %>
                        <span
                          class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-bold text-emerald-700"
                        >
                Завершено
              </span>
                      <% } %>
                    </div>

                    <% if (stage.reached && stage.note) { %>
                      <p class="mt-1.5 text-base leading-6 text-navy/70">
                        <%= stage.note %>
                      </p>
                    <% } %>

                    <% if (stage.reached && stage.date) { %>
                      <p class="mt-1.5 text-sm text-steel">
                        <%= stage.date %>
                      </p>
                    <% } %>
                  </div>
                </li>
              <% }); %>
            </ol>
          </div>
        </details>
      </div>

    </div>
  </main>
</div>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    const details =
      document.querySelector('#stages-details');

    if (!details) {
      return;
    }

    const summary =
      details.querySelector('summary');

    const content =
      details.querySelector('[data-stages-content]');

    if (!summary || !content) {
      return;
    }

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

    /*
     * Відкриття зроблено трохи довшим,
     * оскільки розгортання великого блоку
     * візуально сприймається різкіше.
     */
    const openDuration = 420;
    const closeDuration = 320;

    const easing =
      'cubic-bezier(0.22, 1, 0.36, 1)';

    let isAnimating = false;
    let detailsAnimation = null;
    let contentAnimation = null;

    details.classList.toggle(
      'is-expanded',
      details.open
    );

    summary.addEventListener('click', function (event) {
      event.preventDefault();

      if (isAnimating) {
        return;
      }

      if (reduceMotion) {
        details.open = !details.open;

        details.classList.toggle(
          'is-expanded',
          details.open
        );

        return;
      }

      if (details.open) {
        closeDetails();
      } else {
        openDetails();
      }
    });

    /**
     * Висота details у закритому стані:
     *
     * summary
     * + вертикальні padding
     * + вертикальні border.
     */
    function getCollapsedHeight() {
      const styles =
        window.getComputedStyle(details);

      const paddingTop =
        parseFloat(styles.paddingTop) || 0;

      const paddingBottom =
        parseFloat(styles.paddingBottom) || 0;

      const borderTop =
        parseFloat(styles.borderTopWidth) || 0;

      const borderBottom =
        parseFloat(styles.borderBottomWidth) || 0;

      return (
        summary.offsetHeight +
        paddingTop +
        paddingBottom +
        borderTop +
        borderBottom
      );
    }

    function cancelAnimations() {
      if (detailsAnimation) {
        detailsAnimation.cancel();
        detailsAnimation = null;
      }

      if (contentAnimation) {
        contentAnimation.cancel();
        contentAnimation = null;
      }
    }

    function openDetails() {
      isAnimating = true;
      cancelAnimations();

      const collapsedHeight =
        getCollapsedHeight();

      /*
       * Спочатку фіксуємо details у закритій висоті.
       * Тому після details.open = true контент
       * не з'явиться різко.
       */
      details.style.height =
        `${collapsedHeight}px`;

      details.style.overflow =
        'hidden';

      content.style.opacity =
        '0';

      content.style.transform =
        'translateY(-6px)';

      details.open = true;

      details.classList.add(
        'is-expanded'
      );

      /*
       * Чекаємо кадр, щоб браузер застосував
       * початкову закриту висоту.
       */
      window.requestAnimationFrame(function () {
        const expandedHeight =
          collapsedHeight +
          content.offsetHeight;

        detailsAnimation = details.animate(
          [
            {
              height: `${collapsedHeight}px`
            },
            {
              height: `${expandedHeight}px`
            }
          ],
          {
            duration: openDuration,
            easing,
            fill: 'forwards'
          }
        );

        contentAnimation = content.animate(
          [
            {
              opacity: 0,
              transform: 'translateY(-6px)'
            },
            {
              opacity: 1,
              transform: 'translateY(0)'
            }
          ],
          {
            duration: 300,
            delay: 70,
            easing,
            fill: 'forwards'
          }
        );

        detailsAnimation.onfinish = function () {
          finishAnimation(true);
        };

        detailsAnimation.oncancel = function () {
          resetStyles();
        };
      });
    }

    function closeDetails() {
      isAnimating = true;
      cancelAnimations();

      const expandedHeight =
        details.offsetHeight;

      const collapsedHeight =
        getCollapsedHeight();

      details.style.overflow =
        'hidden';

      details.classList.remove(
        'is-expanded'
      );

      detailsAnimation = details.animate(
        [
          {
            height: `${expandedHeight}px`
          },
          {
            height: `${collapsedHeight}px`
          }
        ],
        {
          duration: closeDuration,
          easing,
          fill: 'forwards'
        }
      );

      contentAnimation = content.animate(
        [
          {
            opacity: 1,
            transform: 'translateY(0)'
          },
          {
            opacity: 0,
            transform: 'translateY(-4px)'
          }
        ],
        {
          duration: 220,
          easing,
          fill: 'forwards'
        }
      );

      detailsAnimation.onfinish = function () {
        finishAnimation(false);
      };

      detailsAnimation.oncancel = function () {
        resetStyles();
      };
    }

    function finishAnimation(open) {
      details.open = open;

      detailsAnimation = null;
      contentAnimation = null;

      resetStyles();
    }

    function resetStyles() {
      details.style.height = '';
      details.style.overflow = '';

      content.style.opacity = '';
      content.style.transform = '';

      isAnimating = false;
    }
  });
</script>
