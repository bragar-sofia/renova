%>

<div class="min-h-screen bg-sky font-sans text-navy antialiased">
  <main class="mx-auto max-w-shell px-6 py-10 lg:px-8 lg:py-14 xl:px-16 2xl:px-24">

    <section>

    <a href="/projects<%= completed ? '?status=completed' : '' %>" class="inline-flex items-center gap-2 text-base font-display font-bold text-navy transition hover:text-steel">
      <img class="h-3 w-auto rotate-90 object-contain" src="/images/icons/icon-chevron-inactive.svg" alt="">
      Усі заявки
    </a>

    <div class="mt-5 flex items-center gap-4 text-base text-steel">
      <span class="flex items-center gap-1"><%- statusSvg(completed) %> <%= statusLabel %></span>
      <span>№<%= project.requestNumber %></span>
    </div>

    <div class="mt-6 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">

      <div>
        <h1 class="font-display text-h1 font-normal text-navy"><%= project.title %></h1>

        <h2 class="mt-7 font-display text-h3 font-normal text-navy">Обладнання:</h2>
        <p class="mt-1 text-base text-navy"><%= project.equipment %></p>

        <h2 class="mt-5 font-display text-h3 font-normal text-navy">Тип робіт:</h2>
        <p class="mt-1 text-base text-navy"><%= project.repairType %></p>

        <% if (project.description && project.description.trim()) { %>
          <div
            class="
      mt-8 text-base leading-7 text-navy

      [&_h2]:mb-3
      [&_h2]:mt-8
      [&_h2]:font-display
      [&_h2]:text-h3
      [&_h2]:font-normal
      [&_h2]:text-navy

      [&_h3]:mb-3
      [&_h3]:mt-6
      [&_h3]:font-display
      [&_h3]:text-xl
      [&_h3]:font-normal
      [&_h3]:text-navy

      [&_p]:mb-4
      [&_p]:text-justify

      [&_ul]:mb-4
      [&_ul]:list-disc
      [&_ul]:space-y-2
      [&_ul]:pl-6

      [&_ol]:mb-4
      [&_ol]:list-decimal
      [&_ol]:space-y-2
      [&_ol]:pl-6

      [&_strong]:font-bold
    "
          >
            <%- project.description %>
          </div>
        <% } %>

        <% if (completed && before.length) { %>
          <h3 class="mt-9 font-display text-h3 font-normal text-navy">До:</h3>
          <div class="mt-3 grid grid-cols-2 gap-4">
            <% before.forEach(function (ph, i) { %>
              <img data-zoom data-pair="<%= i %>" data-side="before" class="aspect-[4/3] w-full cursor-pointer rounded-card object-cover" src="<%= ph.path %>" alt="<%= ph.alt || 'Фото до ремонту' %>" loading="lazy">
            <% }); %>
          </div>
        <% } %>

        <% if (completed && after.length) { %>
          <h3 class="mt-8 font-display text-h3 font-normal text-navy">Після:</h3>
          <div class="mt-3 grid grid-cols-2 gap-4">
            <% after.forEach(function (ph, i) { %>
              <img data-zoom data-pair="<%= i %>" data-side="after" class="aspect-[4/3] w-full cursor-pointer rounded-card object-cover" src="<%= ph.path %>" alt="<%= ph.alt || 'Фото після ремонту' %>" loading="lazy">
            <% }); %>
          </div>
        <% } %>
      </div>

      <div>
        <%
          var afterFirst = (Array.isArray(after) && after[0] && after[0].path) ? after[0].path : null;
          var beforeFirst = (Array.isArray(before) && before[0] && before[0].path) ? before[0].path : null;
          var heroBase = beforeFirst || mainPhoto;
          var heroSwap = (afterFirst && afterFirst !== heroBase) ? afterFirst : null;
        %>
        <% if (mainPhoto && completed) { %>
          <% if (heroSwap) { %>
            <div class="card-photo relative aspect-[16/10] w-full overflow-hidden rounded-card bg-gradient-to-br from-sky to-white" data-cp-auto>
              <img class="absolute inset-0 h-full w-full object-cover" src="<%= heroBase %>" alt="<%= project.title %> — до ремонту">
              <img class="cp-after absolute inset-0 h-full w-full object-cover" src="<%= heroSwap %>" alt="<%= project.title %> — після ремонту">
              <span class="cp-beam" aria-hidden="true"></span>
            </div>
          <% } else { %>
            <img class="aspect-[16/10] w-full rounded-card object-cover" src="<%= mainPhoto %>" alt="<%= project.title %>">
          <% } %>
        <% } %>

        <details id="stages-details" open class="is-expanded <%= (mainPhoto && completed) ? 'mt-7' : '' %> rounded-card bg-white p-6 shadow-[0_16px_42px_rgba(7,49,78,0.07)]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
            <span class="font-display text-h3 font-normal text-navy">Етапи роботи</span>
            <svg class="stages-chevron h-5 w-5 shrink-0 text-steel transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </summary>

          <div data-stages-content>
            <div class="stages-inner">
            <ol class="pt-6">
              <% timeline.forEach(function (stage) { %>
                <%
                  const isFuture = !stage.reached;

                  const isCurrentActive =
                    stage.isCurrent &&
                    !completed;

                  const isFinished =
                    stage.done;
                %>

                <li class="flex gap-4">
                  <div
                    class="flex w-5 shrink-0 flex-col items-center self-stretch"
                  >
          <span
            class="<%=
              isFinished
                ? 'bg-navy'
                : isCurrentActive
                  ? 'border-[4px] border-navy bg-white ring-4 ring-navy/10'
                  : 'bg-steel/30'
            %> mt-1 block h-4 w-4 shrink-0 rounded-full"
            aria-hidden="true"
          ></span>

                    <% if (!stage.isLast) { %>
                      <span
                        class="<%=
                          isFinished
                            ? 'bg-navy'
                            : 'bg-steel/30'
                        %> w-0.5 flex-1"
                        aria-hidden="true"
                      ></span>
                    <% } %>
                  </div>

                  <div
                    class="<%= stage.isLast ? '' : 'pb-7' %> min-w-0 <%= isFuture ? 'opacity-45' : '' %>"
                  >
                    <div class="flex flex-wrap items-center gap-2">
                      <p class="text-base font-medium text-navy">
                        <%= stage.label %>
                      </p>

                      <% if (stage.isCurrent && !completed) { %>
                        <span
                          class="rounded-full bg-sky px-2.5 py-0.5 text-xs font-bold text-navy"
                        >
                Поточний етап
              </span>
                      <% } %>

                      <% if (stage.isCurrent && completed) { %>
                        <span
                          class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-bold text-emerald-700"
                        >
                Завершено
              </span>
                      <% } %>
                    </div>

                    <% if (stage.reached && stage.note) { %>
                      <p class="mt-1.5 text-base leading-6 text-navy/70">
                        <%= stage.note %>
                      </p>
                    <% } %>

                    <% if (stage.reached && stage.date) { %>
                      <p class="mt-1.5 text-sm text-steel">
                        <%= stage.date %>
                      </p>
                    <% } %>
                  </div>
                </li>
              <% }); %>
            </ol>
            </div>
          </div>
        </details>
      </div>

    </div>

    </section>
  </main>

  <% if (completed) {
    var pairCount = Math.max(before.length, after.length);
    var baPairs = [];
    for (var pi = 0; pi < pairCount; pi++) {
      baPairs.push({
        before: before[pi] ? before[pi].path : null,
        after: after[pi] ? after[pi].path : null,
        beforeAlt: before[pi] ? (before[pi].alt || 'Фото до ремонту') : '',
        afterAlt: after[pi] ? (after[pi].alt || 'Фото після ремонту') : ''
      });
    }
  %>
    <script>window.__baPairs = <%- JSON.stringify(baPairs) %>;</script>
    <div id="photo-lightbox" class="fixed inset-0 z-[100] hidden flex-col items-center justify-center gap-5 bg-black/85 p-4 opacity-0 transition-opacity duration-300" role="dialog" aria-modal="true" aria-label="Перегляд до та після">
      <button type="button" data-lightbox-close class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-navy text-white transition hover:bg-[#0b527b] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60" aria-label="Закрити">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>

      <div class="ba-stage" data-ba-stage>
        <img class="ba-after" data-ba-after src="" alt="">
        <img class="ba-before" data-ba-before src="" alt="">
        <span class="ba-tag ba-tag-before">До</span>
        <span class="ba-tag ba-tag-after">Після</span>
        <div class="ba-divider" data-ba-divider></div>
        <div class="ba-handle" data-ba-handle aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5"/></svg>
        </div>
      </div>

      <div class="flex flex-col items-center gap-4">
        <button type="button" data-ba-toggle class="inline-flex items-center gap-2 rounded-pill bg-navy px-5 py-2.5 text-sm font-display font-bold text-white transition hover:bg-[#0b527b] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18M6 8l-3 4 3 4M18 8l3 4-3 4"/></svg>
          <span data-ba-toggle-label>Порівняти До / Після</span>
        </button>

        <div class="flex items-center gap-5 text-white" data-ba-nav>
          <button type="button" data-ba-prev class="flex h-10 w-10 items-center justify-center rounded-full bg-navy transition hover:bg-[#0b527b]" aria-label="Попередня пара">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <span class="min-w-[3.5rem] text-center text-sm font-bold" data-ba-counter>1 / 1</span>
          <button type="button" data-ba-next class="flex h-10 w-10 items-center justify-center rounded-full bg-navy transition hover:bg-[#0b527b]" aria-label="Наступна пара">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var details = document.querySelector('#stages-details');
    if (!details) { return; }

    var summary = details.querySelector('summary');
    var content = details.querySelector('[data-stages-content]');
    if (!summary || !content) { return; }

    var reduceMotion = window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var animating = false;

    summary.addEventListener('click', function (event) {
      event.preventDefault();
      if (animating) { return; }

      if (reduceMotion) {
        details.open = !details.open;
        details.classList.toggle('is-expanded', details.open);
        return;
      }

      if (details.open) {
        // Закриття: анімуємо згортання, потім прибираємо open
        animating = true;
        details.classList.remove('is-expanded');

        var done = false;
        var finish = function () {
          if (done) { return; }
          done = true;
          content.removeEventListener('transitionend', onEnd);
          details.open = false;
          animating = false;
        };
        var onEnd = function (e) {
          if (e.target === content && e.propertyName === 'grid-template-rows') {
            finish();
          }
        };
        content.addEventListener('transitionend', onEnd);
        setTimeout(finish, 650);
      } else {
        // Відкриття: показуємо контент у згорнутому стані, фіксуємо його
        // синхронним reflow, потім запускаємо перехід до розгорнутого.
        details.open = true;
        void content.offsetHeight;
        details.classList.add('is-expanded');
      }
    });
  });
</script>

<script>
  (function () {
    var photo = document.querySelector('[data-cp-auto]');
    if (!photo) { return; }
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { return; }
    var on = false;
    function tick() { on = !on; photo.classList.toggle('cp-play', on); }
    setTimeout(function () { tick(); setInterval(tick, 4000); }, 3000);
  })();
</script>

<script>
  (function () {
    var lb = document.getElementById('photo-lightbox');
    if (!lb) { return; }

    var pairs = Array.isArray(window.__baPairs) ? window.__baPairs : [];
    if (!pairs.length) { return; }

    var stage = lb.querySelector('[data-ba-stage]');
    var beforeImg = lb.querySelector('[data-ba-before]');
    var afterImg = lb.querySelector('[data-ba-after]');
    var closeBtn = lb.querySelector('[data-lightbox-close]');
    var nav = lb.querySelector('[data-ba-nav]');
    var counter = lb.querySelector('[data-ba-counter]');
    var prevBtn = lb.querySelector('[data-ba-prev]');
    var nextBtn = lb.querySelector('[data-ba-next]');
    var toggleBtn = lb.querySelector('[data-ba-toggle]');
    var toggleLabel = lb.querySelector('[data-ba-toggle-label]');

    var current = 0;
    var viewSide = 'after';   // яке фото показуємо у звичайному режимі
    var compare = false;      // увімкнено режим До/Після
    var hideTimer = null;
    var dragging = false;

    function setPos(pct) {
      pct = Math.max(0, Math.min(100, pct));
      stage.style.setProperty('--ba-pos', pct + '%');
    }

    function render() {
      var p = pairs[current];
      if (!p) { return; }
      var hasBoth = !!(p.before && p.after);
      var comparing = compare && hasBoth;

      stage.classList.toggle('ba-view', !comparing);

      if (p.after) {
        afterImg.setAttribute('src', p.after);
        afterImg.setAttribute('alt', p.afterAlt || '');
      } else {
        afterImg.removeAttribute('src');
      }
      if (p.before) {
        beforeImg.setAttribute('src', p.before);
        beforeImg.setAttribute('alt', p.beforeAlt || '');
      } else {
        beforeImg.removeAttribute('src');
      }

      if (comparing) {
        // Обидва видимі, before обрізається роздільником
        afterImg.style.display = '';
        beforeImg.style.display = '';
        setPos(50);
      } else {
        // Звичайний перегляд: показуємо одне фото на всю площу
        var showBefore = (viewSide === 'before' && p.before) || !p.after;
        if (showBefore) {
          beforeImg.style.display = '';
          afterImg.style.display = p.after ? '' : 'none';
          setPos(100); // before перекриває все
        } else {
          afterImg.style.display = '';
          beforeImg.style.display = 'none';
          setPos(100);
        }
      }

      // Перемикач доступний лише коли є обидва фото
      toggleBtn.style.display = hasBoth ? '' : 'none';
      toggleLabel.textContent = comparing ? 'Звичайний перегляд' : 'Порівняти До / Після';

      counter.textContent = (current + 1) + ' / ' + pairs.length;
      nav.style.display = pairs.length > 1 ? '' : 'none';
    }

    function open(index, side) {
      current = (index >= 0 && index < pairs.length) ? index : 0;
      viewSide = (side === 'before') ? 'before' : 'after';
      compare = false;
      render();
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
      window.requestAnimationFrame(function () {
        lb.classList.remove('opacity-0');
      });
    }

    function close() {
      lb.classList.add('opacity-0');
      document.body.style.overflow = '';
      hideTimer = setTimeout(function () {
        lb.classList.add('hidden');
        lb.classList.remove('flex');
      }, 300);
    }

    function go(delta) {
      current = (current + delta + pairs.length) % pairs.length;
      render();
    }

    function moveTo(clientX) {
      var r = stage.getBoundingClientRect();
      setPos(((clientX - r.left) / r.width) * 100);
    }

    function stopDrag() {
      dragging = false;
      stage.classList.remove('ba-dragging');
    }

    stage.addEventListener('pointerdown', function (e) {
      if (stage.classList.contains('ba-view')) { return; }
      if (e.button !== 0) { return; }
      e.preventDefault();
      dragging = true;
      stage.classList.add('ba-dragging');
      try { stage.setPointerCapture(e.pointerId); } catch (err) {}
      moveTo(e.clientX);
    });
    stage.addEventListener('pointermove', function (e) {
      if (dragging) { moveTo(e.clientX); }
    });
    stage.addEventListener('pointerup', stopDrag);
    stage.addEventListener('pointercancel', stopDrag);
    stage.addEventListener('dragstart', function (e) { e.preventDefault(); });

    document.querySelectorAll('[data-zoom]').forEach(function (el) {
      el.addEventListener('click', function () {
        open(parseInt(el.getAttribute('data-pair'), 10) || 0, el.getAttribute('data-side'));
      });
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', function () { go(-1); });
    nextBtn.addEventListener('click', function () { go(1); });
    toggleBtn.addEventListener('click', function () { compare = !compare; render(); });
    lb.addEventListener('click', function (e) {
      if (e.target === lb) { close(); }
    });
    document.addEventListener('keydown', function (e) {
      if (lb.classList.contains('hidden')) { return; }
      if (e.key === 'Escape') { close(); }
      else if (e.key === 'ArrowLeft') { go(-1); }
      else if (e.key === 'ArrowRight') { go(1); }
    });
  })();
</script>
