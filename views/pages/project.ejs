<script>
  /* Вмикаємо reveal одразу, ще до першого рендеру контенту сторінки —
     інакше контент встигає промайнути видимим (поки вантажиться зовнішній
     скрипт у кінці body), а reveal здається таким, що «починається двічі». */
  document.documentElement.classList.add('reveal-ready');
</script>

<style>
    #stages-details .stages-chevron {
        transform: rotate(0deg);
    }

    #stages-details.is-expanded .stages-chevron {
        transform: rotate(180deg);
    }

    /* Плавне відкриття / закриття етапів роботи */
    #stages-details [data-stages-content] {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        transition: grid-template-rows 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 0.4s ease;
        will-change: grid-template-rows;
    }
    #stages-details.is-expanded [data-stages-content] {
        grid-template-rows: 1fr;
        opacity: 1;
    }
    #stages-details [data-stages-content] > .stages-inner {
        overflow: hidden;
        min-height: 0;
        transform: translateY(-8px);
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #stages-details.is-expanded [data-stages-content] > .stages-inner {
        transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
        #stages-details [data-stages-content],
        #stages-details [data-stages-content] > .stages-inner {
            transition: none;
        }
    }

    /* Повноекранне порівняння До / Після */
    .ba-stage {
        position: relative;
        width: min(92vw, 1100px);
        aspect-ratio: 3 / 2;
        max-height: 82vh;
        overflow: hidden;
        border-radius: 0.75rem;
        background: #0b0b0b;
        touch-action: none;
    }
    .ba-stage img {
        position: absolute;
        inset: 0;
        height: 100%;
        width: 100%;
        object-fit: cover;
        -webkit-user-drag: none;
        user-select: none;
    }
    .ba-stage .ba-before {
        clip-path: inset(0 calc(100% - var(--ba-pos, 50%)) 0 0);
    }
    .ba-divider {
        position: absolute;
        top: 0;
        bottom: 0;
        left: var(--ba-pos, 50%);
        width: 3px;
        background: #eff6f9;
        transform: translateX(-1.5px);
        pointer-events: none;
        box-shadow: 0 0 0 1px rgba(7, 49, 78, 0.18);
    }
    .ba-handle {
        position: absolute;
        top: 50%;
        left: var(--ba-pos, 50%);
        transform: translate(-50%, -50%);
        height: 44px;
        width: 44px;
        border-radius: 9999px;
        background: #012a4a;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 0 3px #eff6f9, 0 2px 10px rgba(7, 49, 78, 0.45);
        cursor: ew-resize;
    }
    .ba-stage.ba-dragging .ba-handle { cursor: grabbing; }
    .ba-tag {
        position: absolute;
        top: 14px;
        padding: 4px 12px;
        border-radius: 9999px;
        background: rgba(1, 42, 74, 0.72);
        color: #fff;
        font-size: 0.8rem;
        font-weight: 700;
        pointer-events: none;
    }
    .ba-tag-before { left: 14px; }
    .ba-tag-after { right: 14px; }
    .ba-stage.ba-view .ba-divider,
    .ba-stage.ba-view .ba-handle,
    .ba-stage.ba-view .ba-tag {
        display: none;
    }
    .ba-stage.ba-view { cursor: default; }
</style>

<%
function statusSvg(completed) {
  return completed
    ? '<svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd"/></svg>'
    : '<svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 00-.986.57c-.166.115-.334.126-.45.083L6.3 5.508a1.875 1.875 0 00-2.282.819l-.922 1.597a1.875 1.875 0 00.432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 000 1.139c.015.2-.059.352-.153.43l-.841.692a1.875 1.875 0 00-.432 2.385l.922 1.597a1.875 1.875 0 002.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.35l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 002.28-.819l.923-1.597a1.875 1.875 0 00-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.614 7.614 0 000-1.139c-.016-.2.059-.352.153-.43l.84-.692a1.875 1.875 0 00.433-2.385l-.922-1.597a1.875 1.875 0 00-2.282-.818l-1.02.382c-.114.043-.282.031-.449-.082a7.49 7.49 0 00-.985-.57c-.183-.089-.277-.228-.297-.35l-.179-1.07C15.62 2.912 14.836 2.25 13.92 2.25h-1.843zM12 15.75a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z" clip-rule="evenodd"/></svg>';
