<%
function statusSvg(completed) {
  return completed
    ? '<svg viewBox="0 0 24 24" class="project-status-icon" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd"/></svg>'
    : '<svg viewBox="0 0 24 24" class="project-status-icon" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 00-.986.57c-.166.115-.334.126-.45.083L6.3 5.508a1.875 1.875 0 00-2.282.819l-.922 1.597a1.875 1.875 0 00.432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 000 1.139c.015.2-.059.352-.153.43l-.841.692a1.875 1.875 0 00-.432 2.385l.922 1.597a1.875 1.875 0 002.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.35l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 002.28-.819l.923-1.597a1.875 1.875 0 00-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.614 7.614 0 000-1.139c-.016-.2.059-.352.153-.43l.84-.692a1.875 1.875 0 00.433-2.385l-.922-1.597a1.875 1.875 0 00-2.282-.818l-1.02.382c-.114.043-.282.031-.449-.082a7.49 7.49 0 00-.985-.57c-.183-.089-.277-.228-.297-.35l-.179-1.07C15.62 2.912 14.836 2.25 13.92 2.25h-1.843zM12 15.75a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z" clip-rule="evenodd"/></svg>';
}

var afterFirst = Array.isArray(after) && after[0] && after[0].path ? after[0].path : null;
var beforeFirst = Array.isArray(before) && before[0] && before[0].path ? before[0].path : null;
var heroBase = beforeFirst || mainPhoto;
var heroSwap = afterFirst && afterFirst !== heroBase ? afterFirst : null;
var hasHero = mainPhoto && completed;
%>

<div class="project-page" data-project-page>
  <main class="site-container section-space">
    <section>
      <% /* ======== Breadcrumb & status ========== */ %>
      <a href="/projects<%= completed ? '?status=completed' : '' %>" class="project-back-link">
        <img src="/images/icons/icon-chevron-inactive.svg" alt="">
        Усі заявки
      </a>

      <div class="project-meta">
        <span class="project-meta-status">
          <%- statusSvg(completed) %>
          <%= statusLabel %>
        </span>

        <span>
          №<%= project.requestNumber %>
        </span>
      </div>

      <% /* ===== Content grid ======= */ %>
      <div class="project-detail-grid">
        <% /* ---------- Hero ---------- */ %>
        <% if (hasHero) { %>
          <div class="project-hero">
            <% if (heroSwap) { %>
              <div class="project-hero-frame card-photo" data-cp-auto>
                <img src="<%= heroBase %>" alt="<%= project.title %> — до ремонту">
                <img class="cp-after" src="<%= heroSwap %>" alt="<%= project.title %> — після ремонту">
                <span class="cp-beam" aria-hidden="true"></span>
              </div>
            <% } else { %>
              <img class="project-hero-image" src="<%= mainPhoto %>" alt="<%= project.title %>">
            <% } %>
          </div>
        <% } %>

        <% /* ---------- Main content ---------- */ %>
        <div class="project-content<%= hasHero ? ' has-hero' : '' %>">
          <h1 class="heading-1">
            <%= project.title %>
          </h1>

          <h3 class="heading-3 project-fact-title">
            Обладнання:
          </h3>

          <p class="project-fact-value">
            <%= project.equipment %>
          </p>

          <h3 class="heading-3 project-fact-title">
            Тип робіт:
          </h3>

          <p class="project-fact-value">
            <%= project.repairType %>
          </p>

          <% if (project.description && project.description.trim()) { %>
            <div class="rich-text">
              <%- project.description %>
            </div>
          <% } %>

          <% /* ---------- Before gallery ---------- */ %>
          <% if (completed && before.length) { %>
            <h3 class="heading-3 project-gallery-title">
              До:
            </h3>

            <div class="project-gallery">
              <% before.forEach(function (photo, index) { %>
                <img class="project-gallery-image" src="<%= photo.path %>" alt="<%= photo.alt || 'Фото до ремонту' %>" loading="lazy"
                  data-zoom
                  data-pair="<%= index %>"
                  data-side="before"
                  role="button"
                  tabindex="0"
                  aria-label="Відкрити: <%= photo.alt || 'Фото до ремонту' %>"
                >
              <% }); %>
            </div>
          <% } %>

          <% /* ---------- After gallery ---------- */ %>
          <% if (completed && after.length) { %>
            <h3 class="heading-3 project-gallery-title">
              Після:
            </h3>

            <div class="project-gallery">
              <% after.forEach(function (photo, index) { %>
                <img class="project-gallery-image" src="<%= photo.path %>" alt="<%= photo.alt || 'Фото після ремонту' %>" loading="lazy"
                  data-zoom
                  data-pair="<%= index %>"
                  data-side="after"
                  role="button"
                  tabindex="0"
                  aria-label="Відкрити: <%= photo.alt || 'Фото після ремонту' %>"
                >
              <% }); %>
            </div>
          <% } %>
        </div>

        <% /* ===== Stages ===== */ %>
        <details id="stages-details" class="project-stages card card-elevated is-expanded<%= hasHero ? ' has-hero' : '' %>" data-project-stages open>
          <summary class="project-stages-summary">
            <span class="heading-3">
              Етапи роботи
            </span>

            <svg class="stages-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </summary>

          <div data-stages-content>
            <div class="stages-inner">
              <ol class="project-timeline">
                <% timeline.forEach(function (stage) { %>
                  <%
                    var isFuture = !stage.reached;
                    var isCurrentActive = stage.isCurrent && !completed;
                    var isFinished = stage.done;
                  %>

                  <li class="project-stage">
                    <div class="project-stage-track">
                      <span class="project-stage-marker<%= isFinished ? ' is-finished' : (isCurrentActive ? ' is-current' : '') %>" aria-hidden="true"></span>

                      <% if (!stage.isLast) { %>
                        <span class="project-stage-line<%= isFinished ? ' is-finished' : '' %>" aria-hidden="true"></span>
                      <% } %>
                    </div>

                    <div class="project-stage-content<%= stage.isLast ? ' is-last' : '' %><%= isFuture ? ' is-future' : '' %>">
                      <div class="project-stage-heading">
                        <p class="project-stage-label">
                          <%= stage.label %>
                        </p>

                        <% if (stage.isCurrent && !completed) { %>
                          <span class="status-badge status-badge-current">
                            Поточний етап
                          </span>
                        <% } %>

                        <% if (stage.isCurrent && completed) { %>
                          <span class="status-badge status-badge-completed">
                            Завершено
                          </span>
                        <% } %>
                      </div>

                      <% if (stage.reached && stage.note) { %>
                        <p class="project-stage-note">
                          <%= stage.note %>
                        </p>
                      <% } %>

                      <% if (stage.reached && stage.date) { %>
                        <p class="project-stage-date">
                          <%= stage.date %>
                        </p>
                      <% } %>
                    </div>
                  </li>
                <% }); %>
              </ol>
            </div>
          </div>
        </details>
      </div>
    </section>
  </main>

  <% /* ===== Before / after lightbox ======== */ %>
  <% if (completed && (before.length || after.length)) { %>
    <div id="photo-lightbox" class="project-lightbox" data-project-lightbox role="dialog" aria-modal="true" aria-label="Перегляд до та після" aria-hidden="true">
      <button type="button" class="lightbox-close" data-lightbox-close aria-label="Закрити">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>

      <div class="ba-stage" data-ba-stage>
        <img class="ba-after" data-ba-after alt="" draggable="false">
        <img class="ba-before" data-ba-before alt="" draggable="false">

        <span class="ba-tag ba-tag-before">До</span>
        <span class="ba-tag ba-tag-after">Після</span>

        <div class="ba-divider" data-ba-divider></div>
        <div class="ba-handle" data-ba-handle aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 7l-5 5 5 5M15 7l5 5-5 5"></path>
          </svg>
        </div>
      </div>

      <div class="lightbox-controls">
        <button type="button" class="btn btn-primary btn-sm lightbox-toggle" data-ba-toggle>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v18M6 8l-3 4 3 4M18 8l3 4-3 4"></path>
          </svg>

          <span data-ba-toggle-label>
            Порівняти До / Після
          </span>
        </button>

        <div class="lightbox-nav" data-ba-nav>
          <button type="button" class="lightbox-nav-button" data-ba-prev aria-label="Попередня пара">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 6l-6 6 6 6"></path>
            </svg>
          </button>

          <span class="lightbox-counter" data-ba-counter>
            1 / 1
          </span>

          <button type="button" class="lightbox-nav-button" data-ba-next aria-label="Наступна пара">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 6l6 6-6 6"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  <% } %>
</div>


<script src="/js/components/before-after.js" defer></script>
<script src="/js/pages/project.js" defer></script>
