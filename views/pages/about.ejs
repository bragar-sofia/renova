<%
var aboutIntro = [
  [
    'Основний напрямок діяльності компанії RENOVA — надання якісних і максимально оперативних послуг з діагностики стану, технічного обслуговування й відновлення металообробного та ковальсько-пресового обладнання. Роботи здійснюємо як на об\'єкті замовника, так і на власному сервісному майданчику.',
    'Наші виробничі потужності дають змогу виконувати повний цикл робіт: від усунення локальних несправностей і відновлення окремих вузлів до капітального ремонту, комплексної модернізації та реінжинірингу верстатних систем. Працюємо з обладнанням усіх типів, модифікацій і років випуску.'
  ],
  [
    'Кожен проєкт починається з технічного аудиту та дефектації — за їх результатами складається дефектний акт і формується техніко-економічне обґрунтування з оптимальним алгоритмом робіт відповідно до технічного завдання Замовника. Замовник бачить обсяг, вартість і терміни ще до початку робіт.',
    'Ми забезпечуємо як комплексний технічний супровід верстатного парку, так і виконання окремих завдань для підсилення власної ремонтної служби підприємства.',
    'Наша мета — забезпечити технологічну точність і стабільну працездатність вашого виробничого парку, мінімізувати експлуатаційні витрати та запобігти збитковим простоям виробництва.'
  ]
];

var aboutValues = [
  {
    title: 'Мінімізація збиткових простоїв',
    text: 'Оперативно реагуємо на аварійні виклики та впроваджуємо графіки планово-попереджувальних ремонтів для захисту від незапланованих зупинок обладнання.'
  },
  {
    title: 'Відновлення паспортних характеристик',
    text: 'Повертаємо геометрію, точність і функціонал обладнання до технологічних норм, запобігаючи виходу бракованої продукції.'
  },
  {
    title: 'Оптимізація витрат на сервіс',
    text: 'Допомагаємо прозоро планувати бюджет на утримання обладнання та знижуємо загальні витрати на його експлуатацію.'
  }
];

var aboutMission = [
  [
    'Ми беремо на себе повну відповідальність за технічну справність, точність та безперебійну роботу вашого виробничого парку, звільняючи ваш час, капітал і командний ресурс для масштабування бізнесу, виконання ключових замовлень та розвитку власного виробництва.',
    'Ми переконані, що обладнання не повинно бути джерелом ризику для виробництва. Кожен верстат має працювати в межах паспортних характеристик, кожна зупинка має бути запланованою, а кожна гривня, вкладена в утримання парку, — обґрунтованою.'
  ],
  [
    'Тому ми не обмежуємося усуненням наслідків поломок. Ми діагностуємо причини, відновлюємо технологічну точність, впроваджуємо графіки планово-попереджувальних робіт і допомагаємо Замовнику прозоро планувати бюджет на утримання обладнання. Наш результат — не факт виконаного ремонту, а стабільно працездатне виробництво.'
  ]
];
%>

<div class="about-page">
  <main id="about">
    <section class="site-container section-space about-sections">
      <div class="about-intro">
        <div class="about-block">
          <h1 class="heading-1">Про нас</h1>

          <div class="about-text">
            <% aboutIntro.forEach(function (group) { %>
              <div class="about-text-group">
                <% group.forEach(function (paragraph) { %>
                  <p class="body-copy"><%= paragraph %></p>
                <% }); %>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="about-photo">
          <img src="/images/machining-center.png" alt="Оброблювальний центр з ЧПК" loading="lazy" decoding="async">
        </div>
      </div>

      <div class="about-block">
        <h2 class="heading-2">Цінності для вашого бізнесу</h2>

        <div data-stagger class="about-values">
          <% aboutValues.forEach(function (value) { %>
            <article class="card about-value">
              <h3 class="heading-3"><%= value.title %></h3>
              <p class="body-copy"><%= value.text %></p>
            </article>
          <% }); %>
        </div>
      </div>

      <div class="about-block">
        <h2 class="heading-2">Наша місія</h2>

        <div class="about-text">
          <% aboutMission.forEach(function (group) { %>
            <div class="about-text-group">
              <% group.forEach(function (paragraph) { %>
                <p class="body-copy"><%= paragraph %></p>
              <% }); %>
            </div>
          <% }); %>
        </div>
      </div>
    </section>
  </main>
</div>
