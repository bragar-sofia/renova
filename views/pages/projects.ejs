<%
var SUB_ACTIVE =
  'Тут ви можете відстежувати статуси заявок, з якими ми працюємо';

var SUB_COMPLETED =
  'Тут ви можете переглянути наше портфоліо із завершених проєктів';

var normalizedQ = String(q || '')
  .trim()
  .toLocaleLowerCase('uk-UA');

function cardStatus(project) {
  return project.completed
    ? 'completed'
    : 'active';
}

function matchInit(project) {
  var searchText = String(
    project.searchText || ''
  );

  return (
    cardStatus(project) === status &&
    (
      !normalizedQ ||
      searchText.indexOf(normalizedQ) !== -1
    )
  );
}

var matchTotal =
  projects.filter(matchInit).length;

var shownInit = 0;

function visInit(project) {
  var matched = matchInit(project);

  var visible =
    matched &&
    shownInit < 6;

  if (matched) {
    shownInit += 1;
  }

  return visible;
}
%>
<script>document.documentElement.classList.add('reveal-ready');</script>

<div class="min-h-screen bg-sky font-sans text-navy antialiased">
  <main class="mx-auto max-w-shell px-6 py-10 lg:px-8 lg:py-14 xl:px-16 2xl:px-24">

    <% /* Header & filters */ %>
    <section>
      <h1 class="font-display text-h1 font-normal text-navy">Заявки</h1>
      <p data-subtitle class="mt-3 max-w-2xl text-base text-navy/70"><%= status === 'completed' ? SUB_COMPLETED : SUB_ACTIVE %></p>

      <div class="mt-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div data-toggle class="relative inline-grid shrink-0 grid-cols-2 overflow-hidden rounded-pill border-2 border-steel/40 bg-white font-display text-base font-bold">
          <span data-toggle-thumb class="pointer-events-none absolute inset-y-0 left-0 w-1/2 rounded-pill bg-navy transition-transform duration-300" style="transition-timing-function: cubic-bezier(.16,1,.3,1); transform: translateX(<%= status === 'completed' ? '100%' : '0%' %>);"></span>
          <button type="button" data-status-tab="active" class="relative z-10 rounded-pill px-5 py-2.5 text-center transition-colors duration-300 <%= status === 'active' ? 'text-white' : 'text-navy' %>">Активні</button>
          <button type="button" data-status-tab="completed" class="relative z-10 rounded-pill px-5 py-2.5 text-center transition-colors duration-300 <%= status === 'completed' ? 'text-white' : 'text-navy' %>">Завершені</button>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
          <div class="group relative">
            <input type="text" data-search-input value="<%= q %>" placeholder="Пошук за номером, назвою або обладнанням" class="h-12 w-full rounded-pill border-2 border-steel bg-white pl-4 pr-11 text-base text-steel placeholder:text-steel/70 outline-none transition focus:border-navy sm:w-72">
            <span class="pointer-events-none absolute right-4 top-1/2 flex -translate-y-1/2 items-center text-steel transition group-hover:text-navy group-focus-within:text-navy">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            </span>
          </div>

          <div class="relative" data-sort>
            <button type="button" data-sort-toggle class="flex h-12 w-full items-center justify-between gap-6 rounded-pill border-2 border-steel bg-white pl-5 pr-5 text-base text-navy outline-none transition hover:border-navy sm:w-auto">
              <span data-sort-label>Сортувати за</span>
              <svg class="sort-chevron h-4 w-4 shrink-0 text-steel transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="sort-menu absolute left-0 z-20 mt-2 w-full overflow-hidden rounded-pill border-2 border-navy/30 bg-white p-1 shadow-[0_16px_42px_rgba(7,49,78,0.12)] sm:left-auto sm:right-0 sm:w-56">
              <button type="button" data-sort-opt="new" class="block w-full rounded-pill px-4 py-2.5 text-left text-base text-navy transition hover:bg-sky">Спочатку новіші</button>
              <button type="button" data-sort-opt="old" class="block w-full rounded-pill px-4 py-2.5 text-left text-base text-navy transition hover:bg-sky">Спочатку старіші</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div id="views-wrap" class="mt-8">

      <section data-empty class="rounded-card bg-white px-6 py-20 text-center <%= matchTotal > 0 ? 'hidden' : '' %>">
        <p class="font-display text-h3 font-normal text-navy/70" data-empty-text>
          <%= q ? 'За вашим запитом заявок не знайдено.' : (status === 'completed' ? 'Поки що немає завершених проєктів.' : 'Наразі немає активних заявок.') %>
        </p>
      </section>

      <% /* Active table */ %>
      <div data-view="active" class="<%= (status === 'active' && matchTotal > 0) ? '' : 'hidden' %>">
        <div class="reveal-item">
        <div class="hidden pb-4 font-display text-h2 font-normal text-navy lg:grid lg:grid-cols-[170px_1fr_230px_210px]">
          <div class="text-center">Номер</div>
          <div class="text-center">Проєкт</div>
          <div class="text-center">Стан</div>
          <div class="whitespace-nowrap text-center">Оновлено</div>
        </div>
        <% var activeRows = projects.filter(function (p) { return !p.completed; }); %>
        <div class="space-y-4">
          <% activeRows.forEach(function (p) { %>
            <a href="/projects/<%= p.requestNumber %>" data-project-item data-status="active" data-number="<%= p.requestNumber %>" data-search="<%= p.searchText %>" data-sort-value="<%= p.sortTimestamp %>"
                class="project-card group relative grid grid-cols-1 gap-3 overflow-hidden rounded-card bg-white px-6 py-5 text-base shadow-[0_16px_42px_rgba(7,49,78,0.07)] transition lg:grid-cols-[170px_1fr_230px_210px] lg:items-stretch lg:gap-0 lg:px-0 lg:py-0 <%= visInit(p) ? '' : 'hidden' %>">
              <div class="text-navy lg:flex lg:items-center lg:justify-center lg:px-6 lg:py-6">№<%= p.requestNumber %></div>
              <div class="text-navy lg:flex lg:flex-col lg:justify-center lg:border-l-2 lg:border-[#527B8D] lg:px-6 lg:py-6">
                <p class="font-display text-h3 font-normal text-navy"><%= p.title %></p>
                <p class="mt-2 text-base text-navy"><span class="font-display font-normal">Обладнання:</span> <%= p.equipment %></p>
                <p class="mt-1 text-base text-navy"><span class="font-display font-normal">Вид ремонту:</span> <%= p.repairType %></p>
              </div>
              <div class="text-navy lg:flex lg:flex-col lg:items-center lg:justify-center lg:border-l-2 lg:border-[#527B8D] lg:px-6 lg:py-6">
                <span class="font-bold lg:hidden">Стан: </span>
                <div class="mt-2 w-full max-w-[180px] lg:mt-0">
                  <div class="flex items-end justify-between gap-2">
                    <p class="text-base text-navy"><%= p.statusText %></p>
                    <p class="text-base text-navy"><%= p.progress %>%</p>
                  </div>
                  <div class="mt-1 h-2.5 w-full overflow-hidden rounded-full bg-steel/20">
                    <div class="h-full rounded-full bg-navy" style="width: <%= p.progress %>%"></div>
                  </div>
                </div>
              </div>
              <div class="text-navy lg:flex lg:flex-col lg:items-center lg:justify-center lg:border-l-2 lg:border-[#527B8D] lg:px-6 lg:py-6">
                <span class="font-bold lg:hidden">Оновлено: </span>
                <p class="whitespace-nowrap text-base text-navy"><%= p.updatedDate %></p>
                <p class="mt-1 whitespace-nowrap text-base text-steel">Створено: <%= p.createdDate %></p>
              </div>
              <span class="project-card-border pointer-events-none absolute inset-0" aria-hidden="true"></span>
            </a>
          <% }); %>
        </div>
        </div>
      </div>

      <% /* Completed cards */ %>
      <div data-view="completed" class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3 <%= (status === 'completed' && matchTotal > 0) ? '' : 'hidden' %>">
        <% projects.forEach(function (p) { if (!p.completed) { return; } %>

        <article
          data-project-item
          data-project-card
          data-status="completed"
          data-number="<%= p.requestNumber %>"
          data-search="<%= p.searchText %>"
          data-sort-value="<%= p.sortTimestamp %>"
          class="reveal-item project-card group relative flex flex-col overflow-hidden rounded-card bg-white shadow-[0_16px_42px_rgba(7,49,78,0.07)] <%= visInit(p) ? '' : 'hidden' %>"
        >

          <!-- Photo -->
          <div class="card-photo relative aspect-[16/10] overflow-hidden bg-gradient-to-br from-sky to-white">
            <% if (p.imageMain) { %>
              <img class="absolute inset-0 h-full w-full object-cover" src="<%= p.imageMain %>" alt="<%= p.title %>" loading="lazy">
              <% if (p.imageHover) { %>
                <img class="cp-after absolute inset-0 h-full w-full object-cover" src="<%= p.imageHover %>" alt="<%= p.title %> — після ремонту" loading="lazy">
                <span class="cp-beam" aria-hidden="true"></span>
              <% } %>
            <% } else { %>
              <div class="flex h-full items-center justify-center text-steel/40">
                <svg viewBox="0 0 24 24" class="h-12 w-12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25z"/>
                </svg>
              </div>
            <% } %>
          </div>

          <!-- Content -->
          <div class="pointer-events-none relative z-20 flex flex-1 flex-col p-5">
            <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-3">
              <% if (p.imageMain && p.imageHover) { %>
                <button type="button" class="cp-toggle pointer-events-auto col-start-2 row-start-1 mb-2 shrink-0 justify-self-end md:mb-0" data-cp-toggle aria-pressed="false" aria-label="Показати фото після ремонту">
                  <span class="cp-toggle-thumb">
                    <span data-cp-toggle-label>До</span>
                  </span>
                </button>
              <% } %>

              <h3 class="project-title-clamp col-span-2 row-start-2 font-display text-h3 font-normal text-navy md:col-span-1 md:col-start-1 md:row-start-1">
                <%= p.title %>
              </h3>

              <p class="col-span-2 row-start-3 mt-1 truncate text-base text-steel md:row-start-2">
                №<%= p.requestNumber %> · <%= p.equipment %>
              </p>
            </div>

            <p class="mt-3 flex-1 text-base text-navy/70">
              <%= p.excerpt %>
            </p>

            <div class="mt-4 flex items-center justify-between">
              <span class="flex items-center gap-1 text-base text-steel">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd"/>
                </svg>
                Завершено
              </span>

              <span class="flex items-center gap-1 font-display text-base font-bold text-navy transition group-hover:text-steel">
                Детальніше
                <img class="h-3 w-auto -rotate-90 object-contain" src="/images/icons/icon-chevron-inactive.svg" alt="">
              </span>
            </div>
          </div>

          <!-- Whole-card link -->
          <a class="absolute inset-0 z-10" href="/projects/<%= p.requestNumber %>" aria-label="Відкрити проєкт: <%= p.title %>"></a>

          <span class="project-card-border pointer-events-none absolute inset-0" aria-hidden="true"></span>
        </article>
        <% }); %>
      </div>
    </div>

    <div data-load-more-wrap class="mt-10 flex justify-center <%= matchTotal > 6 ? '' : 'hidden' %>">
      <button type="button" data-load-more class="rounded-pill bg-navy px-8 py-3 font-display text-base font-bold text-white transition hover:bg-[#0b527b]">Завантажити ще</button>
    </div>

  </main>
</div>

<script>
  (function () {
    var wrap = document.getElementById('views-wrap');
    if (!wrap) { return; }
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var revealed = false;
    var items = Array.prototype.slice.call(document.querySelectorAll('[data-project-item]'));
    var viewActive = document.querySelector('[data-view="active"]');
    var viewCompleted = document.querySelector('[data-view="completed"]');
    var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-status-tab]'));
    var thumb = document.querySelector('[data-toggle-thumb]');
    var searchInput = document.querySelector('[data-search-input]');
    var sortWrap = document.querySelector('[data-sort]');
    var sortLabel = document.querySelector('[data-sort-label]');
    var loadWrap = document.querySelector('[data-load-more-wrap]');
    var loadBtn = document.querySelector('[data-load-more]');
    var emptyEl = document.querySelector('[data-empty]');
    var emptyText = document.querySelector('[data-empty-text]');
    var subtitle = document.querySelector('[data-subtitle]');
    var SUB = { active: 'Тут ви можете відстежувати статуси заявок, з якими ми працюємо', completed: 'Тут ви можете переглянути наше портфоліо із завершених проектів' };
    var SORT_LABELS = { new: 'Спочатку новіші', old: 'Спочатку старіші' };
    var PER = 6;

    var params = new URLSearchParams(location.search);
    var state = {
      status: params.get('status') === 'completed' ? 'completed' : 'active',
      q: (params.get('q') || '').trim(),
      sort: params.get('sort') === 'old' ? 'old' : 'new',
      shown: PER
    };

    function num(el, key) { return parseInt(el.getAttribute('data-' + key), 10) || 0; }
    function moveThumb() { if (thumb) { thumb.style.transform = state.status === 'completed' ? 'translateX(100%)' : 'translateX(0%)'; } }

    function visibleItems() {
      var c = state.status === 'active' ? viewActive : viewCompleted;
      if (!c) { return []; }
      return Array.prototype.filter.call(c.querySelectorAll('.reveal-item'), function (el) { return !el.classList.contains('hidden'); });
    }
    function ensureRevealed() { visibleItems().forEach(function (el) { el.classList.add('reveal-in'); }); }
    function staggerReveal() {
      var vis = visibleItems();
      if (reduceMotion) { vis.forEach(function (el) { el.classList.add('reveal-in'); }); return; }
      vis.forEach(function (el) { el.classList.remove('reveal-in'); });
      void wrap.offsetWidth;
      vis.forEach(function (el, i) {
        el.style.transitionDelay = (Math.min(i, 8) * 0.06) + 's';
        el.classList.add('reveal-in');
      });
    }

    function apply() {
      var isActive = state.status === 'active';
      var current = items.filter(function (c) { return c.getAttribute('data-status') === state.status; });
      current.sort(function (a, b) {
        var firstTimestamp =
          num(a, 'sort-value');

        var secondTimestamp =
          num(b, 'sort-value');

        return state.sort === 'old'
          ? firstTimestamp - secondTimestamp
          : secondTimestamp - firstTimestamp;
      });
      current.forEach(function (c) { c.parentNode.appendChild(c); });

      var normalizedQuery =
        state.q.toLocaleLowerCase('uk-UA');

      var matched = 0;

      current.forEach(function (item) {
        var searchText =
          item.getAttribute('data-search') || '';

        var matchedQuery =
          !normalizedQuery ||
          searchText.indexOf(normalizedQuery) !== -1;

        if (matchedQuery) {
          item.classList.toggle(
            'hidden',
            matched >= state.shown
          );

          matched += 1;
        } else {
          item.classList.add('hidden');
        }
      });

      if (viewActive) { viewActive.classList.toggle('hidden', !(isActive && matched > 0)); }
      if (viewCompleted) { viewCompleted.classList.toggle('hidden', !(!isActive && matched > 0)); }
      if (emptyText) { emptyText.textContent = state.q ? 'За вашим запитом заявок не знайдено.' : (isActive ? 'Наразі немає активних заявок.' : 'Поки що немає завершених проєктів.'); }
      if (emptyEl) { emptyEl.classList.toggle('hidden', matched > 0); }
      if (loadWrap) { loadWrap.classList.toggle('hidden', matched <= state.shown); }
      if (subtitle) { subtitle.textContent = SUB[state.status]; }

      tabs.forEach(function (t) {
        var on = t.getAttribute('data-status-tab') === state.status;
        t.classList.toggle('text-white', on);
        t.classList.toggle('text-navy', !on);
      });
      moveThumb();
      if (sortLabel) { sortLabel.textContent = SORT_LABELS[state.sort]; }

      var p = new URLSearchParams();
      if (state.status === 'completed') { p.set('status', 'completed'); }
      if (state.q) { p.set('q', state.q); }
      if (state.sort === 'old') { p.set('sort', 'old'); }
      var qs = p.toString();
      history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));

      if (revealed) { ensureRevealed(); }
    }

    function fadeApply() {
      wrap.style.opacity = '0';
      if (subtitle) { subtitle.style.opacity = '0'; subtitle.style.transform = 'translateY(6px)'; }
      setTimeout(function () {
        apply(); staggerReveal();
        wrap.style.opacity = '1';
        if (subtitle) { subtitle.style.opacity = '1'; subtitle.style.transform = 'none'; }
      }, 170);
    }

    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        var s = t.getAttribute('data-status-tab');
        if (state.status === s) { return; }
        state.status = s; state.shown = PER; fadeApply();
      });
    });

    if (searchInput) {
      searchInput.value = state.q;
      searchInput.addEventListener('input', function () { state.q = searchInput.value.trim(); state.shown = PER; apply(); });
    }

    if (sortWrap) {
      sortWrap.querySelector('[data-sort-toggle]').addEventListener('click', function (e) {
        e.stopPropagation();
        sortWrap.classList.toggle('sort-open');
      });
      Array.prototype.forEach.call(sortWrap.querySelectorAll('[data-sort-opt]'), function (o) {
        o.addEventListener('click', function () { state.sort = o.getAttribute('data-sort-opt'); sortWrap.classList.remove('sort-open'); apply(); });
      });
      document.addEventListener('click', function (e) { if (!sortWrap.contains(e.target)) { sortWrap.classList.remove('sort-open'); } });
    }

    if (loadBtn) { loadBtn.addEventListener('click', function () { state.shown += PER; apply(); }); }

    /* ===== Before / after toggle ===== */
    var toggles = document.querySelectorAll('[data-view="completed"] [data-cp-toggle]');
    toggles.forEach(function (toggle) {
      toggle.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        var card = toggle.closest('[data-project-card]');
        if (!card) {
          return;
        }

        var showAfter = !card.classList.contains('is-after');
        card.classList.add('is-switching');
        card.classList.toggle('is-after', showAfter);
        clearTimeout(card._cpTimer);
        card._cpTimer = setTimeout(function () {
          card.classList.remove('is-switching');
        }, 2050);

        toggle.setAttribute('aria-pressed', showAfter ? 'true' : 'false');
        toggle.setAttribute('aria-label', showAfter ? 'Показати фото до ремонту' : 'Показати фото після ремонту');

        var label = toggle.querySelector('[data-cp-toggle-label]');
        if (label) {
          label.textContent = showAfter ? 'Після' : 'До';
        }
      });
    });

    apply();

    function initialReveal() { revealed = true; staggerReveal(); }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialReveal);
    } else {
      initialReveal();
    }
    window.addEventListener('load', function () { revealed = true; ensureRevealed(); });
  })();
</script>
