<style>
  /* =========================================================
     PROJECTS UI FOUNDATION
     Temporary local component layer.
     Shared primitives intentionally match Home / Services 1:1.
     ========================================================= */

  .projects-page {
    --ui-navy: #012a4a;
    --ui-navy-hover: #0b527b;
    --ui-sky: #eff6f9;
    --ui-steel: #527b8d;
    --ui-card-radius: 1.875rem;
    --ui-pill-radius: 0.5rem;
    --ui-card-shadow: 0 16px 42px rgba(7, 49, 78, 0.07);
    --ui-menu-shadow: 0 16px 42px rgba(7, 49, 78, 0.12);

    min-height: 100vh;
    background: var(--ui-sky);
    color: var(--ui-navy);
    font-family: 'Open Sans', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ===== Shared: layout ===== */
  .site-container {
    width: 100%;
    max-width: 122rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .section-space {
    padding-block: 2.5rem;
  }

  @media (min-width: 1024px) {
    .site-container {
      padding-inline: 2rem;
    }

    .section-space {
      padding-block: 3.5rem;
    }
  }

  @media (min-width: 1280px) {
    .site-container {
      padding-inline: 4rem;
    }
  }

  @media (min-width: 1536px) {
    .site-container {
      padding-inline: 6rem;
    }
  }

  /* ===== Shared: typography ===== */
  .heading-1,
  .heading-2,
  .heading-3,
  .heading-4 {
    margin: 0;
    color: var(--ui-navy);
    font-family: 'Geologica', Arial, sans-serif;
    font-weight: 400;
  }

  .heading-1 {
    font-size: clamp(2rem, 0.5rem + 3.125vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .heading-2 {
    font-size: clamp(1.25rem, 0.3125rem + 1.953125vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .heading-3 {
    font-size: clamp(1.125rem, 0.1875rem + 1.171875vw, 1.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .heading-4 {
    font-size: 1rem;
    line-height: 1.35;
  }

  .body-copy {
    color: var(--ui-navy);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .text-muted {
    color: var(--ui-steel);
  }

  /* ===== Shared: buttons ===== */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--ui-pill-radius);
    padding: 0.75rem 1.5rem;
    font-family: 'Geologica', Arial, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5rem;
    text-align: center;
    transition: background-color .2s ease, color .2s ease, border-color .2s ease, opacity .2s ease;
  }

  .btn:focus-visible {
    outline: 2px solid var(--ui-steel);
    outline-offset: 2px;
  }

  .btn-primary {
    border: 0;
    background: var(--ui-navy);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--ui-navy-hover);
  }

  .btn-wide {
    padding-inline: 2rem;
  }

  /* ===== Shared: cards / surfaces ===== */
  .card {
    border-radius: var(--ui-card-radius);
    background: #fff;
  }

  .card-elevated {
    box-shadow: var(--ui-card-shadow);
  }

  .interactive-card {
    position: relative;
  }

  .interactive-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 30;
    border: 2px solid var(--ui-steel);
    border-radius: inherit;
    clip-path: inset(0 50% 0 50% round var(--ui-card-radius));
    pointer-events: none;
    transition: clip-path .5s cubic-bezier(.16, 1, .3, 1);
  }

  .interactive-card:hover::before,
  .interactive-card:focus-visible::before,
  .interactive-card:focus-within::before {
    clip-path: inset(0 0 0 0 round var(--ui-card-radius));
  }

  /* Shared before / after state after project-card -> interactive-card migration. */
  .interactive-card.is-after .cp-after {
    --cp-x: 130%;
  }

  .interactive-card.is-after .cp-beam {
    left: 130%;
  }

  .interactive-card.is-switching .cp-beam {
    opacity: 1;
  }

  .interactive-card.is-after .cp-toggle-thumb {
    transform: translateX(calc(100% + 3px));
    background: var(--ui-steel);
  }

  @media (hover: hover) {
    .interactive-card:hover .cp-after,
    .interactive-card:focus-within .cp-after {
      --cp-x: 130%;
    }

    .interactive-card:hover .cp-beam,
    .interactive-card:focus-within .cp-beam {
      left: 130%;
      opacity: 1;
    }
  }

  .line-clamp-2 {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .action-link {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: .5rem;
    color: var(--ui-navy);
    font-family: 'Geologica', Arial, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    transition: color .2s ease;
  }

  .action-link:hover {
    color: var(--ui-steel);
  }

  .action-link img {
    width: auto;
    height: .75rem;
    transform: rotate(-90deg);
    object-fit: contain;
    transition: transform .2s ease;
  }

  .group:hover .action-link img {
    transform: translateX(4px) rotate(-90deg);
  }

  /* ===== Shared: form controls ===== */
  .form-control {
    display: block;
    width: 100%;
    border: 0;
    border-radius: var(--ui-pill-radius);
    background: #fff;
    color: var(--ui-navy);
    font-size: 1rem;
    outline: none;
    transition: border-color .2s ease, box-shadow .2s ease, color .2s ease;
  }

  input.form-control {
    height: 3rem;
    padding-inline: 1rem;
  }

  .form-control::placeholder {
    color: rgba(82, 123, 141, .7);
  }

  .form-control:focus {
    box-shadow: 0 0 0 2px rgba(1, 42, 74, .4);
  }

  .form-control-outline {
    border: 2px solid var(--ui-steel);
    color: var(--ui-steel);
  }

  .form-control-outline:focus {
    border-color: var(--ui-navy);
    box-shadow: none;
  }

  /* ===== Projects: page header ===== */
  .project-subtitle {
    max-width: 42rem;
    margin-top: .75rem;
    color: rgba(1, 42, 74, .7);
    font-size: 1rem;
  }

  /* ===== Projects: status switch ===== */
  .project-tabs {
    position: relative;
    display: inline-grid;
    flex-shrink: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border: 2px solid rgba(82, 123, 141, .4);
    border-radius: var(--ui-pill-radius);
    background: #fff;
    font-family: 'Geologica', Arial, sans-serif;
    font-size: 1rem;
    font-weight: 700;
  }

  .project-tab-thumb {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 50%;
    border-radius: var(--ui-pill-radius);
    background: var(--ui-navy);
    pointer-events: none;
    transition: transform .3s cubic-bezier(.16, 1, .3, 1);
  }

  .project-tab {
    position: relative;
    z-index: 1;
    padding: .625rem 1.25rem;
    border-radius: var(--ui-pill-radius);
    color: var(--ui-navy);
    text-align: center;
    transition: color .3s ease;
  }

  .project-tab.is-active {
    color: #fff;
  }

  /* ===== Projects: search / sort ===== */
  .project-search {
    position: relative;
  }

  .project-search-input {
    padding-right: 2.75rem !important;
  }

  @media (min-width: 640px) {
    .project-search-input {
      width: 18rem;
    }
  }

  .project-search-icon {
    position: absolute;
    top: 50%;
    right: 1rem;
    display: flex;
    align-items: center;
    color: var(--ui-steel);
    pointer-events: none;
    transform: translateY(-50%);
    transition: color .2s ease;
  }

  .project-search:hover .project-search-icon,
  .project-search:focus-within .project-search-icon {
    color: var(--ui-navy);
  }

  .project-control-button {
    display: flex;
    width: 100%;
    height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-inline: 1.25rem;
    border: 2px solid var(--ui-steel);
    border-radius: var(--ui-pill-radius);
    background: #fff;
    color: var(--ui-navy);
    font-size: 1rem;
    outline: none;
    transition: border-color .2s ease;
  }

  .project-control-button:hover,
  .project-control-button:focus-visible {
    border-color: var(--ui-navy);
  }

  @media (min-width: 640px) {
    .project-control-button {
      width: auto;
    }
  }

  .project-sort-menu {
    left: 0;
    z-index: 20;
    width: 100%;
    margin-top: .5rem;
    overflow: hidden;
    border: 2px solid rgba(1, 42, 74, .3);
    border-radius: var(--ui-pill-radius);
    background: #fff;
    padding: .25rem;
    box-shadow: var(--ui-menu-shadow);
  }

  @media (min-width: 640px) {
    .project-sort-menu {
      right: 0;
      left: auto;
      width: 14rem;
    }
  }

  .project-sort-option {
    display: block;
    width: 100%;
    padding: .625rem 1rem;
    border-radius: var(--ui-pill-radius);
    color: var(--ui-navy);
    font-size: 1rem;
    text-align: left;
    transition: background-color .2s ease;
  }

  .project-sort-option:hover {
    background: var(--ui-sky);
  }

  /* ===== Projects: empty state ===== */
  .project-empty-state {
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .project-empty-text {
    color: rgba(1, 42, 74, .7);
  }

  /* ===== Projects: active rows ===== */
  .project-table-head {
    display: none;
    padding-bottom: 1rem;
  }

  .project-active-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: .75rem;
    overflow: hidden;
    padding: 1.25rem 1.5rem;
    color: var(--ui-navy);
    font-size: 1rem;
    transition: opacity .2s ease;
  }

  .project-row-cell {
    color: var(--ui-navy);
  }

  .project-progress {
    width: 100%;
    max-width: 11.25rem;
    margin-top: .5rem;
  }

  .project-progress-track {
    width: 100%;
    height: .625rem;
    margin-top: .25rem;
    overflow: hidden;
    border-radius: 9999px;
    background: rgba(82, 123, 141, .2);
  }

  .project-progress-bar {
    height: 100%;
    border-radius: inherit;
    background: var(--ui-navy);
  }

  @media (min-width: 1024px) {
    .project-table-head {
      display: grid;
      grid-template-columns: 170px 1fr 230px 210px;
    }

    .project-active-row {
      grid-template-columns: 170px 1fr 230px 210px;
      align-items: stretch;
      gap: 0;
      padding: 0;
    }

    .project-row-cell {
      display: flex;
      padding: 1.5rem;
      align-items: center;
      justify-content: center;
    }

    .project-row-cell--details {
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      border-left: 2px solid var(--ui-steel);
    }

    .project-row-cell--center {
      flex-direction: column;
      border-left: 2px solid var(--ui-steel);
    }

    .project-progress {
      margin-top: 0;
    }
  }

  /* ===== Projects: completed cards ===== */
  .project-completed-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .project-card-content {
    position: relative;
    z-index: 20;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 1.25rem;
    pointer-events: none;
  }

  .project-card-title {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  @media (min-width: 768px) {
    .project-card-title {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .project-complete-status {
    display: flex;
    align-items: center;
    gap: .25rem;
    color: var(--ui-steel);
    font-size: 1rem;
  }
</style>


<%
var SUB_ACTIVE =
  'Тут ви можете відстежувати статуси заявок, з якими ми працюємо';

var SUB_COMPLETED =
  'Тут ви можете переглянути наше портфоліо із завершених проєктів';

var normalizedQ = String(q || '')
  .trim()
  .toLocaleLowerCase('uk-UA');

function cardStatus(project) {
  return project.completed
    ? 'completed'
    : 'active';
}

function matchInit(project) {
  var searchText = String(
    project.searchText || ''
  );

  return (
    cardStatus(project) === status &&
    (
      !normalizedQ ||
      searchText.indexOf(normalizedQ) !== -1
    )
  );
}

var matchTotal =
  projects.filter(matchInit).length;

var shownInit = 0;

function visInit(project) {
  var matched = matchInit(project);

  var visible =
    matched &&
    shownInit < 6;

  if (matched) {
    shownInit += 1;
  }

  return visible;
}
%>
<script>document.documentElement.classList.add('reveal-ready');</script>

<div class="projects-page">
  <main class="site-container section-space">

    <% /* Header & filters */ %>
    <section>
      <h1 class="heading-1">Заявки</h1>
      <p data-subtitle class="project-subtitle"><%= status === 'completed' ? SUB_COMPLETED : SUB_ACTIVE %></p>

      <div class="mt-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div data-toggle class="project-tabs">
          <span data-toggle-thumb class="project-tab-thumb" style="transform: translateX(<%= status === 'completed' ? '100%' : '0%' %>);"></span>
          <button type="button" data-status-tab="active" class="project-tab <%= status === 'active' ? 'is-active' : '' %>">Активні</button>
          <button type="button" data-status-tab="completed" class="project-tab <%= status === 'completed' ? 'is-active' : '' %>">Завершені</button>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
          <div class="project-search">
            <input type="text" data-search-input value="<%= q %>" placeholder="Пошук за номером, назвою або обладнанням" class="form-control form-control-outline project-search-input">
            <span class="project-search-icon">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            </span>
          </div>

          <div class="relative" data-sort>
            <button type="button" data-sort-toggle class="project-control-button">
              <span data-sort-label>Сортувати за</span>
              <svg class="sort-chevron h-4 w-4 shrink-0 text-steel transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="sort-menu project-sort-menu absolute">
              <button type="button" data-sort-opt="new" class="project-sort-option">Спочатку новіші</button>
              <button type="button" data-sort-opt="old" class="project-sort-option">Спочатку старіші</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div id="views-wrap" class="mt-8">

      <section data-empty class="card project-empty-state <%= matchTotal > 0 ? 'hidden' : '' %>">
        <p class="heading-3 project-empty-text" data-empty-text>
          <%= q ? 'За вашим запитом заявок не знайдено.' : (status === 'completed' ? 'Поки що немає завершених проєктів.' : 'Наразі немає активних заявок.') %>
        </p>
      </section>

      <% /* Active table */ %>
      <div data-view="active" class="<%= (status === 'active' && matchTotal > 0) ? '' : 'hidden' %>">
        <div class="reveal-item">
        <div class="project-table-head heading-2">
          <div class="text-center">Номер</div>
          <div class="text-center">Проєкт</div>
          <div class="text-center">Стан</div>
          <div class="whitespace-nowrap text-center">Оновлено</div>
        </div>
        <% var activeRows = projects.filter(function (p) { return !p.completed; }); %>
        <div class="space-y-4">
          <% activeRows.forEach(function (p) { %>
            <a href="/projects/<%= p.requestNumber %>" data-project-item data-status="active" data-number="<%= p.requestNumber %>" data-search="<%= p.searchText %>" data-sort-value="<%= p.sortTimestamp %>"
                class="card card-elevated interactive-card project-active-row group <%= visInit(p) ? '' : 'hidden' %>">
              <div class="project-row-cell">№<%= p.requestNumber %></div>
              <div class="project-row-cell project-row-cell--details">
                <p class="heading-3"><%= p.title %></p>
                <p class="mt-2 text-base text-navy"><span class="font-display font-normal">Обладнання:</span> <%= p.equipment %></p>
                <p class="mt-1 text-base text-navy"><span class="font-display font-normal">Вид ремонту:</span> <%= p.repairType %></p>
              </div>
              <div class="project-row-cell project-row-cell--center">
                <span class="font-bold lg:hidden">Стан: </span>
                <div class="project-progress">
                  <div class="flex items-end justify-between gap-2">
                    <p class="text-base text-navy"><%= p.statusText %></p>
                    <p class="text-base text-navy"><%= p.progress %>%</p>
                  </div>
                  <div class="project-progress-track">
                    <div class="project-progress-bar" style="width: <%= p.progress %>%"></div>
                  </div>
                </div>
              </div>
              <div class="project-row-cell project-row-cell--center">
                <span class="font-bold lg:hidden">Оновлено: </span>
                <p class="whitespace-nowrap text-base text-navy"><%= p.updatedDate %></p>
                <p class="mt-1 whitespace-nowrap text-base text-steel">Створено: <%= p.createdDate %></p>
              </div>
            </a>
          <% }); %>
        </div>
        </div>
      </div>

      <% /* Completed cards */ %>
      <div data-view="completed" class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3 <%= (status === 'completed' && matchTotal > 0) ? '' : 'hidden' %>">
        <% projects.forEach(function (p) { if (!p.completed) { return; } %>

        <article
          data-project-item
          data-project-card
          data-status="completed"
          data-number="<%= p.requestNumber %>"
          data-search="<%= p.searchText %>"
          data-sort-value="<%= p.sortTimestamp %>"
          class="reveal-item card card-elevated interactive-card project-completed-card group <%= visInit(p) ? '' : 'hidden' %>"
        >

          <!-- Photo -->
          <div class="card-photo relative aspect-[16/10] overflow-hidden bg-gradient-to-br from-sky to-white">
            <% if (p.imageMain) { %>
              <img class="absolute inset-0 h-full w-full object-cover" src="<%= p.imageMain %>" alt="<%= p.title %>" loading="lazy">
              <% if (p.imageHover) { %>
                <img class="cp-after absolute inset-0 h-full w-full object-cover" src="<%= p.imageHover %>" alt="<%= p.title %> — після ремонту" loading="lazy">
                <span class="cp-beam" aria-hidden="true"></span>
              <% } %>
            <% } else { %>
              <div class="flex h-full items-center justify-center text-steel/40">
                <svg viewBox="0 0 24 24" class="h-12 w-12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25z"/>
                </svg>
              </div>
            <% } %>
          </div>

          <!-- Content -->
          <div class="project-card-content">
            <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-3">
              <% if (p.imageMain && p.imageHover) { %>
                <button type="button" class="cp-toggle pointer-events-auto col-start-2 row-start-1 mb-2 shrink-0 justify-self-end md:mb-0" data-cp-toggle aria-pressed="false" aria-label="Показати фото після ремонту">
                  <span class="cp-toggle-thumb">
                    <span data-cp-toggle-label>До</span>
                  </span>
                </button>
              <% } %>

              <h3 class="heading-3 line-clamp-2 project-card-title">
                <%= p.title %>
              </h3>

              <p class="col-span-2 row-start-3 mt-1 truncate text-base text-steel md:row-start-2">
                №<%= p.requestNumber %> · <%= p.equipment %>
              </p>
            </div>

            <p class="mt-3 flex-1 text-base text-navy/70">
              <%= p.excerpt %>
            </p>

            <div class="mt-4 flex items-center justify-between">
              <span class="project-complete-status">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd"/>
                </svg>
                Завершено
              </span>

              <span class="action-link">
                Детальніше
                <img class="h-3 w-auto -rotate-90 object-contain" src="/images/icons/icon-chevron-inactive.svg" alt="">
              </span>
            </div>
          </div>

          <!-- Whole-card link -->
          <a class="absolute inset-0 z-10" href="/projects/<%= p.requestNumber %>" aria-label="Відкрити проєкт: <%= p.title %>"></a>

        </article>
        <% }); %>
      </div>
    </div>

    <div data-load-more-wrap class="mt-10 flex justify-center <%= matchTotal > 6 ? '' : 'hidden' %>">
      <button type="button" data-load-more class="btn btn-primary btn-wide">Завантажити ще</button>
    </div>

  </main>
</div>

<script>
  (function () {
    var wrap = document.getElementById('views-wrap');
    if (!wrap) { return; }
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var revealed = false;
    var items = Array.prototype.slice.call(document.querySelectorAll('[data-project-item]'));
    var viewActive = document.querySelector('[data-view="active"]');
    var viewCompleted = document.querySelector('[data-view="completed"]');
    var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-status-tab]'));
    var thumb = document.querySelector('[data-toggle-thumb]');
    var searchInput = document.querySelector('[data-search-input]');
    var sortWrap = document.querySelector('[data-sort]');
    var sortLabel = document.querySelector('[data-sort-label]');
    var loadWrap = document.querySelector('[data-load-more-wrap]');
    var loadBtn = document.querySelector('[data-load-more]');
    var emptyEl = document.querySelector('[data-empty]');
    var emptyText = document.querySelector('[data-empty-text]');
    var subtitle = document.querySelector('[data-subtitle]');
    var SUB = { active: 'Тут ви можете відстежувати статуси заявок, з якими ми працюємо', completed: 'Тут ви можете переглянути наше портфоліо із завершених проектів' };
    var SORT_LABELS = { new: 'Спочатку новіші', old: 'Спочатку старіші' };
    var PER = 6;

    var params = new URLSearchParams(location.search);
    var state = {
      status: params.get('status') === 'completed' ? 'completed' : 'active',
      q: (params.get('q') || '').trim(),
      sort: params.get('sort') === 'old' ? 'old' : 'new',
      shown: PER
    };

    function num(el, key) { return parseInt(el.getAttribute('data-' + key), 10) || 0; }
    function moveThumb() { if (thumb) { thumb.style.transform = state.status === 'completed' ? 'translateX(100%)' : 'translateX(0%)'; } }

    function visibleItems() {
      var c = state.status === 'active' ? viewActive : viewCompleted;
      if (!c) { return []; }
      return Array.prototype.filter.call(c.querySelectorAll('.reveal-item'), function (el) { return !el.classList.contains('hidden'); });
    }
    function ensureRevealed() { visibleItems().forEach(function (el) { el.classList.add('reveal-in'); }); }
    function staggerReveal() {
      var vis = visibleItems();
      if (reduceMotion) { vis.forEach(function (el) { el.classList.add('reveal-in'); }); return; }
      vis.forEach(function (el) { el.classList.remove('reveal-in'); });
      void wrap.offsetWidth;
      vis.forEach(function (el, i) {
        el.style.transitionDelay = (Math.min(i, 8) * 0.06) + 's';
        el.classList.add('reveal-in');
      });
    }

    function apply() {
      var isActive = state.status === 'active';
      var current = items.filter(function (c) { return c.getAttribute('data-status') === state.status; });
      current.sort(function (a, b) {
        var firstTimestamp =
          num(a, 'sort-value');

        var secondTimestamp =
          num(b, 'sort-value');

        return state.sort === 'old'
          ? firstTimestamp - secondTimestamp
          : secondTimestamp - firstTimestamp;
      });
      current.forEach(function (c) { c.parentNode.appendChild(c); });

      var normalizedQuery =
        state.q.toLocaleLowerCase('uk-UA');

      var matched = 0;

      current.forEach(function (item) {
        var searchText =
          item.getAttribute('data-search') || '';

        var matchedQuery =
          !normalizedQuery ||
          searchText.indexOf(normalizedQuery) !== -1;

        if (matchedQuery) {
          item.classList.toggle(
            'hidden',
            matched >= state.shown
          );

          matched += 1;
        } else {
          item.classList.add('hidden');
        }
      });

      if (viewActive) { viewActive.classList.toggle('hidden', !(isActive && matched > 0)); }
      if (viewCompleted) { viewCompleted.classList.toggle('hidden', !(!isActive && matched > 0)); }
      if (emptyText) { emptyText.textContent = state.q ? 'За вашим запитом заявок не знайдено.' : (isActive ? 'Наразі немає активних заявок.' : 'Поки що немає завершених проєктів.'); }
      if (emptyEl) { emptyEl.classList.toggle('hidden', matched > 0); }
      if (loadWrap) { loadWrap.classList.toggle('hidden', matched <= state.shown); }
      if (subtitle) { subtitle.textContent = SUB[state.status]; }

      tabs.forEach(function (t) {
        var on = t.getAttribute('data-status-tab') === state.status;
        t.classList.toggle('is-active', on);
      });
      moveThumb();
      if (sortLabel) { sortLabel.textContent = SORT_LABELS[state.sort]; }

      var p = new URLSearchParams();
      if (state.status === 'completed') { p.set('status', 'completed'); }
      if (state.q) { p.set('q', state.q); }
      if (state.sort === 'old') { p.set('sort', 'old'); }
      var qs = p.toString();
      history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));

      if (revealed) { ensureRevealed(); }
    }

    function fadeApply() {
      wrap.style.opacity = '0';
      if (subtitle) { subtitle.style.opacity = '0'; subtitle.style.transform = 'translateY(6px)'; }
      setTimeout(function () {
        apply(); staggerReveal();
        wrap.style.opacity = '1';
        if (subtitle) { subtitle.style.opacity = '1'; subtitle.style.transform = 'none'; }
      }, 170);
    }

    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        var s = t.getAttribute('data-status-tab');
        if (state.status === s) { return; }
        state.status = s; state.shown = PER; fadeApply();
      });
    });

    if (searchInput) {
      searchInput.value = state.q;
      searchInput.addEventListener('input', function () { state.q = searchInput.value.trim(); state.shown = PER; apply(); });
    }

    if (sortWrap) {
      sortWrap.querySelector('[data-sort-toggle]').addEventListener('click', function (e) {
        e.stopPropagation();
        sortWrap.classList.toggle('sort-open');
      });
      Array.prototype.forEach.call(sortWrap.querySelectorAll('[data-sort-opt]'), function (o) {
        o.addEventListener('click', function () { state.sort = o.getAttribute('data-sort-opt'); sortWrap.classList.remove('sort-open'); apply(); });
      });
      document.addEventListener('click', function (e) { if (!sortWrap.contains(e.target)) { sortWrap.classList.remove('sort-open'); } });
    }

    if (loadBtn) { loadBtn.addEventListener('click', function () { state.shown += PER; apply(); }); }

    /* ===== Before / after toggle ===== */
    var toggles = document.querySelectorAll('[data-view="completed"] [data-cp-toggle]');
    toggles.forEach(function (toggle) {
      toggle.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        var card = toggle.closest('[data-project-card]');
        if (!card) {
          return;
        }

        var showAfter = !card.classList.contains('is-after');
        card.classList.add('is-switching');
        card.classList.toggle('is-after', showAfter);
        clearTimeout(card._cpTimer);
        card._cpTimer = setTimeout(function () {
          card.classList.remove('is-switching');
        }, 2050);

        toggle.setAttribute('aria-pressed', showAfter ? 'true' : 'false');
        toggle.setAttribute('aria-label', showAfter ? 'Показати фото до ремонту' : 'Показати фото після ремонту');

        var label = toggle.querySelector('[data-cp-toggle-label]');
        if (label) {
          label.textContent = showAfter ? 'Після' : 'До';
        }
      });
    });

    apply();

    function initialReveal() { revealed = true; staggerReveal(); }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialReveal);
    } else {
      initialReveal();
    }
    window.addEventListener('load', function () { revealed = true; ensureRevealed(); });
  })();
</script>
