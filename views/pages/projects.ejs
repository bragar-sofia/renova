<%
var SUB_ACTIVE = 'Тут ви можете відстежувати статуси заявок, з якими ми працюємо';
var SUB_COMPLETED = 'Тут ви можете переглянути наше портфоліо із завершених проєктів';
var normalizedQ = String(q || '').trim().toLocaleLowerCase('uk-UA');

function cardStatus(project) {
  return project.completed ? 'completed' : 'active';
}

function matchInit(project) {
  var searchText = String(project.searchText || '');
  return (cardStatus(project) === status && (!normalizedQ || searchText.indexOf(normalizedQ) !== -1));
}

var matchTotal = projects.filter(matchInit).length;
var shownInit = 0;

function visInit(project) {
  var matched = matchInit(project);
  var visible = matched && shownInit < 6;
  if (matched) {
    shownInit += 1;
  }

  return visible;
}
%>


<div class="projects-page" data-projects-page>
  <main class="site-container section-space">
    <% /* ==== Header & filters ====== */ %>
    <section>
      <h1 class="heading-1">Заявки</h1>
      <p class="project-subtitle" data-subtitle>
        <%= status === 'completed' ? SUB_COMPLETED : SUB_ACTIVE %>
      </p>

      <div class="mt-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <!-- Status tabs -->
        <div class="project-tabs<%= status === 'completed' ? ' is-completed' : '' %>" data-toggle>
          <span class="project-tab-thumb"></span>

          <button type="button" class="project-tab<%= status === 'active' ? ' is-active' : '' %>" data-status-tab="active">
            Активні
          </button>

          <button type="button" class="project-tab<%= status === 'completed' ? ' is-active' : '' %>" data-status-tab="completed">
            Завершені
          </button>
        </div>

        <!-- Search & sort -->
        <div class="flex flex-col gap-3 sm:flex-row">
          <!-- Search -->
          <div class="project-search">
            <input type="text" class="form-control form-control-outline project-search-input" data-search-input value="<%= q %>" placeholder="Пошук">
            <span class="project-search-icon">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3"></path>
              </svg>
            </span>
          </div>

          <!-- Sort -->
          <div class="relative" data-sort>
            <button type="button" class="project-control-button" data-sort-toggle aria-expanded="false" aria-controls="project-sort-menu">
              <span data-sort-label>
                Сортувати за
              </span>
              <svg class="sort-chevron h-4 w-4 shrink-0 text-steel transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </button>

            <div id="project-sort-menu" class="sort-menu project-sort-menu absolute">
              <button type="button" class="project-sort-option" data-sort-opt="new">
                Спочатку новіші
              </button>

              <button type="button" class="project-sort-option" data-sort-opt="old">
                Спочатку старіші
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <% /* ====== Views ====== */ %>
    <div id="views-wrap" class="mt-8">
      <% /* ---------- Empty state ---------- */ %>
      <section class="card project-empty-state" data-empty <%= matchTotal > 0 ? 'hidden' : '' %>>
        <p class="heading-3 project-empty-text" data-empty-text>
          <%= q ? 'За вашим запитом заявок не знайдено.' : (status === 'completed' ? 'Поки що немає завершених проєктів.' : 'Наразі немає активних заявок.') %>
        </p>
      </section>

      <% /* ======= Active projects ===== */ %>
      <div data-view="active" <%= (status === 'active' && matchTotal > 0) ? '' : 'hidden' %>>
        <div class="reveal-item">
          <!-- Table head -->
          <div class="project-table-head heading-3">
            <div class="project-head-left">
              Номер
            </div>

            <div class="project-head-left">
              Проєкт
            </div>

            <div class="project-head-left">
              Статус
            </div>
          </div>

          <% var activeRows = projects.filter(function (p) {
            return !p.completed;
          }); %>

          <div class="space-y-4">
            <% activeRows.forEach(function (p) { %>
              <a
                href="/projects/<%= p.requestNumber %>"
                class="card card-elevated interactive-card project-active-row group"
                data-project-item
                data-status="active"
                data-number="<%= p.requestNumber %>"
                data-search="<%= p.searchText %>"
                data-sort-value="<%= p.sortTimestamp %>"
                <%= visInit(p) ? '' : 'hidden' %>
              >
                <span class="card-border" aria-hidden="true"></span>

                <!-- Number -->
                <div class="project-row-cell project-row-cell--number">
                  №<%= p.requestNumber %>
                </div>

                <!-- Details -->
                <div class="project-row-cell project-row-cell--details">
                  <h3 class="heading-3">
                    <%= p.title %>
                  </h3>

                  <p class="mt-2">
                    <span class="font-display font-normal">
                      Послуга:
                    </span>
                    <%= p.workTypeLabel %>
                  </p>

                  <p class="mt-1">
                    <span class="font-display font-normal">
                      Обладнання:
                    </span>
                    <%= p.equipment %>
                  </p>

                  <% if (p.branchLabel) { %>
                    <p class="mt-1 text-sm text-steel">
                      <%= p.branchLabel %>
                    </p>
                  <% } %>
                </div>

                <!-- Status -->
                <div class="project-row-cell project-row-cell--center project-row-cell--progress">
                  <span class="font-bold lg:hidden">
                    Статус:
                  </span>

                  <div class="project-progress">
                    <div class="project-progress-row">
                      <h4 class="heading-4">
                        <%= p.statusText %>
                      </h4>

                      <p class="project-progress-meta">
                        <%= p.updatedDate %>
                      </p>
                    </div>

                    <% if (p.progress !== null) { %>
                      <div class="project-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= p.progress %>" aria-label="<%= p.statusText %>">
                        <span class="project-progress-bar" style="width: <%= p.progress %>%"></span>
                      </div>
                    <% } else { %>
                      <p class="project-progress-note">
                        План виконання робіт уточнюється
                      </p>
                    <% } %>

                    <div class="project-progress-row">
                      <p class="project-progress-meta">
                        Створено: <%= p.createdDate %>
                      </p>

                      <% if (p.progress !== null) { %>
                        <p>
                          <%= p.progress %>%
                        </p>
                      <% } %>
                    </div>
                  </div>
                </div>

              </a>
            <% }); %>
          </div>
        </div>
      </div>

      <% /* ======== Completed projects ======== */ %>
      <div class="projects-completed-grid" data-view="completed" <%= (status === 'completed' && matchTotal > 0) ? '' : 'hidden' %>>
        <% projects.forEach(function (p) {
          if (!p.completed) {
            return;
          }
        %>

        <article
          class="reveal-item card card-elevated interactive-card project-completed-card group"
          data-project-item
          data-project-card
          data-status="completed"
          data-number="<%= p.requestNumber %>"
          data-search="<%= p.searchText %>"
          data-sort-value="<%= p.sortTimestamp %>"
          <%= visInit(p) ? '' : 'hidden' %>
        >
          <span class="card-border" aria-hidden="true"></span>

          <!-- Photo -->
          <div class="card-photo relative aspect-[16/10] overflow-hidden bg-gradient-to-br from-sky to-white">
            <% if (p.imageMain) { %>
              <img class="absolute inset-0 h-full w-full object-cover" src="<%= p.imageMain %>" alt="<%= p.title %>" loading="lazy">
              <% if (p.imageHover) { %>
                <img class="cp-after absolute inset-0 h-full w-full object-cover" src="<%= p.imageHover %>" alt="<%= p.title %> — після виконання робіт" loading="lazy">
                <span class="cp-beam" aria-hidden="true"></span>
              <% } %>
            <% } else { %>
              <div class="flex h-full items-center justify-center text-steel/40">
                <svg viewBox="0 0 24 24" class="h-12 w-12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25z"></path>
                </svg>
              </div>
            <% } %>

            <!-- Work type badge -->
            <div class="pointer-events-none absolute left-3 top-3 z-20">
              <span class="inline-flex w-fit max-w-[calc(100%-1.5rem)] items-center rounded-full border border-white/70 bg-white/95 px-3 py-1.5 text-xs font-bold leading-none text-navy shadow-md backdrop-blur-sm">
                <%= p.workTypeLabel %>
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="project-card-content">
            <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-3">
              <% if (p.imageMain && p.imageHover) { %>
                <button type="button" class="cp-toggle pointer-events-auto col-start-2 row-start-1 mb-2 shrink-0 justify-self-end" data-cp-toggle aria-pressed="false" aria-label="Показати фото після виконання робіт">
                  <span class="cp-toggle-thumb">
                    <span data-cp-toggle-label>
                      До
                    </span>
                  </span>
                </button>
              <% } %>

              <h3 class="heading-3 line-clamp-2 project-card-title">
                <%= p.title %>
              </h3>

              <p class="col-span-2 row-start-3 mt-1 truncate text-base text-steel md:row-start-2">
                №<%= p.requestNumber %> · <%= p.equipment %>
              </p>
            </div>

            <p class="mt-3 text-sm text-navy">
              <span class="font-display font-normal">
                Вид робіт:
              </span>
              <%= p.repairType %>
            </p>

            <div class="mt-4 flex items-center justify-between">
              <span class="project-complete-status">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z"></path>
                </svg>
                Завершено
              </span>

              <span class="action-link">
                Детальніше
                <img class="h-3 w-auto -rotate-90 object-contain" src="/images/icons/icon-chevron-inactive.svg" alt="">
              </span>
            </div>
          </div>

          <!-- Whole-card link -->
          <a class="absolute inset-0 z-10" href="/projects/<%= p.requestNumber %>" aria-label="Відкрити проєкт: <%= p.title %>"></a>
        </article>
        <% }); %>
      </div>
    </div>

    <% /* ===== Load more ======= */ %>
    <nav class="projects-pagination" data-pagination aria-label="Сторінки заявок" <%= matchTotal > 6 ? '' : 'hidden' %>></nav>
  </main>
</div>


<script src="/js/components/before-after.js" defer></script>
<script src="/js/pages/projects.js" defer></script>
