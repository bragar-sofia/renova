            <span class="flex shrink-0 items-center gap-1 whitespace-nowrap rounded-pill border-2 border-steel px-3 py-1.5"><img class="h-7 w-auto object-contain" src="/images/icons/icon-diagnostics.svg" alt="">Діагностика</span>
            <span class="flex shrink-0 items-center gap-1 whitespace-nowrap rounded-pill border-2 border-steel px-3 py-1.5"><img class="h-7 w-auto object-contain" src="/images/icons/icon-capital-repair.svg" alt="">Капітальний ремонт</span>
            <span class="flex shrink-0 items-center gap-1 whitespace-nowrap rounded-pill border-2 border-steel px-3 py-1.5"><img class="h-7 w-auto object-contain" src="/images/icons/icon-emergency-repair.svg" alt="">Аварійний ремонт</span>
            <span class="flex shrink-0 items-center gap-1 whitespace-nowrap rounded-pill border-2 border-steel px-3 py-1.5"><img class="h-7 w-auto object-contain" src="/images/icons/icon-modernization.svg" alt="">Модернізація</span>
            <span class="flex shrink-0 items-center gap-1 whitespace-nowrap rounded-pill border-2 border-steel px-3 py-1.5"><img class="h-7 w-auto object-contain" src="/images/icons/icon-parts-replacement.svg" alt="">Заміна вузлів</span>
          </div>

          <span class="mt-3 flex items-center justify-end gap-2 font-display text-base font-bold text-navy transition group-hover:text-steel">
            Детальніше
            <img class="h-3 w-auto -rotate-90 object-contain transition group-hover:translate-x-1" src="/images/icons/icon-chevron-inactive.svg" alt="">
          </span>
        </div>

        <span class="project-card-border pointer-events-none absolute inset-0" aria-hidden="true"></span>
      </a>

      <!-- Додаткові послуги -->
      <div data-stagger class="mt-3 grid gap-4 md:grid-cols-2">
        <!-- Сервісне обслуговування -->
        <a
          href="/services#service"
          class="services-secondary-card project-card group relative flex flex-col overflow-hidden rounded-card bg-white p-5 transition"
        >
          <span class="absolute left-5 top-5 z-20 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-navy text-base font-bold leading-none text-white">2</span>

          <img class="relative z-10 mx-auto h-20 w-auto object-contain" src="/images/icons/icon-service-maintenance.svg" alt="">

          <h3 class="relative z-10 mt-2 font-display text-h2 font-normal text-navy">Сервісне обслуговування</h3>

          <p class="relative z-10 mt-2 text-left font-display text-h4 text-navy">Планове обслуговування, діагностика та профілактика несправностей для стабільної роботи обладнання, продовження його ресурсу й скорочення незапланованих простоїв.</p>

          <span class="relative z-10 mt-auto flex items-center justify-end gap-2 pt-3 font-display text-base font-bold text-navy transition group-hover:text-steel">
            Детальніше
            <img class="h-3 w-auto -rotate-90 object-contain transition group-hover:translate-x-1" src="/images/icons/icon-chevron-inactive.svg" alt="">
          </span>

          <span class="project-card-border pointer-events-none absolute inset-0" aria-hidden="true"></span>
        </a>

        <!-- Постачання обладнання -->
        <a
          href="/services#supply"
          class="services-secondary-card project-card group relative flex flex-col overflow-hidden rounded-card bg-white p-5 transition"
        >
          <span class="absolute left-5 top-5 z-20 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-navy text-base font-bold leading-none text-white">3</span>

          <img class="relative z-10 mx-auto h-20 w-auto object-contain" src="/images/icons/icon-equipment-supply.svg" alt="">

          <h3 class="relative z-10 mt-2 font-display text-h2 font-normal text-navy">Постачання обладнання</h3>

          <p class="relative z-10 mt-2 text-left font-display text-h4 text-navy">Підбираємо нове обладнання відповідно до технологічних завдань виробництва та супроводжуємо його впровадження — від комерційної пропозиції до запуску.</p>

          <span class="relative z-10 mt-auto flex items-center justify-end gap-2 pt-3 font-display text-base font-bold text-navy transition group-hover:text-steel">
            Детальніше
            <img class="h-3 w-auto -rotate-90 object-contain transition group-hover:translate-x-1" src="/images/icons/icon-chevron-inactive.svg" alt="">
          </span>

          <span class="project-card-border pointer-events-none absolute inset-0" aria-hidden="true"></span>
        </a>
      </div>
    </section>

    <section id="projects-preview" class="mx-auto max-w-shell px-6 py-10 lg:px-8 lg:py-14 xl:px-16 2xl:px-24">
      <h2 class="font-display text-h1 font-normal text-navy">Наші проекти</h2>

      <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-0">
        <div class="md:pr-8 lg:pr-12">
          <h3 class="font-display text-h2 font-normal text-navy">Активні</h3>
          <ul class="mt-5 space-y-3">
            <% activeProjects.forEach(function (p) { %>
              <li>
                <a href="/projects/<%= p.requestNumber %>" class="project-card group relative flex items-center justify-between gap-4 rounded-card bg-white p-4 shadow-[0_16px_42px_rgba(7,49,78,0.07)] transition">
                  <span class="min-w-0">
                    <h3 class="block truncate font-display text-h3 font-normal text-navy"><%= p.title %></h3>
                    <p class="mt-1 block text-base text-steel" data-status-line><span data-num>№<%= p.requestNumber %></span><span data-sep> · </span><span data-stat>Статус:&nbsp;<%= p.statusText %></span></p>
                  </span>
                  <img class="h-3 w-auto shrink-0 -rotate-90 object-contain transition group-hover:translate-x-1" src="/images/icons/icon-chevron-inactive.svg" alt="">
                  <span class="project-card-border pointer-events-none absolute inset-0" aria-hidden="true"></span>
                </a>
              </li>
            <% }); %>
            <% if (!activeProjects.length) { %>
              <li class="rounded-card border border-steel/30 bg-white p-4 text-base text-steel">Наразі немає активних заявок.</li>
            <% } %>
          </ul>
        </div>

        <div class="border-t-2 border-steel/30 pt-8 md:flex md:flex-col md:border-t-0 md:border-l-2 md:pl-8 md:pt-0 lg:pl-12">
          <h3 class="font-display text-h2 font-normal text-navy">Завершені</h3>
          <ul class="mt-5 grid grid-cols-1 gap-3 min-[680px]:grid-cols-2 md:min-h-0 md:flex-1 md:[grid-auto-rows:1fr]">
            <% completedProjects.forEach(function (p) { %>
              <li>
                <a href="/projects/<%= p.requestNumber %>" class="project-card group relative flex h-full flex-col overflow-hidden rounded-card bg-white shadow-[0_16px_42px_rgba(7,49,78,0.07)] transition">
                  <div class="card-photo relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-sky to-white md:aspect-auto md:min-h-0 md:flex-1">
                    <% if (p.imageMain) { %>
                      <img class="absolute inset-0 h-full w-full object-cover" src="<%= p.imageMain %>" alt="<%= p.title %>" loading="lazy">
                      <% if (p.imageHover) { %>
                        <img class="cp-after absolute inset-0 h-full w-full object-cover" src="<%= p.imageHover %>" alt="<%= p.title %> — після ремонту" loading="lazy">
                        <span class="cp-beam" aria-hidden="true"></span>
                      <% } %>
                    <% } else { %>
                      <div class="flex h-full items-center justify-center text-steel/40">
                        <svg viewBox="0 0 24 24" class="h-10 w-10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5z"/></svg>
                      </div>
                    <% } %>
                  </div>
                  <div class="p-3">
                    <% if (p.imageHover) { %>
                      <div class="cp-slider mb-3" data-cp-slider>
                        <div class="flex items-center justify-between text-xs text-steel">
                          <span>До</span>
                          <span>Після</span>
                        </div>
                        <div class="cp-track relative mt-1.5 h-12 rounded-full border-2 border-steel/40 bg-sky" data-cp-track>
                          <span class="cp-handle absolute left-0 top-1/2 h-9 w-9 -translate-y-1/2 rounded-full bg-navy shadow-[0_2px_6px_rgba(7,49,78,0.3)]" data-cp-handle></span>
                        </div>
                      </div>
                    <% } %>
                    <h3 class="block truncate font-display text-h3 font-normal text-navy"><%= p.title %></h3>
                    <p class="mt-1 block truncate text-sm text-steel">№<%= p.requestNumber %> · <%= p.equipment %></p>
                  </div>
                  <span class="project-card-border pointer-events-none absolute inset-0" aria-hidden="true"></span>
                </a>
              </li>
            <% }); %>
            <% if (!completedProjects.length) { %>
              <li class="col-span-2 rounded-card border border-steel/30 bg-white p-4 text-base text-steel">Поки що немає завершених проектів.</li>
            <% } %>
          </ul>
        </div>
      </div>

      <div class="mt-6 flex justify-center">
        <a href="/projects" class="group inline-flex items-center gap-3 rounded-pill bg-navy px-8 py-3 font-display text-base font-bold text-white transition hover:bg-[#0b527b]">
          Перейти до всіх проектів
          <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="M13 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <script>
        (function () {
          var lines = document.querySelectorAll('#projects-preview [data-status-line]');
          function refresh() {
            lines.forEach(function (line) {
              var num = line.querySelector('[data-num]');
              var stat = line.querySelector('[data-stat]');
              var sep = line.querySelector('[data-sep]');
              if (!num || !stat || !sep) { return; }
              num.style.display = '';
              stat.style.display = '';
              sep.style.display = '';
              var lh = parseFloat(getComputedStyle(line).lineHeight) || 24;
              if (line.getBoundingClientRect().height > lh * 1.5) {
                sep.style.display = 'none';
                num.style.display = 'block';
                stat.style.display = 'block';
              }
            });
          }
          refresh();
          window.addEventListener('resize', refresh);
          window.addEventListener('load', refresh);

          if (window.matchMedia && window.matchMedia('(hover: none)').matches) {
            Array.prototype.forEach.call(document.querySelectorAll('#projects-preview [data-cp-slider]'), function (slider) {
              var track = slider.querySelector('[data-cp-track]');
              var handle = slider.querySelector('[data-cp-handle]');
              var card = slider.closest('.project-card');
              var after = card && card.querySelector('.cp-after');
              if (!track || !handle || !card || !after) { return; }
              var dragging = false;
              function pad() { return Math.max(0, (track.clientHeight - handle.offsetHeight) / 2); }
              function setT(t) {
                t = Math.max(0, Math.min(1, t));
                var p = pad();
                var usable = track.clientWidth - handle.offsetWidth - 2 * p;
                handle.style.left = (p + t * usable) + 'px';
                after.style.setProperty('--cp-x', (-25 + t * 155) + '%');
              }
              function tFromEvent(e) {
                var rect = track.getBoundingClientRect();
                var bl = parseFloat(getComputedStyle(track).borderLeftWidth) || 0;
                var p = pad();
                var usable = track.clientWidth - handle.offsetWidth - 2 * p;
                return usable > 0 ? (e.clientX - rect.left - bl - p - handle.offsetWidth / 2) / usable : 0;
              }
              track.addEventListener('pointerdown', function (e) {
                dragging = true;
                card.classList.add('cp-dragging');
                try { track.setPointerCapture(e.pointerId); } catch (err) {}
                setT(tFromEvent(e));
                e.preventDefault();
                e.stopPropagation();
              });
              track.addEventListener('pointermove', function (e) {
                if (!dragging) { return; }
                setT(tFromEvent(e));
                e.preventDefault();
              });
              var stop = function () { dragging = false; card.classList.remove('cp-dragging'); };
              track.addEventListener('pointerup', stop);
              track.addEventListener('pointercancel', stop);
              slider.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); });
              setT(0);
            });
          }
        })();
      </script>
    </section>

