              type="text" name="name" autocomplete="name" required></label>
          <label class="block text-base">Електронна пошта<input
              class="mt-1 block h-12 w-full rounded-pill border-0 px-4 text-base text-navy outline-none transition focus:ring-2 focus:ring-navy/40"
              type="email" name="email" autocomplete="email" required></label>
          <label class="block text-base">Опишіть ваш запит<textarea
              class="mt-1 block h-[10.125rem] w-full resize-none rounded-pill border-0 p-4 text-base text-navy outline-none transition focus:ring-2 focus:ring-navy/40"
