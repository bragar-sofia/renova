      <script>
        (function () {
          var links = document.querySelectorAll('#contacts .copy-link');
          if (!links.length) return;
          function copyText(text, done) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(text).then(done, function () { legacy(text); done(); });
            } else { legacy(text); done(); }
            function legacy(t) {
              var ta = document.createElement('textarea');
              ta.value = t; ta.setAttribute('readonly', '');
              ta.style.position = 'fixed'; ta.style.top = '-1000px'; ta.style.opacity = '0';
              document.body.appendChild(ta); ta.select();
              try { document.execCommand('copy'); } catch (e) {}
              document.body.removeChild(ta);
            }
          }
          links.forEach(function (link) {
            var span = link.querySelector('.copy-text');
            if (!span) return;
            var original = span.textContent;
            link.addEventListener('click', function (e) {
              e.preventDefault();
              copyText(original.trim(), function () {
                span.textContent = 'Скопійовано';
                link.classList.add('is-copied');
                clearTimeout(link._copyT);
                link._copyT = setTimeout(function () {
                  span.textContent = original;
                  link.classList.remove('is-copied');
                }, 1400);
              });
            });
          });
        })();
      </script>
