<%
var activeProjects = (typeof activeProjects !== 'undefined' && activeProjects) ? activeProjects : [];
var completedProjects = (typeof completedProjects !== 'undefined' && completedProjects) ? completedProjects : [];
%>
<div class="home-page">
  <main id="home">
    <%
    var heroSlogans = [
      'Повертаємо до роботи обладнання будь-якого типу та року випуску',
      'Модернізуємо застаріле обладнання під сучасні виробничі завдання',
      'Подовжуємо ресурс обладнання завдяки плановому технічному обслуговуванню',
      'Підбираємо, встановлюємо та запускаємо нове обладнання на вашому підприємстві',
      'Проводимо технічний аудит і визначаємо необхідний обсяг відновлювальних робіт'
    ];
    %>

    <% /* Hero */ %>
    <section class="relative w-full overflow-hidden">
      <div class="hero-inner site-container relative z-10 flex items-center pb-10 pt-8 md:min-h-[560px] md:flex-row md:items-center lg:pb-14 2xl:min-h-[700px]">
        <div class="hero-text-col w-full max-w-none md:max-w-[56%] 2xl:max-w-[52%]">
          <h1 class="hero-slogan heading-1">
            <% heroSlogans.forEach(function (slogan, index) { %>
              <span class="hero-slogan-text<%= index === 0 ? ' is-active' : '' %>" data-hero-slogan aria-hidden="<%= index === 0 ? 'false' : 'true' %>">
                <%= slogan %>
              </span>
            <% }); %>
          </h1>

          <p class="body-copy mt-5 max-w-[32rem] md:text-[1.05rem]">Відновлюємо, обслуговуємо, модернізуємо та запускаємо металообробне і пресове обладнання по всій Україні</p>

          <div class="hero-cta-grid mt-7 flex flex-col items-start gap-3 min-[1201px]:grid min-[1201px]:w-full min-[1201px]:max-w-[480px] min-[1201px]:grid-cols-2">
            <a class="btn btn-primary w-auto min-[1201px]:w-full" href="#contacts">
              Замовити діагностику
            </a>

            <a class="btn btn-outline w-auto min-[1201px]:w-full" href="/services">
              Деталі про послуги
            </a>
          </div>

          <div class="hero-benefits-mobile mt-8 md:hidden">
            <%- include('../partials/hero-benefits') %>
          </div>
        </div>
      </div>

      <div class="hero-photo-fade pointer-events-none absolute inset-y-0 right-0 z-0 w-[92%] overflow-hidden" role="img" aria-label="Пошкоджений верстат відновлюється до справного стану">
        <span class="hero-blueprint-grid" aria-hidden="true"></span>

        <img class="machine-broken absolute inset-0 h-full w-full object-cover object-[60%_center] md:object-cover md:object-[50%_100%] 2xl:object-[50%_85%]" src="/images/lathe-broken.png" alt="" aria-hidden="true">
        <img class="machine-restored absolute inset-0 h-full w-full object-cover object-[60%_center] md:object-cover md:object-[50%_100%] 2xl:object-[50%_85%]" src="/images/lathe-restored.png" alt="" aria-hidden="true">

        <span class="restored-glow" aria-hidden="true"></span>
        <span class="scan-beam" aria-hidden="true"></span>
      </div>
    </section>

    <% /* Benefits band */ %>
    <div class="hero-benefits-band hidden w-full px-6 pb-10 md:block md:mt-10 lg:px-8 lg:pb-14 2xl:mx-auto 2xl:max-w-[1500px]">
      <%- include('../partials/hero-benefits') %>
    </div>

    <% /* Services */ %>
    <section id="services" class="site-container section-space">
      <h2 class="heading-1 mb-8">Наші послуги</h2>

      <a href="/services#restoration" class="services-primary-card card interactive-card group relative block overflow-hidden p-5 transition md:grid md:grid-cols-[300px_1fr] md:items-center md:gap-8">
        <span class="number-badge absolute left-5 top-5 z-20">1</span>
        <div class="relative z-10 mx-auto block h-20 w-auto aspect-[259/221] md:h-auto md:w-48" data-lottie="/images/lottie/restoration.json" aria-hidden="true"></div>

        <div class="relative z-10">
          <h3 class="heading-2">Відновлення обладнання</h3>

          <p class="heading-4 mt-3 max-w-[62rem] text-left">Відновлюємо металообробне та пресове обладнання будь-яких типів і років випуску — від технічного аудиту та аварійного ремонту до капітального відновлення й модернізації.</p>

          <div class="mt-3 flex flex-wrap gap-2 text-base text-navy">
            <span class="chip"><img class="h-7 w-auto object-contain" src="/images/icons/icon-diagnostics.svg" alt="">Діагностика</span>
            <span class="chip"><img class="h-7 w-auto object-contain" src="/images/icons/icon-capital-repair.svg" alt="">Капітальний ремонт</span>
            <span class="chip"><img class="h-7 w-auto object-contain" src="/images/icons/icon-emergency-repair.svg" alt="">Аварійний ремонт</span>
            <span class="chip"><img class="h-7 w-auto object-contain" src="/images/icons/icon-modernization.svg" alt="">Модернізація</span>
          </div>

          <span class="action-link mt-3">
            Детальніше
            <img src="/images/icons/icon-chevron-inactive.svg" alt="">
          </span>
        </div>
      </a>

      <div data-stagger class="mt-3 grid gap-4 md:grid-cols-2">
        <a href="/services#service" class="services-secondary-card card interactive-card group relative flex flex-col overflow-hidden p-5 transition">
          <span class="number-badge absolute left-5 top-5 z-20">2</span>

          <div class="relative z-10 mx-auto h-20 w-auto aspect-[214/150]" data-lottie="/images/lottie/maintenance.json" aria-hidden="true"></div>
          <h3 class="heading-2 relative z-10 mt-2">Технічне обслуговування</h3>
          <p class="heading-4 relative z-10 mt-2 text-left">Розробляємо індивідуальні графіки ППР, проводимо планове технічне обслуговування та поточний ремонт для зниження ризику аварійних відмов і простоїв виробництва.</p>

          <span class="action-link relative z-10 mt-auto pt-3">
            Детальніше
            <img src="/images/icons/icon-chevron-inactive.svg" alt="">
          </span>
        </a>

        <a href="/services#supply" class="services-secondary-card card interactive-card group relative flex flex-col overflow-hidden p-5 transition">
          <span class="number-badge absolute left-5 top-5 z-20">3</span>

          <div class="relative z-10 mx-auto h-20 w-auto aspect-[206/151]" data-lottie="/images/lottie/supply.json" aria-hidden="true"></div>
          <h3 class="heading-2 relative z-10 mt-2">Постачання обладнання</h3>
          <p class="heading-4 relative z-10 mt-2 text-left">Підбираємо нове обладнання відповідно до вимог технічного завдання замовника та супроводжуємо його впровадження — від комерційної пропозиції до монтажу, запуску й навчання персоналу.</p>

          <span class="action-link relative z-10 mt-auto pt-3">
            Детальніше
            <img src="/images/icons/icon-chevron-inactive.svg" alt="">
          </span>
        </a>
      </div>
    </section>

    <% /* Projects */ %>
    <section id="projects-preview" class="site-container section-space">
      <h2 class="heading-1">Наші проекти</h2>

      <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-0">
        <div class="md:pr-8 lg:pr-12">
          <h3 class="heading-2">Активні</h3>
          <ul class="mt-5 space-y-3">
            <% activeProjects.forEach(function (p) { %>
              <li>
                <a href="/projects/<%= p.requestNumber %>" class="card card-elevated interactive-card group relative flex items-center justify-between gap-4 p-4 transition">
                  <span class="min-w-0">
                    <h3 class="heading-3 block truncate"><%= p.title %></h3>
                    <p class="text-muted mt-1 block text-base" data-status-line><span data-num>№<%= p.requestNumber %></span><span data-sep> · </span><span data-stat>Статус:&nbsp;<%= p.statusText %></span></p>
                  </span>
                  <img class="h-3 w-auto shrink-0 -rotate-90 object-contain transition group-hover:translate-x-1" src="/images/icons/icon-chevron-inactive.svg" alt="">
                </a>
              </li>
            <% }); %>
            <% if (!activeProjects.length) { %>
              <li class="card empty-card p-4 text-base">Наразі немає активних заявок.</li>
            <% } %>
          </ul>
        </div>

        <div class="border-t-2 border-steel/30 pt-8 md:flex md:flex-col md:border-t-0 md:border-l-2 md:pl-8 md:pt-0 lg:pl-12">
          <h3 class="heading-2">Завершені</h3>
          <ul class="mt-5 grid grid-cols-1 gap-3 min-[680px]:grid-cols-2 md:min-h-0 md:flex-1 md:[grid-auto-rows:1fr]">
            <% completedProjects.forEach(function (p) { %>
              <li>
                <article class="card card-elevated interactive-card group relative flex h-full flex-col overflow-hidden transition" data-project-card>
                  <!-- Photo -->
                  <div class="card-photo relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-sky to-white md:aspect-auto md:min-h-0 md:flex-1">
                    <% if (p.imageMain) { %>
                      <img class="absolute inset-0 h-full w-full object-cover" src="<%= p.imageMain %>" alt="<%= p.title %>" loading="lazy">
                      <% if (p.imageHover) { %>
                        <img class="cp-after absolute inset-0 h-full w-full object-cover" src="<%= p.imageHover %>" alt="<%= p.title %> — після ремонту" loading="lazy">
                        <span class="cp-beam" aria-hidden="true"></span>
                      <% } %>
                    <% } else { %>
                      <div class="flex h-full items-center justify-center text-steel/40">
                        <svg viewBox="0 0 24 24" class="h-10 w-10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5z"/>
                        </svg>
                      </div>
                    <% } %>
                  </div>

                  <!-- Content -->
                  <div class="pointer-events-none relative z-20 grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 p-3">
                    <% if (p.imageMain && p.imageHover) { %>
                      <button type="button" class="cp-toggle pointer-events-auto col-start-2 row-start-1 mb-2 shrink-0 justify-self-end md:mb-0" data-cp-toggle aria-pressed="false" aria-label="Показати фото після ремонту">
                        <span class="cp-toggle-thumb">
                          <span data-cp-toggle-label>До</span>
                        </span>
                      </button>
                    <% } %>

                    <h3 class="line-clamp-2 heading-3 col-span-2 row-start-2 md:col-span-1 md:col-start-1 md:row-start-1">
                      <%= p.title %>
                    </h3>

                    <p class="text-muted col-span-2 row-start-3 mt-1 truncate text-base md:row-start-2">
                      №<%= p.requestNumber %> · <%= p.equipment %>
                    </p>
                  </div>

                  <!-- Whole-card link -->
                  <a class="absolute inset-0 z-10" href="/projects/<%= p.requestNumber %>" aria-label="Відкрити проєкт: <%= p.title %>"></a>
                </article>
              </li>
            <% }); %>
            <% if (!completedProjects.length) { %>
              <li class="card empty-card col-span-2 p-4 text-base">Поки що немає завершених проектів.</li>
            <% } %>
          </ul>
        </div>
      </div>

      <div class="mt-6 flex justify-center">
        <a href="/projects" class="btn btn-primary btn-wide">
          Перейти до всіх проектів
        </a>
      </div>
    </section>

    <% /* About */ %>
    <section id="about">
      <div class="site-container section-space">
        <div class="grid gap-6 md:grid-cols-[auto_minmax(0,1fr)] md:items-center">
          <div>
            <h2 class="heading-1">Про нас</h2>
            <div class="about-card card card-elevated mt-8">
            <nav class="about-tabs" aria-label="Інформація про компанію">
              <a class="about-tab is-active" href="#about">Хто ми?</a>
              <a class="about-tab" href="#about">Наш досвід</a>
              <a class="about-tab" href="#about">Спеціалісти</a>
              <a class="about-tab" href="#about">Інструменти</a>
            </nav>

            <div class="p-5 md:p-7 lg:p-8">
              <div class="body-copy max-w-[34rem] space-y-3 text-left xl:max-w-[44rem] 2xl:max-w-[52rem]">
                <p>
                  RENOVA — це команда професіоналів, фахівців у сфері
                  постачання, ремонту й обслуговування складного обладнання.
                </p>

                <p>
                  Ми працюємо безпосередньо з виробничими підприємствами,
                  занурюючись у специфіку кожного проєкту: від технічного
                  завдання до фінального результату. Такий підхід дозволяє
                  пропонувати рішення, що відповідають реальним потребам
                  виробництва, а не шаблонним схемам.
                </p>

                <p>
                  Наша мета — бути надійним партнером для замовників на всіх
                  етапах: від вибору обладнання до його подальшої експлуатації.
                </p>
              </div>
            </div>
          </div>
          </div>
          <div class="relative hidden -mr-6 overflow-hidden rounded-l-card rounded-r-none md:block md:h-[30rem] lg:h-[34rem] lg:-mr-8 xl:h-[38rem] xl:-mr-16 2xl:h-[42rem] 2xl:-mr-24">
            <img class="absolute inset-0 h-full w-full object-cover object-left" src="/images/machining-center-trimmed.png" alt="Сучасний оброблювальний центр" loading="lazy" decoding="async">
          </div>
        </div>
      </div>
    </section>

    <% /* Contacts & form */ %>
    <section id="contacts" class="site-container site-container-contact">
      <div class="relative overflow-hidden rounded-hero bg-steel p-5 text-white sm:p-7 lg:grid lg:grid-cols-2 lg:gap-12 lg:p-14">
        <img class="pointer-events-none absolute right-0 top-0 w-[85%] translate-x-20 -scale-y-100 opacity-40 mix-blend-multiply lg:bottom-0 lg:left-0 lg:right-auto lg:top-auto lg:w-[48%] lg:translate-x-0 lg:scale-y-100 lg:-scale-x-100" src="/images/tools.png" alt="" loading="lazy" decoding="async">

        <div class="relative">
          <h2 class="contact-title">
            Потрібна допомога?
          </h2>

          <p class="contact-subtitle mt-4">
            Зв'яжіться з нами за номером, поштою або&nbsp;заповніть&nbsp;форму
          </p>

          <div class="contact-links mt-7 space-y-3">
            <a class="copy-link flex items-center gap-3 transition hover:text-navy" data-copy-link href="tel:+380756787784" title="Натисніть, щоб скопіювати">
              <img class="h-8 w-8 object-contain" src="/images/icons/icon-phone-contact.svg" alt="">
              <span class="copy-text" data-copy-text>
                075 678 77 84
              </span>
            </a>

            <a class="copy-link flex items-center gap-3 transition hover:text-navy" data-copy-link href="mailto:commerce.renova@gmail.com" title="Натисніть, щоб скопіювати">
              <img class="h-8 w-8 object-contain" src="/images/icons/icon-email-contact.svg" alt="">
              <span class="copy-text" data-copy-text>
                commerce.renova@gmail.com
              </span>
            </a>
          </div>
        </div>

        <form id="contact-form" class="relative mt-7 space-y-3 lg:mt-0" data-contact-form action="/contact" method="post">
          <% if (typeof _csrf !== 'undefined' && _csrf) { %>
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
          <% } %>

          <div class="grid gap-3 sm:grid-cols-2">
            <input id="contact-name" class="form-control" type="text" name="name" autocomplete="name" placeholder="Ваше ім'я" maxlength="80" required>
            <input id="contact-phone" class="form-control" type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="Номер телефону" maxlength="30" required>
          </div>

          <input id="contact-email" class="form-control" type="email" name="email" autocomplete="email" placeholder="Електронна пошта" maxlength="254" required>
          <textarea id="contact-message" class="form-control" name="message" placeholder="Опишіть ваш запит" maxlength="3000" required></textarea>

          <button class="btn btn-primary btn-block" type="submit" data-contact-submit>
            Надіслати форму
          </button>

            <div class="form-status" data-contact-status role="status" aria-live="polite" hidden></div>
        </form>
      </div>
    </section>

    <% /* FAQ */ %>
    <section id="faq" class="site-container section-space">
      <h2 class="heading-1">Часті запитання</h2>
      <div class="faq-panel mt-8">
        <%
          var faqItems = [
            { q: 'Що потрібно для розрахунку вартості постачання обладнання?', a: 'Технічне завдання та реквізити компанії — на основі цього фахівці прорахують вартість поставки, монтажу та пусконалагодки.' },
            { q: 'Чи навчаєте ви персонал роботі з новим обладнанням?', a: 'Так, після поставки та монтажу проводиться базове навчання представників Замовника роботі на даному типі обладнання.' },
            { q: 'Чи надається гарантія на ремонт і поставку?', a: 'Так, передбачено гарантійне обслуговування, а також супровід обладнання в&nbsp;післягарантійний період.' },
            { q: 'Які типи обладнання ви обслуговуєте?', a: 'Ми працюємо зі станочним обладнанням різних типів — від типових моделей до складних і&nbsp;застарілих верстатів, включно з&nbsp;тими, що вже знято з виробництва.' },
            { q: 'Чим відрізняється капітальний ремонт від звичайного?', a: 'Капітальний ремонт — це повний цикл: діагностика, розбирання, заміна або відновлення вузлів, шліфовка базових поверхонь, ремонт гідравліки, пневматики та електрики, фінальні випробування. Малий або середній ремонт вирішує конкретну локальну проблему без повного розбирання верстата.' },
            { q: 'Скільки коштує ремонт обладнання?', a: 'Вартість завжди розраховується індивідуально — залежить від комплектності верстата, ступеня зношення, складності робіт і&nbsp;обсягу технічного завдання. Менеджер надає розрахунок у вигляді комерційної пропозиції після оцінки.' }
          ];
        %>
        <% faqItems.forEach(function (item) { %>
          <details class="faq-item faq-item-local group" data-faq-item>
            <summary class="faq-summary">
              <span><%= item.q %></span>
              <img class="faq-chevron" src="/images/icons/icon-chevron-down.svg" alt="">
            </summary>
            <div class="faq-answer" data-faq-answer>
              <div class="faq-answer-inner">
                <p class="body-copy mt-3"><%- item.a %></p>
              </div>
            </div>
          </details>
        <% }); %>
      </div>
    </section>
  </main>
</div>


<script src="/js/components/before-after.js" defer></script>
<script src="/js/components/faq.js" defer></script>
<script src="/js/pages/home.js" defer></script>
