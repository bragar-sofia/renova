    <section id="faq" class="mx-auto max-w-shell px-6 py-10 lg:px-8 lg:py-14 xl:px-16 2xl:px-24">
      <style>
        #faq .faq-answer {
          display: grid;
          grid-template-rows: 0fr;
          opacity: 0;
          transition: grid-template-rows 0.42s cubic-bezier(0.4, 0, 0.2, 1),
                      opacity 0.34s ease;
        }
        #faq .faq-item.is-open .faq-answer {
          grid-template-rows: 1fr;
          opacity: 1;
        }
        #faq .faq-answer > .faq-answer-inner {
          overflow: hidden;
          min-height: 0;
        }
        #faq .faq-item.is-open .faq-chevron {
          transform: rotate(180deg);
        }
        @media (prefers-reduced-motion: reduce) {
          #faq .faq-answer { transition: none; }
        }
      </style>

      <h2 class="font-display text-h1 font-normal text-navy">Часті запитання</h2>
      <div class="mt-6 rounded-card bg-white px-6 py-6 text-navy">
        <%
          var faqItems = [
            { q: 'Що потрібно для розрахунку вартості постачання обладнання?', a: 'Технічне завдання та реквізити компанії — на основі цього фахівці прорахують вартість поставки, монтажу та пусконалагодки.' },
            { q: 'Чи навчаєте ви персонал роботі з новим обладнанням?', a: 'Так, після поставки та монтажу проводиться базове навчання представників Замовника роботі на даному типі обладнання.' },
            { q: 'Чи надається гарантія на ремонт і поставку?', a: 'Так, передбачено гарантійне обслуговування, а також супровід обладнання в&nbsp;післягарантійний період.' },
            { q: 'Які типи обладнання ви обслуговуєте?', a: 'Ми працюємо зі станочним обладнанням різних типів — від типових моделей до складних і&nbsp;застарілих верстатів, включно з&nbsp;тими, що вже знято з виробництва.' },
            { q: 'Чим відрізняється капітальний ремонт від звичайного?', a: 'Капітальний ремонт — це повний цикл: діагностика, розбирання, заміна або відновлення вузлів, шліфовка базових поверхонь, ремонт гідравліки, пневматики та електрики, фінальні випробування. Малий або середній ремонт вирішує конкретну локальну проблему без повного розбирання верстата.' },
            { q: 'Скільки коштує ремонт обладнання?', a: 'Вартість завжди розраховується індивідуально — залежить від комплектності верстата, ступеня зношення, складності робіт і&nbsp;обсягу технічного завдання. Менеджер надає розрахунок у вигляді комерційної пропозиції після оцінки.' }
          ];
        %>
        <% faqItems.forEach(function (item) { %>
          <details class="faq-item group border-b border-steel py-4 first:pt-2 last:border-b-0 last:pb-2 md:first:pt-0 md:last:pb-0">
            <summary
              class="flex min-h-[2.1em] cursor-pointer list-none items-center justify-between gap-3 text-h3 font-display font-normal transition-colors hover:text-steel">
              <span><%= item.q %></span> <img
                class="faq-chevron h-3 w-auto shrink-0 object-contain transition-transform group-hover:scale-125"
                src="/images/icons/icon-chevron-down.svg" alt=""></summary>
            <div class="faq-answer">
              <div class="faq-answer-inner">
                <p class="mt-3 text-base leading-7 text-navy"><%- item.a %></p>
              </div>
            </div>
          </details>
        <% }); %>
      </div>

      <script>
        (function () {
          var items = document.querySelectorAll('#faq .faq-item');
          if (!items.length) { return; }
          var reduce = window.matchMedia &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          items.forEach(function (details) {
            var summary = details.querySelector('summary');
            var answer = details.querySelector('.faq-answer');
            if (!summary || !answer) { return; }
            var animating = false;

            summary.addEventListener('click', function (e) {
              e.preventDefault();
              if (animating) { return; }

              if (reduce) {
                details.open = !details.open;
                details.classList.toggle('is-open', details.open);
                return;
              }

              if (details.open) {
                animating = true;
                details.classList.remove('is-open');
                var done = false;
                var finish = function () {
                  if (done) { return; }
                  done = true;
                  answer.removeEventListener('transitionend', onEnd);
                  details.open = false;
                  animating = false;
                };
                var onEnd = function (ev) {
                  if (ev.target === answer && ev.propertyName === 'grid-template-rows') { finish(); }
                };
                answer.addEventListener('transitionend', onEnd);
                setTimeout(finish, 550);
              } else {
                details.open = true;
                void answer.offsetHeight;
                details.classList.add('is-open');
              }
            });
          });
        })();
      </script>
    </section>
  </main>
</div>
