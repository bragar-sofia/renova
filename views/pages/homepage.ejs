              for="contact-name"
            >
              Ім'я
            </label>

            <input
              id="contact-name"
              class="block h-12 w-full rounded-pill border-0 px-4 text-base text-navy outline-none transition placeholder:text-steel/70 focus:ring-2 focus:ring-navy/40"
              type="text"
              name="name"
              autocomplete="name"
              placeholder="Ваше ім'я"
              maxlength="80"
              required
            >

            <label
              class="sr-only"
              for="contact-phone"
            >
              Номер телефону
            </label>

            <input
              id="contact-phone"
              class="block h-12 w-full rounded-pill border-0 px-4 text-base text-navy outline-none transition placeholder:text-steel/70 focus:ring-2 focus:ring-navy/40"
              type="tel"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
              placeholder="Номер телефону"
              maxlength="30"
              required
            >
          </div>

          <label
            class="sr-only"
            for="contact-email"
          >
            Електронна пошта
          </label>

          <input
            id="contact-email"
            class="block h-12 w-full rounded-pill border-0 px-4 text-base text-navy outline-none transition placeholder:text-steel/70 focus:ring-2 focus:ring-navy/40"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="Електронна пошта"
            maxlength="254"
            required
          >

          <label
            class="sr-only"
            for="contact-message"
          >
            Опишіть ваш запит
          </label>

          <textarea
            id="contact-message"
            class="block h-[10.125rem] w-full resize-none rounded-pill border-0 p-4 text-base text-navy outline-none transition placeholder:text-steel/70 focus:ring-2 focus:ring-navy/40"
            name="message"
            placeholder="Опишіть ваш запит"
            maxlength="3000"
            required
          ></textarea>

          <button
            class="w-full rounded-pill bg-navy py-3 font-display text-base font-bold text-white transition hover:bg-[#0b527b] disabled:cursor-not-allowed disabled:opacity-60"
            type="submit"
            data-contact-submit
          >
            Надіслати форму
          </button>

          <div
            class="hidden rounded-pill px-4 py-3 text-center text-sm font-medium"
            data-contact-status
            role="status"
            aria-live="polite"
          ></div>
        </form>
      </div>

      <script>
        (function () {
          var links =
            document.querySelectorAll(
              '#contacts .copy-link'
            );

          if (links.length) {
            function legacyCopy(text) {
              var textarea =
                document.createElement('textarea');

              textarea.value = text;

              textarea.setAttribute(
                'readonly',
                ''
              );

              textarea.style.position = 'fixed';
              textarea.style.top = '-1000px';
              textarea.style.opacity = '0';

              document.body.appendChild(
                textarea
              );

              textarea.select();

              try {
                document.execCommand('copy');
              } catch (error) {
              }

              document.body.removeChild(
                textarea
              );
            }

            function copyText(text, done) {
              if (
                navigator.clipboard &&
                navigator.clipboard.writeText
              ) {
                navigator.clipboard
                  .writeText(text)
                  .then(done)
                  .catch(function () {
                    legacyCopy(text);
                    done();
                  });

                return;
              }

              legacyCopy(text);
              done();
            }

            links.forEach(function (link) {
              var textElement =
                link.querySelector(
                  '.copy-text'
                );

              if (!textElement) {
                return;
              }

              var originalText =
                textElement.textContent.trim();

              link.addEventListener(
                'click',
                function (event) {
                  event.preventDefault();

                  copyText(
                    originalText,
                    function () {
                      textElement.textContent =
                        'Скопійовано';

                      link.classList.add(
                        'is-copied'
                      );

                      clearTimeout(
                        link._copyTimeout
                      );

                      link._copyTimeout =
                        setTimeout(
                          function () {
                            textElement.textContent =
                              originalText;

                            link.classList.remove(
                              'is-copied'
                            );
                          },
                          1400
                        );
                    }
                  );
                }
              );
            });
          }

          var form =
            document.querySelector(
              '#contact-form'
            );

          if (!form) {
            return;
          }

          var submitButton =
            form.querySelector(
              '[data-contact-submit]'
            );

          var statusElement =
            form.querySelector(
              '[data-contact-status]'
            );

          var defaultButtonText =
            submitButton.textContent.trim();

          function showStatus(type, message) {
            statusElement.textContent =
              message;

            statusElement.className =
              'rounded-pill px-4 py-3 text-center text-sm font-medium';

            if (type === 'success') {
              statusElement.classList.add(
                'bg-emerald-50',
                'text-emerald-800'
              );
            } else {
              statusElement.classList.add(
                'bg-red-50',
                'text-red-800'
              );
            }
          }

          form.addEventListener(
            'submit',
            async function (event) {
              event.preventDefault();

              submitButton.disabled = true;
              submitButton.textContent =
                'Надсилаємо...';

              statusElement.classList.add(
                'hidden'
              );

              try {
                var formData =
                  new FormData(form);

                var response =
                  await fetch(
                    form.action,
                    {
                      method: 'POST',

                      headers: {
                        Accept:
                          'application/json'
                      },

                      body:
                        new URLSearchParams(
                          formData
                        )
                    }
                  );

                var data = {};

                try {
                  data =
                    await response.json();
                } catch (error) {
                }

                if (!response.ok) {
                  throw new Error(
                    data.error ||
                    'Не вдалося надіслати повідомлення.'
                  );
                }

                form.reset();

                showStatus(
                  'success',
                  data.message ||
                  'Дякуємо! Ваше повідомлення надіслано.'
                );
              } catch (error) {
                showStatus(
                  'error',
                  error.message ||
                  'Не вдалося надіслати повідомлення. Спробуйте ще раз.'
                );
              } finally {
                submitButton.disabled = false;

                submitButton.textContent =
                  defaultButtonText;
              }
            }
          );
        })();
      </script>
    </section>

    <% /* FAQ */ %>
    <section id="faq" class="mx-auto max-w-shell px-6 py-10 lg:px-8 lg:py-14 xl:px-16 2xl:px-24">
      <h2 class="font-display text-h1 font-normal text-navy">Часті запитання</h2>
      <div class="mt-8 rounded-card bg-white px-6 py-6 text-navy">
        <%
          var faqItems = [
            { q: 'Що потрібно для розрахунку вартості постачання обладнання?', a: 'Технічне завдання та реквізити компанії — на основі цього фахівці прорахують вартість поставки, монтажу та пусконалагодки.' },
            { q: 'Чи навчаєте ви персонал роботі з новим обладнанням?', a: 'Так, після поставки та монтажу проводиться базове навчання представників Замовника роботі на даному типі обладнання.' },
            { q: 'Чи надається гарантія на ремонт і поставку?', a: 'Так, передбачено гарантійне обслуговування, а також супровід обладнання в&nbsp;післягарантійний період.' },
            { q: 'Які типи обладнання ви обслуговуєте?', a: 'Ми працюємо зі станочним обладнанням різних типів — від типових моделей до складних і&nbsp;застарілих верстатів, включно з&nbsp;тими, що вже знято з виробництва.' },
            { q: 'Чим відрізняється капітальний ремонт від звичайного?', a: 'Капітальний ремонт — це повний цикл: діагностика, розбирання, заміна або відновлення вузлів, шліфовка базових поверхонь, ремонт гідравліки, пневматики та електрики, фінальні випробування. Малий або середній ремонт вирішує конкретну локальну проблему без повного розбирання верстата.' },
            { q: 'Скільки коштує ремонт обладнання?', a: 'Вартість завжди розраховується індивідуально — залежить від комплектності верстата, ступеня зношення, складності робіт і&nbsp;обсягу технічного завдання. Менеджер надає розрахунок у вигляді комерційної пропозиції після оцінки.' }
          ];
        %>
        <% faqItems.forEach(function (item) { %>
          <details class="faq-item group border-b border-steel py-4 first:pt-2 last:border-b-0 last:pb-2 md:first:pt-0 md:last:pb-0">
            <summary
              class="flex min-h-[2.1em] cursor-pointer list-none items-center justify-between gap-3 text-h3 font-display font-normal transition-colors hover:text-steel">
              <span><%= item.q %></span> <img
                class="faq-chevron h-3 w-auto shrink-0 object-contain transition-transform group-hover:scale-125"
                src="/images/icons/icon-chevron-down.svg" alt=""></summary>
            <div class="faq-answer">
              <div class="faq-answer-inner">
                <p class="mt-3 text-base leading-7 text-navy"><%- item.a %></p>
              </div>
            </div>
          </details>
        <% }); %>
      </div>

      <script>
        (function () {
          var items = document.querySelectorAll('#faq .faq-item');
          if (!items.length) { return; }
          var reduce = window.matchMedia &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          items.forEach(function (details) {
            var summary = details.querySelector('summary');
            var answer = details.querySelector('.faq-answer');
            if (!summary || !answer) { return; }
            var animating = false;

            summary.addEventListener('click', function (e) {
              e.preventDefault();
              if (animating) { return; }

              if (reduce) {
                details.open = !details.open;
                details.classList.toggle('is-open', details.open);
                return;
              }

              if (details.open) {
                animating = true;
                details.classList.remove('is-open');
                var done = false;
                var finish = function () {
                  if (done) { return; }
                  done = true;
                  answer.removeEventListener('transitionend', onEnd);
                  details.open = false;
                  animating = false;
                };
                var onEnd = function (ev) {
                  if (ev.target === answer && ev.propertyName === 'grid-template-rows') { finish(); }
                };
                answer.addEventListener('transitionend', onEnd);
                setTimeout(finish, 550);
              } else {
                details.open = true;
                void answer.offsetHeight;
                details.classList.add('is-open');
              }
            });
          });
        })();
      </script>
    </section>
  </main>
</div>


<script>
  (function () {
    /* ===== Hero slogans ===== */
    var slogans = Array.prototype.slice.call(document.querySelectorAll('[data-hero-slogan]'));
    if (slogans.length > 1) {

      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        var current = 0;

        function nextSlogan() {
          var previous = slogans[current];
          current = (current + 1) % slogans.length;
          var next = slogans[current];

          previous.classList.remove('is-active');
          previous.classList.add('is-leaving');
          previous.setAttribute('aria-hidden', 'true');

          setTimeout(function () {
            next.classList.add('is-active');
            next.setAttribute('aria-hidden', 'false');
          }, 180);

          setTimeout(function () {
            previous.classList.remove('is-leaving');
          }, 700);
        }

        setInterval(nextSlogan, 6500);
      }
    }


    /* ===== Hero benefits entrance ===== */
    var band = document.querySelector('.hero-benefits-band');

    if (band) {
      window.requestAnimationFrame(function () {
        window.requestAnimationFrame(function () {
          band.classList.add('is-in');
        });
      });

      setTimeout(function () {
        band.classList.add('is-in');
      }, 300);
    }


    /* ===== Hero benefit separators ===== */
    (function () {
      var seps = document.querySelectorAll('.hero-benefit-sep');
      if (!seps.length) {
        return;
      }

      function snapSeps() {
        var dpr = window.devicePixelRatio || 1;

        seps.forEach(function (sep) {
          sep.style.transform = '';
          sep.style.width = '';
        });

        if (getComputedStyle(seps[0]).display === 'none') {
          return;
        }

        var width = Math.max(1, Math.round(2 * dpr)) / dpr;
        seps.forEach(function (sep) {
          sep.style.width = width + 'px';
        });

        seps.forEach(function (sep) {
          var left = sep.getBoundingClientRect().left * dpr;
          var offset = (Math.round(left) - left) / dpr;
          sep.style.transform = 'translateX(' + offset + 'px)';
        });
      }

      setTimeout(snapSeps, 1100);
      window.addEventListener('resize', snapSeps);
    })();
  })();
</script>
