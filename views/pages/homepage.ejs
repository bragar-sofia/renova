    <section id="contacts" class="mx-auto max-w-shell px-6 py-10 lg:px-8 lg:py-14 xl:px-16 2xl:px-24">
      <div class="relative overflow-hidden rounded-hero bg-steel p-14 text-white lg:grid lg:grid-cols-2 lg:gap-12">
        <img
          class="pointer-events-none absolute right-0 top-0 w-[85%] translate-x-20 -scale-y-100 opacity-40 mix-blend-multiply lg:bottom-0 lg:left-0 lg:right-auto lg:top-auto lg:w-[48%] lg:translate-x-0 lg:scale-y-100 lg:-scale-x-100"
          src="/images/tools.png" alt="" loading="lazy" decoding="async">
        <div class="relative">
          <h2 class="font-display text-h1 font-normal">Потрібна допомога?</h2>
          <p class="mt-4 font-display text-h3 font-normal">Зв'яжіться за номером, поштою або заповніть форму</p>
          <div class="mt-7 space-y-3 font-display text-h3">
            <a class="flex items-center gap-3 transition hover:text-navy" href="tel:+380996380525"><img
                class="h-8 w-8 object-contain" src="/images/icons/icon-phone-contact.svg" alt="">+38 (099) 638 05 25</a>
            <a class="flex items-center gap-3 transition hover:text-navy" href="mailto:support@renova"><img
