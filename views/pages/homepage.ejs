<%
var activeProjects = (typeof activeProjects !== 'undefined' && activeProjects) ? activeProjects : [];
var completedProjects = (typeof completedProjects !== 'undefined' && completedProjects) ? completedProjects : [];
%>
<style>
  .hero-slogan {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    font-size: clamp(2rem, 0.4rem + 2.7vw, 3.4rem);
    line-height: 1.08;
  }
  .hero-slogan-text {
    display: inline-block;
    will-change: transform, opacity, filter;
    transition: opacity 0.45s ease,
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.45s ease;
  }
  .hero-slogan-text.is-out {
    opacity: 0;
    transform: translateY(-22px);
    filter: blur(6px);
  }
  .hero-slogan-text.is-pre {
    opacity: 0;
    transform: translateY(22px);
    filter: blur(6px);
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slogan-text { transition: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-benefits-band .hero-benefit-item,
    .hero-benefits-band .hero-benefit-sep {
      opacity: 0;
      transform: translateY(26px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-benefits-band.is-in .hero-benefit-item,
    .hero-benefits-band.is-in .hero-benefit-sep {
      opacity: 1;
      transform: none;
    }
    .hero-benefits-band .hero-benefits > *:nth-child(1) { transition-delay: 0.05s; }
    .hero-benefits-band .hero-benefits > *:nth-child(2) { transition-delay: 0.11s; }
    .hero-benefits-band .hero-benefits > *:nth-child(3) { transition-delay: 0.17s; }
    .hero-benefits-band .hero-benefits > *:nth-child(4) { transition-delay: 0.23s; }
    .hero-benefits-band .hero-benefits > *:nth-child(5) { transition-delay: 0.29s; }
    .hero-benefits-band .hero-benefits > *:nth-child(6) { transition-delay: 0.35s; }
    .hero-benefits-band .hero-benefits > *:nth-child(7) { transition-delay: 0.41s; }
    .hero-benefits-band .hero-benefits > *:nth-child(8) { transition-delay: 0.47s; }
    .hero-benefits-band .hero-benefits > *:nth-child(9) { transition-delay: 0.53s; }
  }

  /* Текст кнопок хіро масштабується разом з рештою тексту */
  .hero-cta-btn { font-size: clamp(0.85rem, 0.6rem + 1vw, 1rem); }

  /* Hero не масштабуємо при появі — інакше фото не дистає краю (з'являється «зазор») */
  #home > section { transform: none !important; }

  /* Вузькі / мобільні екрани: фото — вузька смуга на всю висоту, текст ліворуч без накладання */
  @media (max-width: 1200px) {
    .hero-inner {
      min-height: calc(100svh - 5.25rem);
    }
    .hero-text-col {
      max-width: 58%;
    }
    .hero-text-col p {
      max-width: none;
    }
    .hero-photo-fade {
      width: 44%;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 58%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 58%);
    }
    .hero-photo-fade .machine-broken,
    .hero-photo-fade .machine-restored {
      top: auto;
      bottom: -10%;
      height: 130%;
      object-position: 66% center;
    }
  }

  /* Планшети / малі ноути: фото ширше і ближче до тексту (менша діра між текстом і верстатом) */
  @media (min-width: 640px) and (max-width: 1200px) {
    .hero-photo-fade {
      width: 54%;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 56%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 56%);
    }
  }
</style>
<div class="min-h-screen bg-sky font-sans text-navy antialiased">
  <main id="home">
    <section class="relative w-full overflow-hidden">
      <div class="hero-inner relative z-10 mx-auto flex w-full max-w-shell items-center px-6 pb-10 pt-8 md:min-h-[560px] md:flex-row md:items-center lg:px-8 lg:pb-14 xl:px-16 2xl:min-h-[700px] 2xl:px-24">
        <div class="hero-text-col w-full max-w-none md:max-w-[56%] 2xl:max-w-[52%]">
        <h1 class="hero-slogan min-h-[2.5em] font-display text-h1 font-normal">
          <span class="hero-slogan-text" data-hero-slogan>Ремонт та обслуговування<br>металоріжучих верстатів</span>
        </h1>

        <p class="mt-5 max-w-[32rem] font-sans text-base leading-7 text-navy md:text-[1.05rem] md:leading-8">Відновлюємо, обслуговуємо, модернізуємо та запускаємо металообробне і пресове обладнання по всій Україні</p>

        <div class="mt-7 grid w-full max-w-[440px] grid-cols-1 gap-3 sm:grid-cols-2">
          <a
            class="flex w-full items-center justify-center whitespace-nowrap rounded-pill bg-navy hero-cta-btn px-6 py-3 font-display font-bold text-white transition hover:bg-[#0b527b]"
            href="#contacts"
          >
            Замовити діагностику
          </a>

          <a
            class="flex w-full items-center justify-center whitespace-nowrap rounded-pill border-2 border-navy hero-cta-btn px-6 py-3 font-display font-bold text-navy transition hover:bg-white"
            href="/services"
          >
            Деталі про послуги
          </a>
        </div>
      </div>
      </div>

      <div class="hero-photo-fade pointer-events-none absolute inset-y-0 right-0 z-0 w-[92%] overflow-hidden" role="img" aria-label="Пошкоджений верстат відновлюється до справного стану">
        <span class="hero-blueprint-grid" aria-hidden="true"></span>

        <img
          class="machine-broken absolute inset-0 h-full w-full object-cover object-[60%_center] md:object-cover md:object-[50%_100%] 2xl:object-[50%_85%]"
          src="/images/lathe-broken.png"
          alt="" aria-hidden="true"
        >

        <img
          class="machine-restored absolute inset-0 h-full w-full object-cover object-[60%_center] md:object-cover md:object-[50%_100%] 2xl:object-[50%_85%]"
          src="/images/lathe-restored.png"
          alt="" aria-hidden="true"
        >

        <span
          class="restored-glow"
          aria-hidden="true"
        ></span>

        <span
          class="scan-beam"
          aria-hidden="true"
        ></span>
      </div>
    </section>

    <div class="hero-benefits-band w-full px-6 pb-10 md:mt-10 lg:px-8 lg:pb-14 2xl:mx-auto 2xl:max-w-[1500px]">
      <div class="hero-benefits">
        <div class="hero-benefit-item"><img src="/images/icons/icon-experience.svg" alt="" aria-hidden="true"><p>Усі типи обладнання</p></div>
        <span class="hero-benefit-sep" aria-hidden="true"></span>
        <div class="hero-benefit-item"><img src="/images/icons/icon-ukraine.svg" alt="" aria-hidden="true"><p>Працюємо по всій Україні</p></div>
        <span class="hero-benefit-sep" aria-hidden="true"></span>
        <div class="hero-benefit-item"><img src="/images/icons/icon-specialists.svg" alt="" aria-hidden="true"><p>Кваліфіковані спеціалісти</p></div>
        <span class="hero-benefit-sep" aria-hidden="true"></span>
        <div class="hero-benefit-item"><img src="/images/icons/icon-fast-response.svg" alt="" aria-hidden="true"><p>Швидко реагуємо</p></div>
        <span class="hero-benefit-sep" aria-hidden="true"></span>
        <div class="hero-benefit-item"><img src="/images/icons/icon-individual.svg" alt="" aria-hidden="true"><p>Індивідуальний підхід</p></div>
      </div>
    </div>

    <script>
      (function () {
        var el = document.querySelector('[data-hero-slogan]');
        if (!el) { return; }
        var h1 = el.closest('h1') || el.parentElement;
        var slogans = [
          'Ремонт та обслуговування<br>металоріжучих верстатів',
          'Ремонт та обслуговування<br>пресового обладнання',
          'Відновлення будь-яких<br>типів обладнання',
          'Робота з технікою<br>незалежно від року випуску',
          'Роботи будь-якого типу<br>та рівня складності',
          'Проведення капітального<br>ремонту обладнання',
          'Модернізація застарілих<br>вузлів або систем',
          'Виїзд спеціалістів<br>по всій Україні'
        ];

        // Резервуємо висоту під найдовший слоган, щоб не було стрибків розмітки.
        function lockHeight() {
          var original = el.innerHTML;
          var max = 0;
          slogans.forEach(function (s) {
            el.innerHTML = s;
            if (el.offsetHeight > max) { max = el.offsetHeight; }
          });
          el.innerHTML = original;
          h1.style.minHeight = max ? max + 'px' : '';
        }
        lockHeight();
        window.addEventListener('load', lockHeight);
        var rt;
        window.addEventListener('resize', function () {
          clearTimeout(rt);
          rt = setTimeout(function () { h1.style.minHeight = ''; lockHeight(); }, 200);
        });

        // Послідовна (стагерна) поява пунктів переваг
        var band = document.querySelector('.hero-benefits-band');
        if (band) {
          window.requestAnimationFrame(function () {
            window.requestAnimationFrame(function () { band.classList.add('is-in'); });
          });
          setTimeout(function () { band.classList.add('is-in'); }, 300);
        }

        var reduce = window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) { return; }

        var i = 0;
        function next() {
          el.classList.add('is-out');
          setTimeout(function () {
            i = (i + 1) % slogans.length;
            el.innerHTML = slogans[i];
            el.classList.add('is-pre');
            el.classList.remove('is-out');
            void el.offsetWidth;
            el.classList.remove('is-pre');
          }, 500);
        }
        setInterval(next, 4200);
      })();
    </script>

    <section
      id="services"
      class="mx-auto max-w-shell px-6 py-10 lg:px-8 lg:py-14 xl:px-16 2xl:px-24"
    >
      <!-- Заголовок розділу -->
      <h1 class="mb-8 font-display text-h1 font-normal text-navy">Наші послуги</h1>

      <!-- Головна послуга -->
      <a
        href="/services#restoration"
        class="services-primary-card project-card group relative block overflow-hidden rounded-card bg-white p-5 transition md:grid md:grid-cols-[300px_1fr] md:items-center md:gap-8"
      >
        <span class="absolute left-5 top-5 z-20 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-navy text-base font-bold leading-none text-white">1</span>

        <img class="relative z-10 mx-auto block h-20 w-auto object-contain md:h-auto md:w-48" src="/images/icons/illustration-restoration.svg" alt="">

        <div class="relative z-10">
          <h2 class="font-display text-h2 font-normal text-navy">Відновлення обладнання</h2>

          <p class="mt-3 max-w-[62rem] text-left font-display text-h4 text-navy">Комплексно відновлюємо металорізальне та пресове обладнання незалежно від його типу, виробника та року випуску — від діагностики й усунення несправностей до капітального ремонту та модернізації.</p>

