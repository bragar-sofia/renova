        <div
          class="service-image relative -mr-6 hidden h-64 overflow-hidden md:block md:h-80 lg:-mr-8 lg:h-[26rem] xl:-mr-16 2xl:-mr-24 2xl:h-[32.375rem]">
          <img class="fade-left absolute inset-0 h-full w-full object-cover" src="/images/equipment-supply.png"
