<%
var repairTypes = [
  {
    title: 'Діагностика обладнання',
    text: 'Комплексна перевірка обладнання, визначення причин несправності та оцінка поточного стану'
  },
  {
    title: 'Поточний та аварійний ремонт',
    text: 'Оперативне усунення несправностей, заміна вузлів, що вийшли з ладу і повернення обладнання до роботи.'
  },
  {
    title: 'Капітальний ремонт',
    text: 'Повне розбирання, виявлення дефектів, відновлення основних вузлів, складання, налаштування та випробування обладнання.'
  },
  {
    title: 'Відновлення точності',
    text: 'Шліфування базових поверхонь, відновлення напрямних, регулювання геометрії та перевірка відповідності нормам згідно ДСТУ або паспорта заводу-виробника на даний тип обладнання.'
  },
  {
    title: 'Відновлення вузлів і систем',
    text: 'Ремонтуємо та замінюємо зношені механічні вузли — від шпинделя до напрямних і механізмів подач, а також відновлюємо гідравліку, пневматику, електрообладнання та системи змащування й охолодження.'
  },
  {
    title: 'Модернізація обладнання',
    text: 'Модернізація обладнання шляхом заміни систем ЧПК, приводів, електроніки та інших морально або фізично застарілих компонентів на сучасні рішення.'
  }
];

var overhaulScope = [
  'комплексну діагностику, розбирання та дефектацію верстата;',
  'підготовку технічного завдання;',
  'відновлення або заміну механічних вузлів;',
  'шліфування базових поверхонь і відновлення напрямних;',
  'ремонт гідравлічних і пневматичних систем;',
  'ремонт систем охолодження та змащування;',
  'відновлення або заміну електрообладнання;',
  'заміну системи ЧПК, приводів та електроніки;',
  'складання та фарбування;',
  'перевірку геометрії та точності;',
  'випробування обладнання під навантаженням;',
  'гарантійне та післягарантійне обслуговування (за додатковим договором).'
];

var repairSteps = [
  {icon: 'icon-stage-request.svg', height: 'h-10', text: 'Прийом заявки та первинна консультація'},
  {icon: 'icon-stage-site-visit.svg', height: 'h-10', text: 'Виїзд на підприємство і діагностика обладнання'},
  {icon: 'icon-stage-worklist.svg', height: 'h-10', text: 'Формування переліку необхідних робіт'},
  {icon: 'icon-stage-quote.svg', height: 'h-10', text: 'Формуємо комерційну пропозицію, терміни і вартість'},
  {icon: 'icon-stage-repair-works.svg', height: 'h-10', text: 'Проведення ремонтних робіт'},
  {icon: 'icon-svc-inspection.svg', height: 'h-10', text: 'Перевірка та випробування обладнання'},
  {icon: 'icon-stage-handover.svg', height: 'h-10', text: 'Передача обладнання замовнику'},
  {icon: 'icon-stage-commissioning.svg', height: 'h-12', captionMt: 'mt-2', text: 'Монтажні та пусконалагоджувальні роботи на території Замовника'}
];

var serviceSteps = [
  {icon: 'icon-svc-inspection.svg', height: 'h-10', text: 'Первинне технічне обстеження та діагностика'},
  {icon: 'icon-svc-schedule.svg', height: 'h-10', text: 'Розробка графіка планово-попереджувальних робіт'},
  {icon: 'icon-svc-maintenance.svg', height: 'h-10', text: 'Регламентне технічне обслуговування'},
  {icon: 'icon-svc-report.svg', height: 'h-10', text: 'Формування звіту та надання рекомендацій'}
];

var supplySteps = [
  {icon: 'icon-supply-analysis.svg', height: 'h-10', text: 'Аналіз виробничих потреб'},
  {icon: 'icon-supply-selection.svg', height: 'h-10', text: 'Підбір оптимального обладнання'},
  {icon: 'icon-supply-quote.svg', height: 'h-10', text: 'Формування комерційної пропозиції'},
  {icon: 'icon-supply-site-prep.svg', height: 'h-10', text: 'Підготовка виробничого майданчика'},
  {icon: 'icon-supply-installation.svg', height: 'h-10', text: 'Монтаж та введення в експлуатацію'},
  {icon: 'icon-supply-training.svg', height: 'h-10', text: 'Навчання експлуатації обладнання'},
  {icon: 'icon-supply-support.svg', height: 'h-10', text: 'Сервісне обслуговування та підтримка'}
];

var supplyCatalog = [
  'Токарні верстати (також з ЧПК)',
  'Фрезерні верстати (також з ЧПК)',
  'Шліфувальні верстати (також з ЧПК)',
  'Вертикальні, горизонтальні та п’ятиосьові обробні центри',
  'Електроерозійні верстати',
  'Гідравлічні та механічні преси',
  'Обладнання для обробки листового металу',
  'Інше обладнання відповідно до завдань виробництва'
];

var serviceNav = [
  { id: 'restoration', title: 'Відновлення обладнання', subs: [
    { id: 'restoration-types', title: 'Типи ремонту' },
    { id: 'restoration-stages', title: 'Етапи ремонту' },
    { id: 'restoration-capital', title: 'Капітальний ремонт' },
    { id: 'restoration-cost', title: 'Вартість і терміни' }
  ] },
  { id: 'service', title: 'Сервісне обслуговування', subs: [
    { id: 'service-prevent', title: 'Попередження несправностей' },
    { id: 'service-stages', title: 'Етапи обслуговування' }
  ] },
  { id: 'supply', title: 'Постачання обладнання', subs: [
    { id: 'supply-catalog', title: 'Спектр обладнання' },
    { id: 'supply-stages', title: 'Етапи постачання' }
  ] }
];
%>

<div class="min-h-screen bg-sky font-sans text-navy antialiased">
  <main id="services">
    <nav class="svc-nav" aria-label="Розділи послуг">
      <% serviceNav.forEach(function (sec) { %>
        <a class="svc-nav-item svc-nav-section" href="#<%= sec.id %>" data-target="<%= sec.id %>">
          <span class="svc-dash"></span>
          <span class="svc-label"><%= sec.title %></span>
        </a>
        <% sec.subs.forEach(function (sub) { %>
          <a class="svc-nav-item svc-nav-sub" href="#<%= sub.id %>" data-target="<%= sub.id %>">
            <span class="svc-dash"></span>
            <span class="svc-label"><%= sub.title %></span>
          </a>
        <% }); %>
      <% }); %>
    </nav>

    <% /* ===================== Restoration ===================== */ %>
    <section id="restoration" class="service-section scroll-mt-24 space-y-8 pb-10 pt-4 lg:space-y-10 lg:pb-5 lg:pt-8">

      <div
        class="service-sticky-heading sticky top-[5.125rem] z-30 flex items-center gap-3 px-6 py-3 md:hidden">
        <span class="service-number h-10 w-10 font-display text-h2 font-normal leading-none">1</span>
        <span class="font-display text-h1 font-normal text-navy">Відновлення обладнання</span>
      </div>

      <% /* ---------- Equipment restoration ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 md:grid-cols-[1.2fr_0.8fr]">
        <div>
          <span
            class="service-number mb-4 hidden h-14 w-14 font-display text-h2 font-normal leading-none md:flex">1</span>
          <h2 class="hidden font-display text-h1 font-normal text-navy md:block">Відновлення обладнання</h2>
          <p class="mt-4 lg:mt-6 text-left text-base leading-7 text-navy">
            ТОВ «RENOVA» спеціалізується на проведенні робіт з&nbsp;ремонту та модернізації металорізального
            і&nbsp;пресового обладнання незалежно від його типу, виробника та року випуску.
          </p>
          <p class="mt-4 text-left text-base leading-7 text-navy">
            Ми пропонуємо наступні послуги:
          </p>
          <ul class="check-list mt-3 text-base text-navy">
            <li>Частковий ремонт обладнання (поточний ремонт);</li>
            <li>Капітальний ремонт обладнання;</li>
            <li>Модернізацію обладнання згідно наданого Замовником технічного завдання;</li>
            <li>Складання графіка планово-попереджувальних ремонтів (ППР) обладнання вашого підприємства з&nbsp;подальшим його супроводом (сервісне обслуговування).</li>
          </ul>
          <p class="mt-4 text-left text-base leading-7 text-navy">
            Перед початком робіт наші спеціалісти проводять діагностику, визначають причини несправності, оцінюють
            загальний технічний стан обладнання та його основних вузлів. На основі отриманих результатів ми пропонуємо
            технічно й&nbsp;економічно обґрунтований варіант відновлення з&nbsp;урахуванням технічного завдання
            та побажань замовника.
          </p>
          <a href="/#contacts"
             class="mt-7 mb-8 inline-flex items-center justify-center gap-2 rounded-pill bg-navy px-6 py-3 text-left text-base font-display font-bold text-white transition hover:bg-[#0b527b] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-steel focus-visible:ring-offset-2">Замовити
            відновлення          </a>
        </div>
        <div
          class="service-image relative -mr-6 hidden h-64 overflow-hidden md:block md:h-80 lg:-mr-8 lg:h-[26rem] xl:-mr-16 2xl:-mr-24 2xl:h-[32.25rem]">
          <img class="fade-left absolute inset-0 h-full w-full object-cover" src="/images/restoration-hero.png"
               alt="Ремонт токарного верстата у майстерні RENOVA" fetchpriority="high" decoding="async">
        </div>
      </section>

      <% /* ---------- Repair types ---------- */ %>
      <section class="mx-auto max-w-shell px-6 lg:px-8 xl:px-16 2xl:px-24">
        <h2 id="restoration-types" class="scroll-mt-28 font-display text-h2 font-normal text-navy">Типи ремонту</h2>
        <div data-stagger class="mt-4 lg:mt-6 grid gap-6 [grid-auto-rows:1fr] sm:grid-cols-2 lg:grid-cols-3">
          <% repairTypes.forEach(function (card) { %>
            <article class="flex h-full flex-col rounded-card bg-white p-6 shadow-[0_16px_42px_rgba(7,49,78,0.07)]">
              <h3 class="svc-repair-title font-display text-h3 font-normal text-navy"><%= card.title %></h3>
              <p class="mt-2 flex-grow text-left text-base text-navy"><%= card.text %></p>
            </article>
          <% }); %>
        </div>
      </section>

      <% /* ---------- Repair stages ---------- */ %>
      <section class="mx-auto max-w-shell px-6 lg:px-8 xl:px-16 2xl:px-24">
        <h2 id="restoration-stages" class="scroll-mt-28 font-display text-h2 font-normal text-navy">Етапи ремонту</h2>
        <div class="mt-4 lg:mt-6">
          <%- include('../partials/process-steps', { steps: repairSteps, captionLines: 3 }) %>
        </div>
      </section>

      <% /* ---------- Major overhaul ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-start gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 lg:grid-cols-[0.4fr_0.6fr]">
        <div>
          <h2 id="restoration-capital" class="scroll-mt-28 font-display text-h2 font-normal text-navy">Капітальний ремонт</h2>
          <p class="mt-4 lg:mt-6 text-left text-base leading-7 text-navy">
            Капітальний ремонт проводиться у&nbsp;разі значного зношення вузлів обладнання, втрати точності, системних
            несправностей або необхідності комплексного оновлення верстата.
          </p>
          <div class="service-card mt-6 rounded-card bg-white p-6 md:p-8">
            <h3 class="font-display text-h3 font-normal text-navy">Що включає капітальний ремонт</h3>
            <ul class="check-list relative z-10 mt-3 lg:mt-5 text-base text-navy">
              <% overhaulScope.forEach(function (item) { %>
                <li><%= item %></li>
              <% }); %>
            </ul>
          </div>
        </div>
        <div
          class="service-image relative -mr-6 hidden h-72 overflow-hidden md:block md:h-96 lg:-mr-8 lg:h-full lg:min-h-[36.4375rem] xl:-mr-16 2xl:-mr-24">
          <img class="fade-left absolute inset-0 h-full w-full object-cover" src="/images/capital-repair.png"
               alt="Розбирання коробки передач під час капітального ремонту" loading="lazy" decoding="async">
        </div>
      </section>

      <% /* ---------- Cost and timeline ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 lg:grid-cols-[auto_1fr] lg:gap-14">
        <div class="mx-auto h-56 w-auto max-w-full aspect-[366/300] lg:mx-0 lg:h-52" data-lottie="/images/lottie/cost-terms.json" aria-hidden="true"></div>
        <div>
          <h2 id="restoration-cost" class="scroll-mt-28 font-display text-h2 font-normal text-navy">Вартість і терміни</h2>
          <p class="mt-4 lg:mt-6 text-left text-base leading-7 text-navy">
            Вартість і&nbsp;термін виконання ремонтних робіт визначається індивідуально після проведення діагностики
            обладнання, та залежить від його технічного стану, складності та обсягу необхідних робіт, потреб у&nbsp;відновленні
            або заміні вузлів, а&nbsp;також вимог описаних у&nbsp;технічному завданні замовника.
          </p>
          <p class="mt-4 text-left text-base leading-7 text-navy">
            За результатами діагностики ми пропонуємо оптимальний варіант ремонту та формуємо комерційну пропозицію із
            переліком робіт, строками виконання робіт, та&nbsp;їх вартістю.
          </p>
        </div>
      </section>

    </section>

    <% /* ===================== Service ===================== */ %>
    <section id="service" class="service-section scroll-mt-24 space-y-8 py-10 lg:space-y-10 lg:pt-5 lg:pb-5">

      <div
        class="service-sticky-heading sticky top-[5.125rem] z-30 flex items-center gap-3 px-6 py-3 md:hidden">
        <span class="service-number h-10 w-10 font-display text-h2 font-normal leading-none">2</span>
        <span class="font-display text-h1 font-normal text-navy">Сервісне обслуговування</span>
      </div>

      <% /* ---------- Maintenance ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 md:grid-cols-[0.8fr_1.2fr]">
        <div
          class="service-image relative -ml-6 hidden h-64 overflow-hidden md:block md:h-80 lg:-ml-8 lg:h-[26rem] xl:-ml-16 2xl:-ml-24 2xl:h-[32rem]">
          <img class="fade-right absolute inset-0 h-full w-full object-cover" src="/images/service-maintenance.png"
               alt="Профілактичне обслуговування токарного верстата" loading="lazy" decoding="async">
        </div>
        <div>
          <span
            class="service-number mb-4 hidden h-14 w-14 font-display text-h2 font-normal leading-none md:flex">2</span>
          <h2 class="hidden font-display text-h1 font-normal text-navy md:block">Сервісне обслуговування</h2>
          <p class="mt-4 lg:mt-6 text-left text-base leading-7 text-navy">
            Найкращий ремонт – це той, якого вдалося уникнути. Тому RENOVA допомагає підтримувати металорізальне та
            пресове обладнання у&nbsp;стабільному робочому стані протягом усього періоду експлуатації. Ми проводимо
            планове технічне обслуговування, діагностику та профілактичні роботи, щоб своєчасно виявляти зношення,
            усувати несправності на ранніх етапах і&nbsp;знижувати ризик аварійних зупинок.
          </p>
          <p class="mt-4 text-left text-base leading-7 text-navy">
            Для кожного підприємства ми розробляємо індивідуальний графік обслуговування з&nbsp;урахуванням типу
            обладнання, його поточного стану, навантаження та графіку роботи підприємства.
          </p>
          <a href="/#contacts"
             class="mt-7 mb-8 inline-flex max-[430px]:w-min items-center justify-center gap-2 rounded-pill bg-navy px-6 py-3 text-left text-base font-display font-bold text-white transition hover:bg-[#0b527b] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-steel focus-visible:ring-offset-2">Замовити&nbsp;сервісне обслуговування</a>
        </div>
      </section>

      <% /* ---------- Prevent failure ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 lg:grid-cols-[1fr_auto] lg:gap-14">
        <div>
          <h2 id="service-prevent" class="scroll-mt-28 font-display text-h2 font-normal text-navy">Попередити несправність завжди краще ніж усувати&nbsp;її</h2>
          <p class="mt-4 lg:mt-6 text-left text-base leading-7 text-navy">
            Аварійна поломка часто виникає в&nbsp;найбільш невідповідний момент і&nbsp;призводить не лише до витрат на
            ремонт, а&nbsp;й до простою обладнання та пов’язаних із ним виробничих процесів.
          </p>
          <p class="mt-4 text-left text-base leading-7 text-navy">
            Завдання планового сервісного обслуговування – контролювати технічний стан верстата, своєчасно виявляти
            дефекти та виконувати необхідні роботи по їх усуненню до виникнення серйозної поломки. RENOVA може взяти на
            себе функції технічного супроводу верстатного парку або доповнити роботу власної служби з&nbsp;обслуговування
            на вашому підприємстві.
          </p>
        </div>
        <div class="mx-auto h-44 w-auto max-w-full aspect-[374/282] lg:mx-0 lg:h-52" data-lottie="/images/lottie/prevention.json" aria-hidden="true"></div>
      </section>

      <% /* ---------- Maintenance stages ---------- */ %>
      <section class="mx-auto max-w-shell px-6 lg:px-8 xl:px-16 2xl:px-24">
        <h2 id="service-stages" class="scroll-mt-28 font-display text-h2 font-normal text-navy">Етапи проведення сервісного обслуговування</h2>
        <div class="mt-4 lg:mt-6">
          <%- include('../partials/process-steps', { steps: serviceSteps, fullWidth: true }) %>
        </div>
      </section>

    </section>

    <% /* ===================== Supply ===================== */ %>
    <section id="supply" class="service-section scroll-mt-24 space-y-8 py-10 lg:space-y-10 lg:pt-5 lg:pb-14">

      <div
        class="service-sticky-heading sticky top-[5.125rem] z-30 flex items-center gap-3 px-6 py-3 md:hidden">
        <span class="service-number h-10 w-10 font-display text-h2 font-normal leading-none">3</span>
        <span class="font-display text-h1 font-normal text-navy">Постачання нового обладнання</span>
      </div>

      <% /* ---------- New equipment supply ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 md:grid-cols-[1.2fr_0.8fr]">
        <div>
          <span
            class="service-number mb-4 hidden h-14 w-14 font-display text-h2 font-normal leading-none md:flex">3</span>
          <h2 class="hidden font-display text-h1 font-normal text-navy md:block">Постачання нового обладнання</h2>
          <p class="mt-4 lg:mt-6 text-left text-base leading-7 text-navy">
            Якщо ремонт обладнання технічно неможливий або економічно недоцільний, RENOVA допоможе підібрати нове
