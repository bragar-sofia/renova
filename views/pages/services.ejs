  { icon: 'icon-commissioning-geometry.svg', scale: 1.1, text: 'Перевірка геометричної точності та жорсткості' },
  { icon: 'icon-commissioning-idle-run.svg', scale: 1.4, text: 'Опробування на холостому ходу' },
  { icon: 'icon-commissioning-load-test.svg', scale: 1.1, text: 'Випробування під навантаженням і виготовлення тестової деталі' },
  { icon: 'icon-commissioning-handover.svg', text: 'Здавання обладнання із підписанням Акта введення в експлуатацію' }
];

var auditFindings = [
  { basis: '24.3rem', text: 'Причини невідповідностей обладнання заявленим характеристикам' },
  { basis: '14.8rem', text: 'Причини наявних несправностей' },
  { basis: '25.1rem', text: 'Ступінь зносу вузлів і залишковий ресурс основних агрегатів' },
  { basis: '16.3rem', text: 'Необхідний обсяг відновлювальних робіт' },
  { basis: '19.3rem', text: 'Відповідність технологічної точності паспортним нормам' }
];

var presaleParts = [
  { basis: '58.06rem', text: 'Діагностика та комплексна перевірка механічної частини, шпиндельного вузла, приводів подач, напрямних та систем змащення, електрообладнання, датчиків зворотного зв’язку, блоків живлення та системи ЧПК, гідравлічних та пневматичних систем та контурів охолодження на герметичність і тиск' },
  { basis: '23.56rem', text: 'Усунення виявлених дефектів, заміна зношених швидкозношуваних деталей, ущільнень, ременів та фільтрів' },
  { basis: '19.56rem', text: 'Промивання змащувальних та гідравлічних каналів, заміна робочих рідин і мастил' },
  { basis: '26.56rem', text: 'Регулювання зазорів у клинах, напрямних, підшипниках та вузлах КВГ (усунення люфтів)' },
  { basis: '40.88rem', text: 'Розконсервація, регулювання точності та перевірка функціонування вузлів на холостому ходу (обкатка шпинделя, тестування зміни інструменту)' },
  { basis: '33.81rem', text: 'Виконання тестового оброблення деталі під навантаженням для контролю точності та шорсткості поверхні' },
  { basis: '100%', text: 'Загальна підготовка та комплектація: очищення або відновлення лакофарбового покриття, заміна пошкоджених захисних щитків та огороджень; перевірка наявності та відновлення експлуатаційної технічної документації (паспорт, інструкція з експлуатації, схеми тощо); комплектація штатною оснасткою, ключами та затискними елементами' }
];

var supplyCatalog = [
  'Токарні верстати (зокрема з ЧПК)',
  'Фрезерні верстати (зокрема з ЧПК)',
  'Шліфувальні верстати (зокрема з ЧПК)',
  'Вертикальні, горизонтальні та п’ятиосьові обробні центри',
  'Електроерозійні верстати',
  'Гідравлічні та механічні преси',
  'Обладнання для обробки листового металу',
  'Інше обладнання відповідно до завдань виробництва'
];

var supplyBrands = [
  { file: 'yinfeng.png', name: 'Yinfeng Machine' },
  { file: 'colchester.png', name: 'Colchester Machine Tool Solutions' },
  { file: 'durendus.png', name: 'Durendus' },
  { file: 'truemach.png', name: 'Truemach' },
  { file: 'tma.png', name: 'TMA' },
  { file: 'prompt.png', name: 'Prompt' },
  { file: 'alex-tech.png', name: 'Alex-Tech Machinery' },
  { file: 'aegis.png', name: 'Aegis — First Chant Enterprise' },
  { file: 'huvema.png', name: 'Huvema' },
  { file: 'andritz.png', name: 'Andritz' },
  { file: 'hidrogarne.png', name: 'Hidrogarne' },
  { file: 'euromac.png', name: 'Euromac' }
];

var supplySteps = [
  { icon: 'icon-supply-analysis.svg', text: 'Аналіз технічних вимог та завдання' },
  { icon: 'icon-supply-selection.svg', text: 'Підбір оптимального обладнання' },
  { icon: 'icon-supply-quote.svg', text: 'Формування комерційної пропозиції' },
  { icon: 'icon-stage-site-visit.svg', text: 'Доставка обладнання на об’єкт' },
  { icon: 'icon-supply-installation.svg', text: 'Монтаж, пусконалагоджувальні роботи, приймально-здавальні випробування та введення в експлуатацію' },
  { icon: 'icon-supply-training.svg', text: 'Базовий інструктаж щодо правил безпечної експлуатації обладнання для персоналу' },
  { icon: 'icon-supply-support.svg', text: 'Сервісне обслуговування та подальша підтримка (гарантійний і післягарантійний супровід)' }
];

var consultingAreas = [
  'Підбір виробничого обладнання — визначення оптимального рішення відповідно до завдань і технічних вимог виробництва',
  'Раціональна експлуатація — організація використання обладнання з дотриманням заданої точності обробки та подовженням його ресурсу',
  'Технічне обслуговування і ремонт — вибір моделі обслуговування з урахуванням типу, стану та інтенсивності експлуатації обладнання.'
];

var pricingBasis = [
  'для ремонтно-відновлювальних робіт, передпродажної підготовки та калібрування — результати технічної діагностики й дефектування обладнання;',
  'для технічного обслуговування — тип, кількість і технічний стан обладнання, інтенсивність експлуатації та режим роботи підприємства, на основі яких формується графік ППР із прогнозованим річним бюджетом;',
  'для пусконалагоджувальних робіт, інжинірингових послуг і постачання обладнання — технічне завдання Замовника та обсяг узгоджених робіт.'
];

var serviceNav = serviceSections.map(function (section) {
  return { id: section.id, title: section.title };
}).concat([{ id: 'pricing', title: 'Вартість і терміни' }]);
var svc = {};
serviceSections.forEach(function (section) { svc[section.id] = section; });
%>

<div class="services-page">
  <main id="services">
    <nav class="svc-nav" data-services-nav aria-label="Розділи послуг">
      <% serviceNav.forEach(function (item) { %>
        <a class="svc-nav-item svc-nav-section" href="#<%= item.id %>" data-services-nav-item data-target="<%= item.id %>">
          <span class="svc-dash" data-services-nav-dash></span>
          <span class="svc-label"><%= item.title %></span>
        </a>
      <% }); %>
    </nav>

    <section id="restoration" class="service-section scroll-mt-24">
      <%- include('../partials/service-intro', { section: svc.restoration }) %>

      <div class="site-container svc-subblock">
        <h3 class="heading-2 svc-subblock-title">Види ремонтних робіт:</h3>

        <div data-stagger class="svc-repair-grid">
          <% repairTypes.forEach(function (card, i) { %>
            <article class="card card-elevated interactive-card svc-repair-card" data-repair-card>
              <span class="card-border" aria-hidden="true"></span>
              <h4 class="svc-repair-title heading-3"><%= card.title %></h4>

              <div class="svc-repair-foot">
                <img class="svc-repair-icon" src="/images/icons/<%= card.icon %>" alt="" aria-hidden="true">

                <button type="button" class="action-link svc-repair-more" data-repair-open="<%= i %>">
                  Детальніше
                  <img src="/images/icons/icon-chevron-inactive.svg" alt="">
                </button>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <section id="calibration" class="service-section scroll-mt-24">
      <%- include('../partials/service-intro', { section: svc.calibration }) %>

      <div class="site-container svc-subblock">
        <h3 class="heading-2 svc-subblock-title">Ключові етапи виконання робіт в умовах виробництва:</h3>

        <div data-stagger class="svc-note-grid">
          <% calibrationStages.forEach(function (stage) { %>
            <article class="card card-elevated svc-note-card">
              <h4 class="heading-3"><%= stage.title %></h4>

              <ul class="svc-note-list">
                <% stage.items.forEach(function (item) { %>
                  <li><%= item %></li>
                <% }); %>
              </ul>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <section id="commissioning" class="service-section scroll-mt-24">
      <%- include('../partials/service-intro', { section: svc.commissioning }) %>

      <div class="site-container svc-subblock">
        <h3 class="heading-2 svc-subblock-title">Етапи проведення пусконалагоджувальних робіт:</h3>
        <%- include('../partials/process-steps', { steps: commissioningSteps, captionLines: 3, fullWidth: true, connectors: false }) %>
      </div>
    </section>

    <section id="audit" class="service-section scroll-mt-24">
      <%- include('../partials/service-intro', { section: svc.audit }) %>

      <div class="site-container svc-subblock">
        <h3 class="heading-2 svc-subblock-title">За результатами обстеження визначаємо:</h3>

        <div data-stagger class="svc-plain-grid svc-plain-grid-five">
          <% auditFindings.forEach(function (item) { %>
            <article class="card card-elevated svc-plain-card" style="--card-basis: <%= item.basis %>"><%= item.text %></article>
          <% }); %>
        </div>
      </div>
    </section>

    <section id="presale" class="service-section scroll-mt-24">
      <%- include('../partials/service-intro', { section: svc.presale }) %>

      <div class="site-container svc-subblock">
        <h3 class="heading-2 svc-subblock-title">Основні складові передпродажної підготовки:</h3>

        <div data-stagger class="svc-plain-grid">
          <% presaleParts.forEach(function (item) { %>
            <article class="card card-elevated svc-plain-card" style="--card-basis: <%= item.basis %>"><%= item.text %></article>
          <% }); %>
        </div>
      </div>
    </section>

    <section id="supply" class="service-section scroll-mt-24">
      <%- include('../partials/service-intro', { section: svc.supply }) %>

      <div class="site-container supply-catalog">
        <article class="card card-elevated svc-catalog-card">
          <h3 class="heading-3">Постачаємо широкий спектр обладнання</h3>

          <ul class="svc-catalog-list">
            <% supplyCatalog.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        </article>

        <div class="supply-brands-area">
          <ul class="supply-brands">
            <% supplyBrands.forEach(function (brand) { %>
              <li class="supply-brand">
                <img src="/images/brands/<%= brand.file %>" alt="<%= brand.name %>" loading="lazy" decoding="async">
              </li>
            <% }); %>
          </ul>
        </div>
      </div>

      <div class="site-container svc-subblock">
        <h3 class="heading-2 svc-subblock-title">Етапи постачання нового обладнання</h3>
        <%- include('../partials/process-steps', { steps: supplySteps, captionLines: 3, fullWidth: true, connectors: false }) %>
      </div>
    </section>

    <section id="engineering" class="service-section scroll-mt-24">
      <%- include('../partials/service-intro', { section: svc.engineering }) %>

      <div class="site-container svc-subblock">
        <h3 class="heading-2 svc-subblock-title">Напрями консультування:</h3>

        <div data-stagger class="svc-plain-grid svc-plain-grid-three">
          <% consultingAreas.forEach(function (item) { %>
            <article class="card card-elevated svc-plain-card"><%= item %></article>
          <% }); %>
        </div>
      </div>
    </section>

    <section id="pricing" class="service-section scroll-mt-24">
      <div class="site-container svc-pricing">
        <div class="svc-pricing-body">
          <h2 class="heading-1">Вартість і терміни</h2>

          <p class="body-copy svc-intro-text">Вартість, строки та склад робіт за всіма послугами компанії RENOVA визначаються індивідуально й узгоджуються з Замовником до початку виконання. За результатами оцінки Замовник отримує комерційну пропозицію з деталізованим переліком робіт, вартістю та термінами виконання. Прозорість розрахунку дає змогу планувати бюджет на утримання обладнання заздалегідь і уникати непередбачених витрат.</p>
        </div>

        <article class="card card-elevated svc-note-card">
          <h3 class="heading-3">Основою для розрахунку є:</h3>

          <ul class="svc-note-list">
            <% pricingBasis.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        </article>
      </div>
    </section>
    <div class="svc-modal" data-repair-modal hidden>
      <div class="svc-modal-backdrop" data-repair-close></div>

      <div class="svc-modal-panel card" role="dialog" aria-modal="true" data-repair-dialog>
        <button type="button" class="svc-modal-close" data-repair-close aria-label="Закрити">
          <img src="/images/icons/icon-modal-close.svg" alt="" aria-hidden="true">
        </button>

        <% repairTypes.forEach(function (card, i) { %>
          <article class="svc-modal-content" data-repair-panel="<%= i %>" hidden>
            <h2 class="heading-2 svc-modal-title" id="svc-modal-title-<%= i %>"><%= card.title %></h2>

            <div class="svc-modal-intro">
              <% card.intro.forEach(function (paragraph) { %>
                <p class="body-copy"><%= paragraph %></p>
              <% }); %>
            </div>

            <% if (card.list) { %>
              <div class="svc-modal-block">
                <h3 class="heading-3"><%= card.listTitle %></h3>

                <ul class="svc-note-list">
                  <% card.list.forEach(function (item) { %>
                    <li><%= item %></li>
                  <% }); %>
                </ul>
              </div>
            <% } %>

            <div class="svc-modal-block">
              <h3 class="heading-3"><%= card.stepsTitle %></h3>

              <% card.stepGroups.forEach(function (group) { %>
                <div class="svc-modal-steps">
                  <% if (group.label) { %>
                    <p class="svc-modal-steps-label"><%= group.label %></p>
                  <% } %>

                  <%- include('../partials/process-steps', { steps: group.steps, connectors: false, fullWidth: true, captionLines: 3, stagger: false }) %>
                </div>
              <% }); %>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </main>
</div>

<script src="/js/pages/services.js" defer></script>
