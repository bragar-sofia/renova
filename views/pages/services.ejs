<%
var repairTypes = [
  { title: 'Технічний аудит і діагностика', text: 'Комплексна оцінка технічного стану обладнання, діагностика вузлів і систем, визначення причин несправностей, ступеня зносу та необхідного обсягу відновлювальних робіт.' },
  { title: 'Аварійний ремонт', text: 'Оперативна діагностика та усунення несправностей, відновлення або заміна вузлів і компонентів, що вийшли з ладу, для максимально швидкого повернення обладнання до роботи.' },
  { title: 'Капітальний ремонт', text: 'Комплексне відновлення обладнання, що включає ремонт або заміну зношених вузлів для відновлення його технічних характеристик до рівня, близького до заводського.' },
  { title: 'Модернізація обладнання', text: 'Оновлення обладнання шляхом заміни систем ЧПК, приводів, електроніки та інших морально або фізично застарілих компонентів на сучасні рішення.' }
];

var overhaulScope = [
  'технічне обстеження, розбирання та дефектацію вузлів;',
  'ремонт або заміну зношених механічних вузлів;',
  'шліфування базових поверхонь і відновлення напрямних;',
  'ремонт гідравлічних і пневматичних систем;',
  'відновлення систем охолодження та змащування;',
  'ремонт або заміну електрообладнання;',
  'заміну системи ЧПК, приводів та електроніки;',
  'складання та фарбування обладнання;',
  'перевірку геометрії та точності;',
  'випробування обладнання під навантаженням.'
];

var repairSteps = [
  {icon: 'icon-stage-request.svg', height: 'h-10', text: 'Прийом заявки та первинна консультація'},
  {icon: 'icon-stage-site-visit.svg', height: 'h-10', text: 'Виїзд на підприємство і діагностика обладнання'},
  {icon: 'icon-stage-worklist.svg', height: 'h-10', text: 'Формування переліку необхідних робіт'},
  {icon: 'icon-stage-quote.svg', height: 'h-10', text: 'Формування комерційної пропозиції, термінів і вартості'},
  {icon: 'icon-stage-repair-works.svg', height: 'h-10', text: 'Проведення ремонтних робіт'},
  {icon: 'icon-svc-inspection.svg', height: 'h-10', text: 'Перевірка та випробування обладнання'},
  {icon: 'icon-stage-handover.svg', height: 'h-10', text: 'Передача обладнання замовнику'},
  {icon: 'icon-stage-commissioning.svg', height: 'h-12', captionMt: 'mt-2', text: 'Монтажні та пусконалагоджувальні роботи на території замовника'}
];

var serviceSteps = [
  {icon: 'icon-svc-inspection.svg', height: 'h-10', text: 'Технічне обстеження та діагностика обладнання'},
  {icon: 'icon-svc-schedule.svg', height: 'h-10', text: 'Формування індивідуального графіка планово-попереджувальних робіт'},
  {icon: 'icon-svc-maintenance.svg', height: 'h-10', text: 'Проведення регламентного технічного обслуговування та поточного ремонту'},
  {icon: 'icon-svc-report.svg', height: 'h-10', text: 'Контроль технічного стану, формування звіту та рекомендацій'}
];

var supplySteps = [
  {icon: 'icon-supply-analysis.svg', height: 'h-10', text: 'Аналіз технічного завдання замовника'},
  {icon: 'icon-supply-selection.svg', height: 'h-10', text: 'Підбір оптимального обладнання'},
  {icon: 'icon-supply-quote.svg', height: 'h-10', text: 'Формування комерційної пропозиції'},
  {icon: 'icon-stage-site-visit.svg', height: 'h-10', text: 'Транспортування на об’єкт замовника'},
  {icon: 'icon-supply-installation.svg', height: 'h-10', text: 'Монтаж та введення в експлуатацію'},
  {icon: 'icon-supply-training.svg', height: 'h-10', text: 'Навчання персоналу роботі з обладнанням'},
  {icon: 'icon-supply-support.svg', height: 'h-10', text: 'Сервісне обслуговування та подальша підтримка'}
];

var supplyCatalog = [
  'Токарні верстати (зокрема з ЧПК)',
  'Фрезерні верстати (зокрема з ЧПК)',
  'Шліфувальні верстати (зокрема з ЧПК)',
  'Вертикальні, горизонтальні та п’ятиосьові обробні центри',
  'Електроерозійні верстати',
  'Гідравлічні та механічні преси',
  'Обладнання для обробки листового металу',
  'Інше обладнання відповідно до завдань виробництва'
];

var supplyBrands = [
  { file: 'yinfeng.png', name: 'Yinfeng Machine' },
  { file: 'colchester.png', name: 'Colchester Machine Tool Solutions' },
  { file: 'durendus.png', name: 'Durendus' },
  { file: 'truemach.png', name: 'Truemach' },
  { file: 'tma.png', name: 'TMA' },
  { file: 'prompt.png', name: 'Prompt' },
  { file: 'alex-tech.png', name: 'Alex-Tech Machinery' },
  { file: 'aegis.png', name: 'Aegis — First Chant Enterprise' },
  { file: 'huvema.png', name: 'Huvema' },
  { file: 'andritz.png', name: 'Andritz' },
  { file: 'hidrogarne.png', name: 'Hidrogarne' },
  { file: 'euromac.png', name: 'Euromac' }
];

var serviceNav = [
  { id: 'restoration', title: 'Відновлення обладнання', subs: [
    { id: 'restoration-types', title: 'Види робіт' },
    { id: 'restoration-stages', title: 'Етапи проведення ремонту' },
    { id: 'restoration-capital', title: 'Капітальний ремонт' },
    { id: 'restoration-cost', title: 'Вартість і терміни' }
  ] },
  { id: 'service', title: 'Технічне обслуговування', subs: [
    { id: 'service-prevent', title: 'Попередження несправностей' },
    { id: 'service-stages', title: 'Етапи обслуговування' }
  ] },
  { id: 'supply', title: 'Постачання обладнання', subs: [
    { id: 'supply-catalog', title: 'Спектр обладнання' },
    { id: 'supply-stages', title: 'Етапи постачання' }
  ] }
];
%>

<div class="services-page">
  <main id="services">
    <nav class="svc-nav" data-services-nav aria-label="Розділи послуг">
      <% serviceNav.forEach(function (sec) { %>
        <a class="svc-nav-item svc-nav-section" href="#<%= sec.id %>" data-services-nav-item data-target="<%= sec.id %>">
          <span class="svc-dash" data-services-nav-dash></span>
          <span class="svc-label"><%= sec.title %></span>
        </a>
        <% sec.subs.forEach(function (sub) { %>
          <a class="svc-nav-item svc-nav-sub" href="#<%= sub.id %>" data-services-nav-item data-target="<%= sub.id %>">
            <span class="svc-dash" data-services-nav-dash></span>
            <span class="svc-label"><%= sub.title %></span>
          </a>
        <% }); %>
      <% }); %>
    </nav>

    <% /* ===================== Restoration ===================== */ %>
    <section id="restoration" class="service-section scroll-mt-24">
      <div
        class="service-sticky-heading service-mobile-heading">
        <span class="service-number number-badge service-number-badge">1</span>
        <span class="heading-1">Відновлення обладнання</span>
      </div>

      <% /* ---------- Equipment restoration ---------- */ %>
      <section class="site-container grid items-center gap-8 md:grid-cols-[1.2fr_0.8fr]">
        <div>
          <span class="service-number number-badge service-number-badge service-number-badge-lg service-desktop-number">1</span>
          <h2 class="heading-1 service-desktop-title">Відновлення обладнання</h2>
          <p class="body-copy service-copy-first text-left">
            Компанія RENOVA здійснює технічне обслуговування, ремонт та комплексне відновлення металообробного
            і пресового обладнання будь-яких типів, модифікацій та років випуску.
          </p>
          <p class="body-copy mt-4 text-left">
            Наші виробничо-технічні можливості дозволяють виконувати повний цикл робіт: від усунення локальних
            несправностей і відновлення окремих вузлів до капітального ремонту, комплексної модернізації
            та реінжинірингу верстатних систем.
          </p>
          <p class="body-copy mt-4 text-left">
            Відновлювальні роботи розпочинаються з попереднього технічного аудиту та дефектації обладнання.
            Наші фахівці оцінюють його загальний технічний стан, визначають причини несправностей і аналізують
            залишковий ресурс основних вузлів. За результатами діагностики складається дефектний акт та формується
            техніко-економічне обґрунтування (ТЕО) з оптимальним алгоритмом виконання робіт відповідно до вимог
            технічного завдання замовника.
          </p>
          <a href="/#contacts" class="btn btn-primary service-cta">Замовити відновлення</a>
        </div>
        <div class="service-image relative -mr-6 hidden h-64 overflow-hidden md:block md:h-80 lg:-mr-8 lg:h-[26rem] xl:-mr-16 2xl:-mr-24 2xl:h-[32.25rem]">
          <img class="fade-left absolute inset-0 h-full w-full object-cover" src="/images/restoration-hero.png" alt="Ремонт токарного верстата у майстерні RENOVA" fetchpriority="high" decoding="async">
        </div>
      </section>

      <% /* ---------- Repair types ---------- */ %>
      <section class="site-container">
        <h2 id="restoration-types" class="heading-2 scroll-mt-28">Види робіт</h2>
        <div data-stagger class="service-type-grid">
          <% repairTypes.forEach(function (card) { %>
            <article class="card card-elevated service-type-card flex flex-col">
              <h3 class="svc-repair-title heading-3"><%= card.title %></h3>
              <p class="service-card-copy"><%= card.text %></p>
            </article>
          <% }); %>
        </div>
      </section>

      <% /* ---------- Repair stages ---------- */ %>
      <section class="site-container">
        <h2 id="restoration-stages" class="heading-2 scroll-mt-28">Етапи проведення ремонтних робіт</h2>
        <div class="mt-4 lg:mt-6">
          <%- include('../partials/process-steps', { steps: repairSteps, captionLines: 3 }) %>
        </div>
      </section>

      <% /* ---------- Major overhaul ---------- */ %>
      <section class="site-container grid items-start gap-8 lg:grid-cols-[0.4fr_0.6fr]">
        <div>
          <h2 id="restoration-capital" class="heading-2 scroll-mt-28">Капітальний ремонт</h2>
          <p class="body-copy service-copy-first text-left">
            Капітальний ремонт проводиться у разі значного зношення основних вузлів, втрати геометричної точності,
            системних несправностей або коли локальний ремонт уже не дозволяє відновити необхідні
            технічні характеристики обладнання.
          </p>
          <div class="service-card card mt-6 p-6 md:p-8">
            <h3 class="heading-3">Залежно від технічного стану обладнання<br> та результатів дефектації<br> комплекс робіт може включати:</h3>
            <ul class="check-list relative z-10 mt-3 lg:mt-5 text-base text-navy">
              <% overhaulScope.forEach(function (item) { %>
                <li><%= item %></li>
              <% }); %>
            </ul>
          </div>
        </div>
        <div class="service-image relative -mr-6 hidden h-72 overflow-hidden md:block md:h-96 lg:-mr-8 lg:h-full lg:min-h-[36.4375rem] xl:-mr-16 2xl:-mr-24">
          <img class="fade-left absolute inset-0 h-full w-full object-cover" src="/images/capital-repair.png" alt="Розбирання коробки передач під час капітального ремонту" loading="lazy" decoding="async">
        </div>
      </section>

      <% /* ---------- Cost and timeline ---------- */ %>
      <section class="site-container grid items-center gap-8 lg:grid-cols-[auto_1fr] lg:gap-14">
        <div class="mx-auto h-56 w-auto max-w-full aspect-[366/300] lg:mx-0 lg:h-52" data-lottie="/images/lottie/cost-terms.json" aria-hidden="true"></div>
        <div>
          <h2 id="restoration-cost" class="heading-2 scroll-mt-28">Вартість і терміни</h2>
          <p class="body-copy service-copy-first text-left">
            Вартість і терміни виконання ремонтних робіт визначаються індивідуально за результатами технічної
            діагностики та дефектації обладнання з урахуванням вимог технічного завдання замовника.
          </p>
          <p class="body-copy mt-4 text-left">
            Після визначення фактичного технічного стану обладнання та необхідного обсягу відновлювальних робіт
            узгоджуються склад робіт, строки їх виконання та вартість.
          </p>
        </div>
      </section>
    </section>

    <% /* ===================== Service ===================== */ %>
    <section id="service" class="service-section scroll-mt-24">
      <div class="service-sticky-heading service-mobile-heading">
        <span class="service-number number-badge service-number-badge">2</span>
        <span class="heading-1">Технічне обслуговування</span>
      </div>

      <% /* ---------- Maintenance ---------- */ %>
      <section class="site-container grid items-center gap-8 md:grid-cols-[0.8fr_1.2fr]">
        <div class="service-image relative -ml-6 hidden h-64 overflow-hidden md:block md:h-80 lg:-ml-8 lg:h-[26rem] xl:-ml-16 2xl:-ml-24 2xl:h-[32rem]">
          <img class="fade-right absolute inset-0 h-full w-full object-cover" src="/images/service-maintenance.png" alt="Профілактичне обслуговування токарного верстата" loading="lazy" decoding="async">
        </div>
        <div>
          <span class="service-number number-badge service-number-badge service-number-badge-lg service-desktop-number">2</span>
          <h2 class="heading-1 service-desktop-title">Технічне обслуговування</h2>
          <p class="body-copy service-copy-first text-left">
            RENOVA здійснює планове технічне обслуговування металообробного і пресового обладнання з формуванням
            індивідуального графіка планово-попереджувальних робіт (ППР).
          </p>
          <p class="body-copy mt-4 text-left">
            Графік розробляється з урахуванням типу та кількості обладнання, його технічного стану, інтенсивності
            навантаження та режиму роботи підприємства. Регулярне виконання передбачених ним робіт дозволяє своєчасно
            виявляти зношення й несправності, проводити необхідне технічне обслуговування та поточний ремонт до
            виникнення аварійних відмов.
          </p>
          <a href="/#contacts" class="btn btn-primary service-cta max-[430px]:w-min">Замовити&nbsp;технічне обслуговування</a>
        </div>
      </section>

      <% /* ---------- Prevent failure ---------- */ %>
      <section class="site-container grid items-center gap-8 lg:grid-cols-[1fr_auto] lg:gap-14">
        <div>
          <h2 id="service-prevent" class="heading-2 scroll-mt-28">Планове обслуговування замість аварійних простоїв</h2>
          <p class="body-copy service-copy-first text-left">
            Система ППР дозволяє підтримувати обладнання у працездатному стані та планувати необхідні ремонтні й
            регламентні роботи заздалегідь. Це допомагає знизити ризик непередбачених поломок і пов’язаних із ними
            простоїв виробництва.
          </p>
          <p class="body-copy mt-4 text-left">
            Замовник отримує чіткий графік обслуговування обладнання, розуміння майбутнього обсягу робіт та
            можливість завчасно планувати витрати на його технічне утримання. RENOVA може забезпечити комплексний
            технічний супровід верстатного парку або виконувати окремі роботи на доповнення до власної ремонтної
            служби підприємства.
          </p>
        </div>
        <div class="mx-auto h-44 w-auto max-w-full aspect-[374/282] lg:mx-0 lg:h-52" data-lottie="/images/lottie/prevention.json" aria-hidden="true"></div>
      </section>

      <% /* ---------- Maintenance stages ---------- */ %>
      <section class="site-container">
        <h2 id="service-stages" class="heading-2 scroll-mt-28">Етапи проведення технічного обслуговування</h2>
        <div class="mt-4 lg:mt-6">
          <%- include('../partials/process-steps', { steps: serviceSteps, fullWidth: true }) %>
        </div>
      </section>
    </section>

    <% /* ===================== Supply ===================== */ %>
    <section id="supply" class="service-section scroll-mt-24">
      <div
        class="service-sticky-heading service-mobile-heading">
        <span class="service-number number-badge service-number-badge">3</span>
        <span class="heading-1">Постачання нового обладнання</span>
      </div>

      <% /* ---------- New equipment supply ---------- */ %>
      <section class="site-container grid items-center gap-8 md:grid-cols-[1.2fr_0.8fr]">
        <div>
          <span class="service-number number-badge service-number-badge service-number-badge-lg service-desktop-number">3</span>
          <h2 class="heading-1 service-desktop-title">Постачання нового обладнання</h2>
          <p class="body-copy service-copy-first text-left">
            Якщо ремонт обладнання технічно неможливий або економічно недоцільний, RENOVA допоможе підібрати нове
            рішення відповідно до завдань вашого виробництва.
          </p>
          <p class="body-copy mt-4 text-left">
            Ми аналізуємо вимоги описані в технічному завданні замовника, підбираємо відповідне обладнання від
            перевірених виробників з Європи та Азії, а також розраховуємо вартість постачання, монтажу та
            пусконалагоджувальних робіт.
          </p>
          <p class="body-copy mt-4 text-left">
            Після встановлення виконуємо налаштування та перевірку роботи обладнання,
            а також проводимо базове навчання представників замовника.
          </p>
          <a href="/#contacts" class="btn btn-primary service-cta">Замовити нове обладнання</a>
        </div>
        <div class="service-image relative -mr-6 hidden h-64 overflow-hidden md:block md:h-80 lg:-mr-8 lg:h-[26rem] xl:-mr-16 2xl:-mr-24 2xl:h-[32.375rem]">
          <img class="fade-left absolute inset-0 h-full w-full object-cover" src="/images/equipment-supply.png" alt="Складання нового обладнання перед відвантаженням" loading="lazy" decoding="async">
        </div>
      </section>

      <% /* ---------- Equipment catalog ---------- */ %>
      <section class="site-container supply-catalog">
        <div class="service-card card w-full max-w-2xl p-6 md:p-8">
          <h2 id="supply-catalog" class="heading-2 relative z-10 scroll-mt-28">Постачаємо широкий спектр обладнання</h2>
          <ul class="check-list relative z-10 mt-3 lg:mt-5 text-base text-navy">
            <% supplyCatalog.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        </div>
        <div class="supply-brands-area">
          <ul class="supply-brands" aria-label="Виробники обладнання, яке ми постачаємо">
            <% supplyBrands.forEach(function (brand) { %>
              <li class="supply-brand">
                <img src="/images/brands/<%= brand.file %>" alt="<%= brand.name %>" loading="lazy" decoding="async">
              </li>
            <% }); %>
          </ul>
        </div>
      </section>

      <% /* ---------- Supply stages ---------- */ %>
      <section class="site-container">
        <h2 id="supply-stages" class="heading-2 scroll-mt-28">Етапи постачання обладнання</h2>
        <div class="mt-4 lg:mt-6">
          <%- include('../partials/process-steps', { steps: supplySteps, captionLines: 3, fullWidth: true }) %>
        </div>
      </section>
    </section>
  </main>
</div>
