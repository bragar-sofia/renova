<style>
  @keyframes scan-reveal {
    0%, 12%  { clip-path: inset(0 66% 0 0); }
    55%, 85% { clip-path: inset(0 0 0 0); }
    100%     { clip-path: inset(0 66% 0 0); }
  }
  @keyframes scan-beam {
    0%, 12%  { left: 34%;  opacity: 0; }
    18%      { opacity: 1; }
    50%      { opacity: 1; }
    55%      { left: 100%; opacity: 0; }
    100%     { left: 100%; opacity: 0; }
  }
  @media (min-width: 1536px) {
    @keyframes scan-reveal {
      0%, 12%  { clip-path: inset(0 88% 0 0); }
      55%, 85% { clip-path: inset(0 0 0 0); }
      100%     { clip-path: inset(0 88% 0 0); }
    }
    @keyframes scan-beam {
      0%, 12%  { left: 12%;  opacity: 0; }
      18%      { opacity: 1; }
      50%      { opacity: 1; }
      55%      { left: 100%; opacity: 0; }
      100%     { left: 100%; opacity: 0; }
    }
  }
  @media (max-width: 767px) {
    .hero-photo-fade {
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 85%);
              mask-image: linear-gradient(to right, transparent 0%, #000 85%);
    }
    @keyframes scan-reveal {
      0%, 12%  { clip-path: inset(0 0 0 100%); }
      55%, 85% { clip-path: inset(0 0 0 0); }
      100%     { clip-path: inset(0 0 0 100%); }
    }
    @keyframes scan-beam {
      0%, 12%  { left: 100%; opacity: 0; }
      18%      { opacity: 1; }
      50%      { opacity: 1; }
      55%      { left: 0%;   opacity: 0; }
      100%     { left: 0%;   opacity: 0; }
    }
  }
  .machine-restored { animation: scan-reveal 10s cubic-bezier(.65,0,.35,1) infinite; }
  .scan-beam {
    position: absolute; top: -6%; bottom: -6%; left: 0; width: 30px;
    transform: translateX(-50%); pointer-events: none; opacity: 0; z-index: 2;
    mix-blend-mode: screen; filter: blur(.5px);
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(160,215,255,.10) 28%,
      rgba(220,242,255,.95) 50%,
      rgba(160,215,255,.10) 72%,
      transparent 100%);
    box-shadow: 0 0 26px 8px rgba(130,200,255,.55);
    animation: scan-beam 10s cubic-bezier(.65,0,.35,1) infinite;
  }
  .scan-beam::after {
    content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px;
    transform: translateX(-50%); background: rgba(255,255,255,.9);
    box-shadow: 0 0 10px 2px rgba(210,240,255,.9);
  }
  @media (prefers-reduced-motion: reduce) {
    .machine-restored { animation: none; clip-path: inset(0 0 0 0); }
    .scan-beam { display: none; }
  }
  #faq summary::-webkit-details-marker { display: none; }
</style>

