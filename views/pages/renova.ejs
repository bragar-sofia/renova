<%- include('../partials/theme') %>

<style>
  @property --reveal-x {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 34%;
  }

  @keyframes scan-reveal-soft {
    0%, 12% {
      --reveal-x: 34%;
    }

    55%, 85% {
      --reveal-x: 112%;
    }

    100% {
      --reveal-x: 34%;
    }
  }

  @media (min-width: 1536px) {
    @keyframes scan-reveal-soft {
      0%, 12% {
        --reveal-x: 12%;
      }

      55%, 85% {
        --reveal-x: 112%;
      }

      100% {
        --reveal-x: 12%;
      }
    }
  }

  /* На мобільному залишаємо простішу анімацію справа наліво */
  @keyframes scan-reveal-mobile {
    0%, 12% {
      clip-path: inset(0 0 0 100%);
    }

    55%, 85% {
      clip-path: inset(0 0 0 0);
    }

    100% {
      clip-path: inset(0 0 0 100%);
    }
  }

  @media (min-width: 768px) {
    .machine-restored,
    .restored-glow {
      --reveal-x: 34%;

      -webkit-mask-image:
        linear-gradient(
          90deg,
          #000 0,
          #000 calc(var(--reveal-x) - 7rem),
          rgba(0, 0, 0, 0.88) calc(var(--reveal-x) - 3.5rem),
          rgba(0, 0, 0, 0.48) var(--reveal-x),
          rgba(0, 0, 0, 0.14) calc(var(--reveal-x) + 4rem),
          transparent calc(var(--reveal-x) + 7rem),
          transparent 100%
        );

      mask-image:
        linear-gradient(
          90deg,
          #000 0,
          #000 calc(var(--reveal-x) - 7rem),
          rgba(0, 0, 0, 0.88) calc(var(--reveal-x) - 3.5rem),
          rgba(0, 0, 0, 0.48) var(--reveal-x),
          rgba(0, 0, 0, 0.14) calc(var(--reveal-x) + 4rem),
          transparent calc(var(--reveal-x) + 7rem),
          transparent 100%
        );

      animation:
        scan-reveal-soft 10s cubic-bezier(.65, 0, .35, 1) infinite;
    }
  }

  @media (max-width: 767px) {
    .machine-restored,
    .restored-glow {
      animation:
        scan-reveal-mobile 10s cubic-bezier(.65, 0, .35, 1) infinite;
    }
  }

  @media (min-width: 1536px) {
    .machine-restored,
    .restored-glow {
      --reveal-x: 12%;
    }
  }

  @keyframes scan-beam {
    0%, 12%  { left: 34%;  opacity: 0; }
    18%      { opacity: 1; }
    50%      { opacity: 1; }
    55%      { left: 100%; opacity: 0; }
    100%     { left: 100%; opacity: 0; }
  }
  @media (min-width: 1536px) {
    @keyframes scan-beam {
      0%, 12%  { left: 12%;  opacity: 0; }
      18%      { opacity: 1; }
      50%      { opacity: 1; }
      55%      { left: 100%; opacity: 0; }
      100%     { left: 100%; opacity: 0; }
    }
  }
  @media (max-width: 767px) {
    .hero-photo-fade {
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 85%);
              mask-image: linear-gradient(to right, transparent 0%, #000 85%);
    }
    @keyframes scan-beam {
      0%, 12%  { left: 100%; opacity: 0; }
      18%      { opacity: 1; }
      50%      { opacity: 1; }
      55%      { left: 0%;   opacity: 0; }
      100%     { left: 0%;   opacity: 0; }
    }
  }
  .scan-beam {
    position: absolute; top: -6%; bottom: -6%; left: 0; width: 30px;
    transform: translateX(-50%); pointer-events: none; opacity: 0; z-index: 5;
    mix-blend-mode: screen; filter: blur(.5px);
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(160,215,255,.10) 28%,
      rgba(220,242,255,.95) 50%,
      rgba(160,215,255,.10) 72%,
      transparent 100%);
    box-shadow: 0 0 26px 8px rgba(130,200,255,.55);
    animation: scan-beam 10s cubic-bezier(.65,0,.35,1) infinite;
  }
  .scan-beam::after {
    content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px;
    transform: translateX(-50%); background: rgba(255,255,255,.9);
    box-shadow: 0 0 10px 2px rgba(210,240,255,.9);
  }
  @media (prefers-reduced-motion: reduce) {
    .machine-restored,
    .restored-glow {
      animation: none;
      clip-path: none;

      -webkit-mask-image: none;
      mask-image: none;
    }

    .scan-beam {
      display: none;
    }
  }
  #faq summary::-webkit-details-marker { display: none; }

  /* Переваги у Hero */

  /* Переваги у Hero */

  .hero-benefits {
    display: grid;
    width: 100%;
    max-width: 30rem;
    gap: 0.75rem;
  }

  .hero-benefit-item {
    position: relative;
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(82, 123, 141, 0.24);
    text-align: left;
  }

  .hero-benefit-item:last-child {
    border-bottom: 0;
  }

  .hero-benefit-item img {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    object-fit: contain;
  }

  .hero-benefit-item span {
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.35;
    color: #15324c;
  }

  /* Планшет і десктоп */
  @media (min-width: 768px) {
    .hero-benefits {
      max-width: 46rem;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0;
    }

    .hero-benefit-item {
      min-height: 94px;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0;
      padding: 4px 15px;
      border-bottom: 0;
      text-align: center;
    }

    .hero-benefit-item img {
      width: 36px;
      height: 36px;
    }

    .hero-benefit-item span {
      max-width: 8.5rem;
      margin-top: 9px;
      line-height: 1.25;
    }

    .hero-benefit-item:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 6px;
      right: 0;
      bottom: 6px;
      width: 1px;
      background: rgba(82, 123, 141, 0.28);
    }
  }

  .hero-cta-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* Окремий контекст накладання шарів */
  .hero-photo-fade {
    isolation: isolate;
    background: #eef6fa;
  }

  .hero-photo-fade::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;

    background:
      linear-gradient(
        90deg,
        #eef6fa 0%,
        rgba(238, 246, 250, 0.98) 7%,
        rgba(238, 246, 250, 0.82) 13%,
        rgba(238, 246, 250, 0.48) 20%,
        rgba(238, 246, 250, 0.14) 27%,
        transparent 34%
      );
  }

  /* Легка технічна сітка та креслярські кола */
  .hero-blueprint-grid {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    overflow: hidden;
    opacity: 0.12;
    mix-blend-mode: multiply;

    background-image:
      linear-gradient(
        rgba(43, 109, 151, 0.62) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(43, 109, 151, 0.62) 1px,
        transparent 1px
      );

    background-size: 42px 42px;

    -webkit-mask-image:
      linear-gradient(
        to left,
        #000 0%,
        #000 76%,
        rgba(0, 0, 0, 0.65) 88%,
        transparent 100%
      );

    mask-image:
      linear-gradient(
        to left,
        #000 0%,
        #000 76%,
        rgba(0, 0, 0, 0.65) 88%,
        transparent 100%
      );
  }

  .hero-blueprint-grid::before {
    content: "";
    position: absolute;
    top: -12%;
    right: -10%;
    width: 84%;
    aspect-ratio: 1;
    border-radius: 50%;

    background:
      repeating-radial-gradient(
        circle at center,
        transparent 0 62px,
        rgba(43, 109, 151, 0.9) 63px 64px,
        transparent 65px 106px
      );
  }

  .hero-blueprint-grid::after {
    content: "";
    position: absolute;
    top: 4%;
    right: 0;
    width: 72%;
    height: 72%;

    background:
      linear-gradient(
        90deg,
        transparent 49.85%,
        rgba(43, 109, 151, 0.85) 50%,
        transparent 50.15%
      ),
      linear-gradient(
        transparent 49.85%,
        rgba(43, 109, 151, 0.85) 50%,
        transparent 50.15%
      );
  }

  /* Вихідне пошкоджене зображення */
  .machine-broken {
    z-index: 1;
  }

  /* Відновлене зображення */
  .machine-restored {
    z-index: 2;

    filter:
      brightness(1.06)
      contrast(1.02)
      saturate(1.05);
  }

  /* М’яке підсвічування відновленої частини */
  .restored-glow {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;

    background:
      radial-gradient(
        ellipse at 78% 46%,
        rgba(255, 255, 255, 0.46) 0%,
        rgba(192, 226, 255, 0.22) 25%,
        rgba(108, 183, 234, 0.10) 46%,
        transparent 68%
      ),
      linear-gradient(
        90deg,
        transparent 42%,
        rgba(184, 222, 250, 0.08) 68%,
        rgba(255, 255, 255, 0.16) 100%
      );

    mix-blend-mode: screen;
    filter: blur(9px);
  }

  /* Блок послуг */

  .services-primary-card,
  .services-secondary-card {
    box-shadow: 0 16px 42px rgba(7, 49, 78, 0.07);
  }

  /* Креслярський декор головної картки */
  .services-primary-card::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 35%;
    pointer-events: none;
    opacity: 0.12;

    background-image:
      linear-gradient(
        rgba(43, 109, 151, 0.32) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(43, 109, 151, 0.32) 1px,
        transparent 1px
      ),
      radial-gradient(
        circle at 65% 42%,
        transparent 0 62px,
        rgba(43, 109, 151, 0.55) 63px 64px,
        transparent 65px 108px,
        rgba(43, 109, 151, 0.4) 109px 110px,
        transparent 111px
      );

    background-size:
      34px 34px,
      34px 34px,
      100% 100%;

    -webkit-mask-image:
      linear-gradient(to left, #000 0%, #000 60%, transparent 100%);

    mask-image:
      linear-gradient(to left, #000 0%, #000 60%, transparent 100%);
  }

  /* Крапковий декор нижніх карток */
  .services-secondary-card::after {
    content: "";
    position: absolute;
    right: -14px;
    bottom: -14px;
    width: 150px;
    height: 150px;
    pointer-events: none;
    opacity: 0.2;

    background-image:
      radial-gradient(
        circle,
        rgba(43, 109, 151, 0.7) 1.4px,
        transparent 1.6px
      );

    background-size: 12px 12px;

    -webkit-mask-image:
      radial-gradient(circle at bottom right, #000 0%, transparent 72%);

    mask-image:
      radial-gradient(circle at bottom right, #000 0%, transparent 72%);
  }

  .service-feature-list {
    display: grid;
    gap: 0.65rem;
  }

  .service-feature-list li {
    position: relative;
    padding-left: 1.7rem;
    line-height: 1.35;
  }

  .service-feature-list li::before {
    content: "✓";
    position: absolute;
    top: 0.05rem;
    left: 0;
    display: flex;
    width: 1.1rem;
    height: 1.1rem;
    align-items: center;
    justify-content: center;
    border: 1px solid #527b8d;
    border-radius: 999px;
    color: #527b8d;
    font-size: 0.7rem;
    font-weight: 700;
  }

  @media (max-width: 767px) {
    .services-primary-card::after {
      width: 55%;
      opacity: 0.07;
    }

    .services-secondary-card::after {
      opacity: 0.12;
    }
  }
</style>

