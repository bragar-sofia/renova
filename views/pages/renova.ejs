<style>
  /* Верстат "до" — статичний нижній шар. Верстат "після" проявляється поверх нього
     не звичайним зрізом, а "лазерним відновленням": кадром проходить світляна
     вертикальна смуга-сканер (.scan-beam), і рівно за нею іржавий верстат
     перетворюється на відновлений. Край появи (clip-path) і смуга рухаються з
     тими самими ключовими кадрами (10%→45%) та однаковим easing, тож ідуть разом.
     Далі — пауза на відновленому, і плавне повернення до "до". */
  /* Прохід починається не з лівого краю, а там, де стоїть сам верстат (ліворуч від
     цієї межі — порожнє світле тло під текстом, тож зрушення старту нічого візуально
     не міняє). На ноутбуках (md–xl) фото притиснуте праворуч і верстат починається
     ~34% ширини кадру — саме туди ставимо старт. inset(0 66% 0 0) = межа вже на 34%. */
  @keyframes scan-reveal {
    0%, 12%  { clip-path: inset(0 66% 0 0); }   /* видно "до" (верстат праворуч) */
    55%, 85% { clip-path: inset(0 0 0 0); }      /* повністю проявлений + пауза */
    100%     { clip-path: inset(0 66% 0 0); }    /* плавно назад до "до" */
  }
  /* Смуга-сканер: left їде 34%→100% синхронно з краєм появи; translateX(-50%)
     ставить її центром рівно на межу. Спалахує на старті проходу, гасне в кінці. */
  @keyframes scan-beam {
    0%, 12%  { left: 34%;  opacity: 0; }
    18%      { opacity: 1; }
    50%      { opacity: 1; }
    55%      { left: 100%; opacity: 0; }
    100%     { left: 100%; opacity: 0; }
  }
  /* Широкий десктоп (≥1536): фото на всю ширину блоку, і текст заходить правіше —
     аж під лівий край верстата. Щоб промінь стартував ПІСЛЯ тексту, зсуваємо старт
     на ~49% (верстат тут починається ~41%, тонкий лівий край лишається під текстом). */
  @media (min-width: 1536px) {
    @keyframes scan-reveal {
      0%, 12%  { clip-path: inset(0 51% 0 0); }
      55%, 85% { clip-path: inset(0 0 0 0); }
      100%     { clip-path: inset(0 51% 0 0); }
    }
    @keyframes scan-beam {
      0%, 12%  { left: 49%;  opacity: 0; }
      18%      { opacity: 1; }
      50%      { opacity: 1; }
      55%      { left: 100%; opacity: 0; }
      100%     { left: 100%; opacity: 0; }
    }
  }
  /* Мобільний (<md): фото віддзеркалене (-scale-x-100), тож поява читається у
     зворотній бік. Дзеркалимо й промінь: він з'являється з ПРАВОГО краю і йде
     ВЛІВО. Той самий inset(0 R 0 0) під дзеркалом дає межу, що росте справа наліво,
     тож верстат заповнюється з правого краю — синхронно з променем (left 100%→0%). */
  @media (max-width: 767px) {
    @keyframes scan-reveal {
      0%, 12%  { clip-path: inset(0 100% 0 0); }
      55%, 85% { clip-path: inset(0 0 0 0); }
      100%     { clip-path: inset(0 100% 0 0); }
    }
    @keyframes scan-beam {
      0%, 12%  { left: 100%; opacity: 0; }
      18%      { opacity: 1; }
      50%      { opacity: 1; }
      55%      { left: 0%;   opacity: 0; }
      100%     { left: 0%;   opacity: 0; }
    }
  }
  .machine-restored { animation: scan-reveal 10s cubic-bezier(.65,0,.35,1) infinite; }
  .scan-beam {
    position: absolute; top: -6%; bottom: -6%; left: 0; width: 30px;
    transform: translateX(-50%); pointer-events: none; opacity: 0; z-index: 2;
    mix-blend-mode: screen; filter: blur(.5px);
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(160,215,255,.10) 28%,
      rgba(220,242,255,.95) 50%,
      rgba(160,215,255,.10) 72%,
      transparent 100%);
    box-shadow: 0 0 26px 8px rgba(130,200,255,.55);
    animation: scan-beam 10s cubic-bezier(.65,0,.35,1) infinite;
  }
  /* Тонке яскраве ядро променя всередині м'якого сяйва. */
  .scan-beam::after {
    content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px;
    transform: translateX(-50%); background: rgba(255,255,255,.9);
    box-shadow: 0 0 10px 2px rgba(210,240,255,.9);
  }
  @media (prefers-reduced-motion: reduce) {
    .machine-restored { animation: none; clip-path: inset(0 0 0 0); }
    .scan-beam { display: none; }
  }
  #faq summary::-webkit-details-marker { display: none; }
</style>

