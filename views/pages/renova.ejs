<style>
  /* Верстат "до" лежить статичним нижнім шаром, а верстат "після" виїжджає
     поверх нього суцільним зрізом від краю до краю (wipe), а не звичайним fade. */
  @keyframes wipe-reveal {
    0%, 40% { clip-path: inset(0 100% 0 0); }
    49%, 91% { clip-path: inset(0 0 0 0); }
    100% { clip-path: inset(0 100% 0 0); }
  }
  .machine-restored { animation: wipe-reveal 8s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    .machine-restored { animation: none; clip-path: inset(0 0 0 0); }
  }
  #faq summary::-webkit-details-marker { display: none; }
</style>

