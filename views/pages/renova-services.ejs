<div class="min-h-screen bg-sky font-sans text-navy antialiased">
  <main id="services">
    <header class="services-intro relative overflow-hidden border-b border-steel/30 bg-white">
      <div class="services-intro-grid" aria-hidden="true"></div>

      <div class="relative z-10 mx-auto max-w-shell px-6 py-10 lg:px-8 lg:py-14 xl:px-16 2xl:px-24 2xl:py-16">
        <div class="max-w-4xl">
          <div class="mb-5 flex items-center gap-4">
            <span class="h-px w-10 bg-steel/60"></span>

            <p class="font-display text-sm font-bold uppercase tracking-[0.28em] text-steel">
              Ремонт · сервіс · постачання
            </p>
          </div>

          <h1 class="max-w-[15em] font-display text-h1 font-normal text-navy">
            Послуги RENOVA
          </h1>

          <p class="mt-5 max-w-3xl text-base leading-7 text-navy">
            Відновлюємо та обслуговуємо металорізальне і пресове обладнання,
            а коли ремонт недоцільний — підбираємо, постачаємо та запускаємо
            нове рішення під завдання виробництва.
          </p>

          <nav class="mt-7 flex flex-wrap gap-2" aria-label="Напрями послуг">
            <a
              href="#restoration"
              class="rounded-pill border border-steel bg-sky/60 px-4 py-2 text-sm font-semibold text-navy transition hover:border-navy hover:bg-sky"
            >
              Відновлення обладнання
            </a>

            <a
              href="#service"
              class="rounded-pill border border-steel bg-sky/60 px-4 py-2 text-sm font-semibold text-navy transition hover:border-navy hover:bg-sky"
            >
              Сервісне обслуговування
            </a>

            <a
              href="#supply"
              class="rounded-pill border border-steel bg-sky/60 px-4 py-2 text-sm font-semibold text-navy transition hover:border-navy hover:bg-sky"
            >
              Постачання обладнання
            </a>
          </nav>
        </div>
      </div>
    </header>

    <% /* ===================== Restoration ===================== */ %>
    <section id="restoration" class="service-section scroll-mt-24 space-y-8 pb-10 pt-6 lg:space-y-10 lg:pb-14 lg:pt-8">

      <div
        class="service-sticky-heading sticky top-[5.125rem] z-30 flex items-center gap-3 border-y border-steel/30 px-6 py-3 md:hidden">
        <span class="service-number h-10 w-10 font-display text-base font-bold leading-none">1</span>
        <span class="font-display text-h1 font-normal text-navy">Відновлення обладнання</span>
      </div>

      <% /* ---------- Equipment restoration ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 md:grid-cols-[1.2fr_0.8fr]">
        <div>
          <span
            class="service-number mb-4 hidden h-14 w-14 font-display text-h2 font-bold leading-none md:flex">1</span>
          <h2 class="hidden font-display text-h1 font-normal text-navy md:block">Відновлення обладнання</h2>
          <p class="mt-6 text-left text-base leading-7 text-navy">
            RENOVA спеціалізується на ремонті та комплексному відновленні металорізального і&nbsp;пресового обладнання
            незалежно від його типу, виробника та року випуску. Ми виконуємо роботи різного рівня складності — від
            усунення окремих несправностей і&nbsp;відновлення вузлів до капітального ремонту та модернізації верстата.
          </p>
          <p class="mt-4 text-left text-base leading-7 text-navy">
            Перед початком робіт наші спеціалісти проводять діагностику, визначають причини несправності, оцінюють
            загальний технічний стан обладнання та залишковий ресурс його основних вузлів. На основі отриманих
            результатів ми пропонуємо технічно й&nbsp;економічно обґрунтований варіант відновлення з&nbsp;урахуванням
            технічного завдання та побажань замовника. Наші спеціалісти виїжджають на підприємства по всій Україні.
          </p>
          <a href="/renova#contacts"
             class="mt-7 inline-flex items-center justify-center gap-2 rounded-pill bg-navy px-6 py-3 text-base font-display font-bold text-white transition hover:bg-[#0b527b] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-steel focus-visible:ring-offset-2">Замовити
            відновлення
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="M13 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
        <div
          class="service-image relative -mr-6 hidden h-64 overflow-hidden md:block md:h-80 lg:-mr-8 lg:h-[26rem] xl:-mr-16 2xl:-mr-24 2xl:h-[32.25rem]">
          <img class="fade-left absolute inset-0 h-full w-full object-cover" src="/images/restoration-hero.png"
               alt="Ремонт токарного верстата у майстерні RENOVA" fetchpriority="high" decoding="async">
        </div>
      </section>

      <% /* ---------- Repair types ---------- */ %>
      <section class="mx-auto max-w-shell px-6 lg:px-8 xl:px-16 2xl:px-24">
        <h3 class="font-display text-h2 font-normal text-navy">Типи ремонту</h3>
        <div data-stagger class="mt-7 grid gap-6 [grid-auto-rows:1fr] sm:grid-cols-2 xl:grid-cols-4">
          <% repairTypes.forEach(function (card) { %>
            <article class="service-card flex h-full flex-col rounded-card bg-white p-6">
              <span class="mb-4 h-1 w-10 rounded-full bg-steel" aria-hidden="true"></span>
              <h4 class="relative z-10 font-display text-h3 font-normal text-navy"><%= card.title %></h4>
              <p class="relative z-10 mt-3 flex-grow text-left text-base leading-7 text-navy"><%= card.text %></p>
            </article>
          <% }); %>
        </div>
      </section>

      <% /* ---------- Repair stages ---------- */ %>
      <section class="mx-auto max-w-shell px-6 lg:px-8 xl:px-16 2xl:px-24">
        <h3 class="font-display text-h2 font-normal text-navy">Етапи ремонту</h3>
        <div class="mt-6">
          <%- include('../partials/process-steps', { steps: repairSteps, captionLines: 3 }) %>
        </div>
      </section>

      <% /* ---------- Major overhaul ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-start gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 lg:grid-cols-[0.4fr_0.6fr]">
        <div>
          <h3 class="font-display text-h2 font-normal text-navy">Капітальний ремонт</h3>
          <p class="mt-6 text-left text-base leading-7 text-navy">
            Капітальний ремонт проводиться у&nbsp;разі значного зношення вузлів обладнання, втрати точності, системних
            несправностей або необхідності комплексного оновлення верстата.
          </p>
          <div class="service-card mt-6 rounded-card bg-white p-6 md:p-8">
            <h4 class="font-display text-h3 font-normal text-navy">Що може включати капітальний ремонт</h4>
            <ul class="check-list relative z-10 mt-5 text-base text-navy">
              <% overhaulScope.forEach(function (item) { %>
                <li><%= item %></li>
              <% }); %>
            </ul>
          </div>
        </div>
        <div
          class="service-image relative -mr-6 hidden h-72 overflow-hidden md:block md:h-96 lg:-mr-8 lg:h-full lg:min-h-[36.4375rem] xl:-mr-16 2xl:-mr-24">
          <img class="fade-left absolute inset-0 h-full w-full object-cover" src="/images/capital-repair.png"
               alt="Розбирання коробки передач під час капітального ремонту" loading="lazy" decoding="async">
        </div>
      </section>

      <% /* ---------- Cost and timeline ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 lg:grid-cols-[auto_1fr] lg:gap-14">
        <img class="mx-auto h-56 w-auto object-contain lg:mx-0 lg:h-52" src="/images/icons/illustration-cost-terms.svg"
             alt="" loading="lazy" decoding="async" aria-hidden="true">
        <div>
          <h3 class="font-display text-h2 font-normal text-navy">Вартість і терміни</h3>
          <p class="mt-6 text-left text-base leading-7 text-navy">
            Вартість і&nbsp;термін виконання ремонтних робіт визначається індивідуально після проведення діагностики
            обладнання, та залежить від його технічного стану, складності та обсягу необхідних робіт, потреб у&nbsp;відновленні
            або заміні вузлів, а&nbsp;також вимог описаних у&nbsp;технічному завданні замовника.
          </p>
          <p class="mt-4 text-left text-base leading-7 text-navy">
            За результатами діагностики ми пропонуємо оптимальний варіант ремонту та формуємо комерційну пропозицію із
            переліком робіт, строками виконання робіт, та&nbsp;їх вартістю.
          </p>
        </div>
      </section>

    </section>

    <% /* ===================== Service ===================== */ %>
    <section id="service" class="service-section scroll-mt-24 space-y-8 py-10 lg:space-y-10 lg:py-14">

      <div
        class="service-sticky-heading sticky top-[5.125rem] z-30 flex items-center gap-3 border-y border-steel/30 px-6 py-3 md:hidden">
        <span class="service-number h-10 w-10 font-display text-base font-bold leading-none">2</span>
        <span class="font-display text-h1 font-normal text-navy">Сервісне обслуговування</span>
      </div>

      <% /* ---------- Maintenance ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 md:grid-cols-[0.8fr_1.2fr]">
        <div
          class="service-image relative -ml-6 hidden h-64 overflow-hidden md:block md:h-80 lg:-ml-8 lg:h-[26rem] xl:-ml-16 2xl:-ml-24 2xl:h-[32rem]">
          <img class="fade-right absolute inset-0 h-full w-full object-cover" src="/images/service-maintenance.png"
               alt="Профілактичне обслуговування токарного верстата" loading="lazy" decoding="async">
        </div>
        <div>
          <span
            class="service-number mb-4 hidden h-14 w-14 font-display text-h2 font-bold leading-none md:flex">2</span>
          <h2 class="hidden font-display text-h1 font-normal text-navy md:block">Сервісне обслуговування</h2>
          <p class="mt-6 text-left text-base leading-7 text-navy">
            Найкращий ремонт – це той, якого вдалося уникнути. Тому RENOVA допомагає підтримувати металорізальне та
            пресове обладнання у&nbsp;стабільному робочому стані протягом усього періоду експлуатації. Ми проводимо
            планове технічне обслуговування, діагностику та профілактичні роботи, щоб своєчасно виявляти зношення,
            усувати несправності на ранніх етапах і&nbsp;знижувати ризик аварійних зупинок.
          </p>
          <p class="mt-4 text-left text-base leading-7 text-navy">
            Для кожного підприємства ми розробляємо індивідуальний графік обслуговування з&nbsp;урахуванням типу
            обладнання, його поточного стану, навантаження та графіку роботи підприємства.
          </p>
          <a href="/renova#contacts"
             class="mt-7 inline-flex items-center justify-center gap-2 rounded-pill bg-navy px-6 py-3 text-base font-display font-bold text-white transition hover:bg-[#0b527b] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-steel focus-visible:ring-offset-2">Замовити
            сервісне обслуговування
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="M13 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </section>

      <% /* ---------- Prevent failure ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 lg:grid-cols-[1fr_auto] lg:gap-14">
        <div>
          <h3 class="font-display text-h2 font-normal text-navy">Попередити несправність завжди краще ніж усувати
            її</h3>
          <p class="mt-6 text-left text-base leading-7 text-navy">
            Аварійна поломка часто виникає в&nbsp;найбільш невідповідний момент і&nbsp;призводить не лише до витрат на
            ремонт, а&nbsp;й до простою обладнання та пов’язаних із ним виробничих процесів.
          </p>
          <p class="mt-4 text-left text-base leading-7 text-navy">
            Завдання планового сервісного обслуговування – контролювати технічний стан верстата, своєчасно виявляти
            дефекти та виконувати необхідні роботи по їх усуненню до виникнення серйозної поломки. RENOVA може взяти на
            себе функції технічного супроводу верстатного парку або доповнити роботу власної служби з&nbsp;обслуговування
            на вашому підприємстві.
          </p>
        </div>
        <img class="mx-auto h-56 w-auto object-contain lg:mx-0 lg:h-[17.625rem]"
             src="/images/icons/illustration-prevention.svg" alt="" loading="lazy" decoding="async" aria-hidden="true">
      </section>

      <% /* ---------- Maintenance stages ---------- */ %>
      <section class="mx-auto max-w-shell px-6 lg:px-8 xl:px-16 2xl:px-24">
        <h3 class="font-display text-h2 font-normal text-navy">Етапи проведення сервісного обслуговування</h3>
        <div class="mt-6">
          <%- include('../partials/process-steps', { steps: serviceSteps, fullWidth: true }) %>
        </div>
      </section>

    </section>

    <% /* ===================== Supply ===================== */ %>
    <section id="supply" class="service-section scroll-mt-24 space-y-8 py-10 lg:space-y-10 lg:py-14">

      <div
        class="service-sticky-heading sticky top-[5.125rem] z-30 flex items-center gap-3 border-y border-steel/30 px-6 py-3 md:hidden">
        <span class="service-number h-10 w-10 font-display text-base font-bold leading-none">3</span>
        <span class="font-display text-h1 font-normal text-navy">Постачання нового обладнання</span>
      </div>

      <% /* ---------- New equipment supply ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 md:grid-cols-[1.2fr_0.8fr]">
        <div>
          <span
            class="service-number mb-4 hidden h-14 w-14 font-display text-h2 font-bold leading-none md:flex">3</span>
          <h2 class="hidden font-display text-h1 font-normal text-navy md:block">Постачання нового обладнання</h2>
          <p class="mt-6 text-left text-base leading-7 text-navy">
            Якщо ремонт обладнання технічно неможливий або економічно недоцільний, RENOVA допоможе підібрати нове
            рішення відповідно до завдань вашого виробництва.
          </p>
          <p class="mt-4 text-left text-base leading-7 text-navy">
            Ми аналізуємо технологічні потреби підприємства, підбираємо обладнання від перевірених виробників з&nbsp;Європи
            та Азії, розраховуємо вартість постачання, монтажу та пусконалагоджувальних робіт. Після встановлення
            виконуємо налаштування, проводимо перевірку роботи обладнання та базове навчання представників замовника.
          </p>
          <a href="/renova#contacts"
             class="mt-7 inline-flex items-center justify-center gap-2 rounded-pill bg-navy px-6 py-3 text-base font-display font-bold text-white transition hover:bg-[#0b527b] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-steel focus-visible:ring-offset-2">Замовити
            нове обладнання
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="M13 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
        <div
          class="service-image relative -mr-6 hidden h-64 overflow-hidden md:block md:h-80 lg:-mr-8 lg:h-[26rem] xl:-mr-16 2xl:-mr-24 2xl:h-[32.375rem]">
          <img class="fade-left absolute inset-0 h-full w-full object-cover" src="/images/equipment-supply.png"
               alt="Складання нового обладнання перед відвантаженням" loading="lazy" decoding="async">
        </div>
      </section>

      <% /* ---------- Equipment catalog ---------- */ %>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-6 lg:px-8 xl:px-16 2xl:px-24 lg:grid-cols-[1fr_auto] lg:gap-14">
        <div class="service-card w-full max-w-2xl rounded-card bg-white p-6 md:p-8">
          <h3 class="relative z-10 font-display text-h3 font-normal text-navy">Постачаємо широкий спектр обладнання</h3>
          <ul class="check-list relative z-10 mt-5 text-base text-navy">
            <% supplyCatalog.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        </div>
        <img class="mx-auto h-56 w-auto object-contain lg:mx-0 lg:h-[17.625rem]"
             src="/images/icons/icon-equipment-spectrum.svg" alt="Спектр постачання обладнання" loading="lazy"
             decoding="async">
      </section>

      <% /* ---------- Supply stages ---------- */ %>
      <section class="mx-auto max-w-shell px-6 lg:px-8 xl:px-16 2xl:px-24">
        <h3 class="font-display text-h2 font-normal text-navy">Етапи постачання обладнання</h3>
        <div class="mt-6">
          <%- include('../partials/process-steps', { steps: supplySteps, captionLines: 3 }) %>
        </div>
      </section>

    </section>
  </main>
</div>
