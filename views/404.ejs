<div class="error-page">
  <main>
    <section class="site-container error-page-section">
      <div class="card card-elevated error-card">
        <!-- Content -->
        <div class="error-content">
          <p class="error-code" aria-hidden="true">
            404
          </p>

          <h1 class="heading-1 error-title">
            Сторінку не знайдено
          </h1>

          <p class="error-description">
            Можливо, сторінку було переміщено, адресу введено неправильно
            або такого розділу більше не існує.
          </p>

          <div class="error-actions">
            <a href="/" class="btn btn-primary error-action">
              На головну
            </a>

            <a href="/services" class="btn btn-outline error-action">
              Наші послуги
            </a>
          </div>

          <div class="error-links">
            <a href="/projects" class="error-link">
              Наші проєкти
              <img src="/images/icons/icon-chevron-inactive.svg" alt="" aria-hidden="true">
            </a>

            <a href="/#contacts" class="error-link">
              Зв'язатися з нами
              <img src="/images/icons/icon-chevron-inactive.svg" alt="" aria-hidden="true">
            </a>
          </div>
        </div>

        <!-- Visual -->
        <div class="error-visual">
          <span class="error-visual-gradient" aria-hidden="true"></span>
          <img class="error-visual-machine" src="/images/lathe-broken.png" alt="" aria-hidden="true">
          <img class="error-visual-tools" src="/images/tools.png" alt="" aria-hidden="true">

          <div class="error-visual-code-wrap" aria-hidden="true">
            <span class="error-visual-code">
              404
            </span>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>
