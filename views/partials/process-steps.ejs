<%
var fullWidth = (typeof fullWidth !== 'undefined') && fullWidth;
var captionLines = (typeof captionLines !== 'undefined') ? captionLines : 0;
var manySteps = steps.length > 5;

var rootClasses = [
  'process-steps',
  manySteps ? 'process-steps--many' : 'process-steps--compact',
  fullWidth ? 'process-steps--full' : ''
].filter(Boolean).join(' ');

function isLargeIcon(step) {
  return (step.iconSize === 'lg' || step.height === 'h-12');
}

function hasCompactCaption(step) {
  return (step.compactCaption === true || step.captionMt === 'mt-2');
}
%>

<ol data-stagger class="<%= rootClasses %>"
<% if (captionLines) { %>
  style="--process-caption-min-height: <%= captionLines * 1.5 %>rem;"
  <% } %>
>
  <% steps.forEach(function (step, i) { %>

    <% if (i) { %>
      <li class="process-step-connector" aria-hidden="true">
        <span class="process-step-connector-line"></span>
        <span class="process-step-connector-arrow"></span>
      </li>
    <% } %>

    <li class="process-step">
      <span class="process-step-visual">
        <span class="number-badge process-step-number">
          <%= i + 1 %>
        </span>

        <span class="process-step-icon<%= isLargeIcon(step) ? ' process-step-icon--lg' : '' %>">
          <img src="/images/icons/<%= step.icon %>" alt="" aria-hidden="true">
        </span>
      </span>

      <p class="process-step-caption<%= hasCompactCaption(step) ? ' process-step-caption--compact' : '' %>">
        <%= step.text %>
      </p>
    </li>
  <% }); %>
</ol>
