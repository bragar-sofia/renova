<%
var active = (typeof active !== 'undefined') ? active : '';
var navItems = [
  { label: 'Послуги',        href: '/renova/services',  spy: 'services', page: 'services' },
  { label: 'Про нас',        href: base + '#about',     spy: 'about' },
  { label: 'Часті запитання', href: base + '#faq',       spy: 'faq' },
  { label: 'Контакти',       href: base + '#contacts',  spy: 'contacts' }
];
%>
<style>
  .nav-link { position: relative; }
  .nav-link::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px;
    background: currentColor; transform: scaleX(0); transform-origin: right center;
    transition: transform .32s var(--reveal-ease, cubic-bezier(.16,1,.3,1));
  }
  .nav-link:hover::after,
  .nav-link.is-active::after { transform: scaleX(1); transform-origin: left center; }
  .nav-link.is-active { color: #527b8d; }

  /* Mobile burger menu */
  .burger-line {
    position: absolute; left: 9px; right: 9px; height: 2px; border-radius: 2px;
    background: #012a4a; transition: transform .3s var(--reveal-ease, cubic-bezier(.16,1,.3,1)), opacity .2s ease;
  }
  .burger-line:nth-child(1) { top: 15px; }
  .burger-line:nth-child(2) { top: 21px; }
  .burger-line:nth-child(3) { top: 27px; }
  .menu-open .burger-line:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu-open .burger-line:nth-child(2) { opacity: 0; }
  .menu-open .burger-line:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .menu-panel {
    opacity: 0; transform: translateY(-10px); pointer-events: none;
    transition: opacity .28s ease, transform .28s var(--reveal-ease, cubic-bezier(.16,1,.3,1));
  }
  .menu-open .menu-panel { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .menu-panel .mnav-link { position: relative; transition: color .25s ease, padding .25s ease; }
  .menu-panel .mnav-link::before {
    content: ""; position: absolute; left: 0; top: 50%; height: 60%; width: 3px; border-radius: 3px;
    background: #527b8d; transform: translateY(-50%) scaleY(0); transform-origin: center;
    transition: transform .28s var(--reveal-ease, cubic-bezier(.16,1,.3,1));
  }
  .menu-panel .mnav-link.is-active { color: #527b8d; padding-left: 14px; }
  .menu-panel .mnav-link.is-active::before { transform: translateY(-50%) scaleY(1); }
</style>

<header class="sticky top-0 z-50 border-b-2 border-steel bg-white">
  <div class="mx-auto grid h-20 max-w-shell grid-cols-[1fr_auto_1fr] items-center gap-5 px-6 lg:px-8 xl:px-16 2xl:px-24">
    <a href="<%= base %>#home" aria-label="RENOVA — головна" class="justify-self-start">
      <img class="h-20 w-auto object-contain" src="/images/renova-brand.png" alt="RENOVA">
    </a>

    <nav class="hidden items-center gap-12 justify-self-center text-base font-display font-normal lg:flex" aria-label="Основна навігація">
      <% navItems.forEach(function (it) { %>
        <a class="nav-link text-navy transition-colors hover:text-steel<%= active === it.page ? ' is-active' : '' %>" data-spy="<%= it.spy %>" href="<%= it.href %>"><%= it.label %></a>
      <% }); %>
    </nav>

    <div class="col-start-3 flex items-center gap-6 justify-self-end">
      <a href="<%= base %>#contacts" class="hidden rounded-pill bg-navy px-6 py-3 text-base font-display font-bold text-white transition hover:bg-[#0b527b] lg:inline-block">Замовити діагностику</a>

      <button type="button" data-burger aria-label="Меню" aria-controls="mobile-menu" aria-expanded="false" class="relative h-11 w-11 shrink-0 lg:hidden">
        <span class="burger-line"></span>
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-mobile-menu class="menu-panel absolute inset-x-0 top-full border-b-2 border-steel bg-white shadow-lg lg:hidden">
    <nav class="mx-auto flex max-w-shell flex-col gap-1 px-6 py-4 font-display text-lg text-navy" aria-label="Мобільна навігація">
      <% navItems.forEach(function (it) { %>
        <a class="mnav-link py-2<%= active === it.page ? ' is-active' : '' %>" data-spy="<%= it.spy %>" href="<%= it.href %>"><%= it.label %></a>
      <% }); %>
      <a href="<%= base %>#contacts" class="mt-3 rounded-pill bg-navy px-6 py-3 text-center text-base font-bold text-white transition hover:bg-[#0b527b]">Замовити діагностику</a>
    </nav>
  </div>
</header>

<script>
  (function () {
    var script = document.currentScript;
    var start = function () {
    var header = script.previousElementSibling;
    while (header && header.tagName !== 'HEADER') header = header.previousElementSibling;
    if (!header) return;
    var burger = header.querySelector('[data-burger]');
    var panel = header.querySelector('[data-mobile-menu]');

    if (burger && panel) {
      burger.addEventListener('click', function () {
        var open = header.classList.toggle('menu-open');
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      panel.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          header.classList.remove('menu-open');
          burger.setAttribute('aria-expanded', 'false');
        });
      });
      document.addEventListener('click', function (e) {
        if (header.classList.contains('menu-open') && !header.contains(e.target)) {
          header.classList.remove('menu-open');
          burger.setAttribute('aria-expanded', 'false');
        }
      });
    }

    var links = Array.prototype.slice.call(header.querySelectorAll('[data-spy]'));
    var byId = {};
    links.forEach(function (l) { (byId[l.dataset.spy] = byId[l.dataset.spy] || []).push(l); });
    var sections = Object.keys(byId)
      .map(function (id) { return document.getElementById(id); })
      .filter(Boolean);

    if (sections.length) {
      var setActive = function (id) {
        links.forEach(function (l) { l.classList.toggle('is-active', l.dataset.spy === id); });
      };
      var current = null;
      var onScroll = function () {
        var line = window.innerHeight * 0.4;
        var best = null, bestTop = -Infinity;
        sections.forEach(function (s) {
          var top = s.getBoundingClientRect().top;
          if (top <= line && top > bestTop) { bestTop = top; best = s.id; }
        });
        if (best !== current) { current = best; if (best) setActive(best); else links.forEach(function (l) { l.classList.remove('is-active'); }); }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>
