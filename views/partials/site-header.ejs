<%
/**
 * Спільна шапка сайту.
 *
 * Локали (обидві обов'язкові — EJS кидає ReferenceError на невизначені):
 *   base     — префікс для якорів. '' на головній (посилання лишаються
 *              внутрішньосторінковими), '/renova' на підсторінках.
 *   showHome — чи показувати пункт "Головна". На головній він зайвий
 *              (користувач уже там), на підсторінках — потрібен, як у Figma.
 */
%>
<header class="sticky top-0 z-50 border-b-2 border-steel bg-white">
  <div class="mx-auto flex h-20 max-w-shell items-center justify-between gap-5 px-6 lg:px-8 xl:px-16 2xl:px-24">
    <a href="<%= base %>#home" aria-label="RENOVA — головна">
      <img class="h-20 w-auto object-contain" src="/images/renova-brand.png" alt="RENOVA">
    </a>
    <%/* "Послуги" веде на окрему сторінку послуг; решта пунктів — якорі головної
         (на підсторінці base='/renova', тож вони повертають на головну). */%>
    <nav class="hidden items-center gap-12 text-base font-display font-normal lg:flex" aria-label="Основна навігація">
      <% if (showHome) { %><a class="text-navy transition-colors hover:text-steel" href="<%= base %>#home">Головна</a><% } %>
      <a class="text-navy transition-colors hover:text-steel" href="/renova/services">Послуги</a>
      <a class="text-navy transition-colors hover:text-steel" href="<%= base %>#about">Про нас</a>
      <a class="text-navy transition-colors hover:text-steel" href="<%= base %>#faq">Часті запитання</a>
      <a class="text-navy transition-colors hover:text-steel" href="<%= base %>#contacts">Контакти</a>
    </nav>
    <a href="<%= base %>#contacts" class="rounded-pill bg-navy px-6 py-3 text-base font-display font-bold text-white transition hover:bg-[#0b527b]">Замовити діагностику</a>
  </div>
</header>
