<%
var active = (typeof active !== 'undefined') ? active : '';
var navItems = [
  {
    label: 'Послуги',
    href: '/services',
    page: 'services',
    submenu: [
      {
        label: 'Відновлення обладнання',
        href: '/services#restoration',
        spy: 'restoration'
      },
      {
        label: 'Сервісне обслуговування',
        href: '/services#service',
        spy: 'service'
      },
      {
        label: 'Постачання обладнання',
        href: '/services#supply',
        spy: 'supply'
      }
    ]
  },
  {
    label: 'Наші проекти',
    href: '/projects',
    page: 'projects'
  },
  {
    label: 'Про нас',
    href: base + '#about',
    spy: 'about',
    sep: true
  },
  {
    label: 'Часті запитання',
    href: base + '#faq',
    spy: 'faq'
  },
  {
    label: 'Контакти',
    href: base + '#contacts',
    spy: 'contacts'
  }
];
%>

<header class="site-header">
  <div class="site-container site-header-inner">
    <!-- Logo -->
    <a href="<%= base %>#home" class="site-header-brand" aria-label="RENOVA — головна">
      <img src="/images/renova-brand.png" alt="RENOVA">
    </a>

    <!-- Desktop navigation -->
    <nav class="desktop-nav" aria-label="Основна навігація">
      <% navItems.forEach(function (item) { %>
        <% if (item.submenu) { %>
          <div class="nav-has-menu<%= item.sep ? ' nav-item--separated' : '' %>">
            <a class="nav-link<%= active === item.page ? ' is-active' : '' %>" href="<%= item.href %>">
              <%= item.label %>

              <svg class="nav-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </a>

            <div class="nav-menu">
              <div class="nav-menu-panel">
                <% item.submenu.forEach(function (sub) { %>
                  <a class="nav-sub-link" data-spy="<%= sub.spy %>" href="<%= sub.href %>">
                    <%= sub.label %>
                  </a>
                <% }); %>
              </div>
            </div>
          </div>
        <% } else { %>

          <a class="nav-link<%= item.sep ? ' nav-item--separated' : '' %><%= active === item.page ? ' is-active' : '' %>"
            <% if (item.spy) { %>
              data-spy="<%= item.spy %>"
              <% } %>
              href="<%= item.href %>"
          >
            <%= item.label %>
          </a>
        <% } %>
      <% }); %>
    </nav>

    <!-- Actions -->
    <div class="site-header-actions">
      <a href="<%= base %>#contacts" class="btn btn-primary header-cta">
        Замовити діагностику
      </a>

      <button type="button" class="burger-button" data-burger aria-label="Меню" aria-controls="mobile-menu" aria-expanded="false">
        <span class="burger-line"></span>
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>
    </div>
  </div>


  <!-- Mobile menu -->
  <div id="mobile-menu" class="menu-panel" data-mobile-menu>
    <nav class="site-container mobile-nav" aria-label="Мобільна навігація">
      <% navItems.forEach(function (item) { %>
        <a class="mnav-link<%= active === item.page ? ' is-active' : '' %>"
          <% if (item.spy) { %>
            data-spy="<%= item.spy %>"
            <% } %>
            href="<%= item.href %>"
        >
          <%= item.label %>
        </a>

        <% if (item.submenu) { %>
          <div class="mobile-nav-submenu">
            <% item.submenu.forEach(function (sub) { %>
              <a class="mnav-link mobile-nav-sub-link" data-spy="<%= sub.spy %>" href="<%= sub.href %>">
                <%= sub.label %>
              </a>
            <% }); %>
          </div>
        <% } %>
      <% }); %>

      <a href="<%= base %>#contacts" class="btn btn-primary mobile-nav-cta">
        Замовити діагностику
      </a>
    </nav>
  </div>
</header>


<script>
  (function () {
    var script = document.currentScript;

    function initHeader() {
      var header = script.previousElementSibling;

      while (header && header.tagName !== 'HEADER') {
        header = header.previousElementSibling;
      }

      if (!header) {
        return;
      }

      /* ===== Mobile menu ===== */
      var burger = header.querySelector('[data-burger]');
      var panel = header.querySelector('[data-mobile-menu]');

      function closeMenu() {
        header.classList.remove('menu-open');

        if (burger) {
          burger.setAttribute('aria-expanded', 'false');
        }
      }

      if (burger && panel) {
        burger.addEventListener('click', function () {
          var open = header.classList.toggle('menu-open');
          burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        });

        panel.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', closeMenu);
        });

        document.addEventListener('click', function (event) {
          if (header.classList.contains('menu-open') && !header.contains(event.target)) {
            closeMenu();
          }
        });
      }

      /* ===== Navigation scroll spy ===== */
      var links = Array.prototype.slice.call(document.querySelectorAll('[data-spy]'));

      var linksById = {};
      links.forEach(function (link) {
        var id = link.dataset.spy;
        if (!linksById[id]) {
          linksById[id] = [];
        }

        linksById[id].push(link);
      });

      var sections = Object.keys(linksById)
        .map(function (id) {
          return document.getElementById(id);
        })
        .filter(Boolean);

      if (!sections.length) {
        return;
      }

      var current = null;

      function setActive(id) {
        links.forEach(function (link) {
          link.classList.toggle('is-active', link.dataset.spy === id);
        });
      }

      function updateNavigation() {
        var line = window.innerHeight * 0.4;
        var best = null;
        var bestTop = -Infinity;

        sections.forEach(function (section) {
          var top = section.getBoundingClientRect().top;

          if (top <= line && top > bestTop) {
            bestTop = top;
            best = section.id;
          }
        });

        if (best === current) {
          return;
        }

        current = best;
        setActive(best);
      }

      window.addEventListener('scroll', updateNavigation, { passive: true });
      window.addEventListener('resize', updateNavigation);
      updateNavigation();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeader, { once: true });
    } else {
      initHeader();
    }
  })();
</script>
