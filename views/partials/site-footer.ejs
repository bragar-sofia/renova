<%
var active = (typeof active !== 'undefined') ? active : '';
var footerNav = [
  { label: 'Головна', href: base, page: 'home' },
  { label: 'Послуги', href: '/services', page: 'services' },
  { label: 'Наші проекти', href: '/projects', page: 'projects' },
  { label: 'Про нас', href: base + '#about', spy: 'about' },
  { label: 'Часті запитання', href: base + '#faq', spy: 'faq' },
  { label: 'Контакти', href: base + '#contacts', spy: 'contacts' }
];
%>

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">

      <!-- Brand -->
      <div class="footer-brand">
        <a href="<%= base %>#home" class="footer-brand-link" aria-label="RENOVA — головна">
          <img src="/images/renova-brand.png" alt="RENOVA">
        </a>

        <p class="footer-brand-text">
          Повертаємо промислове обладнання до роботи
        </p>
      </div>

      <!-- Navigation -->
      <nav class="footer-nav" aria-label="Навігація у футері">
        <div class="footer-nav-column">
          <% footerNav.slice(0, 3).forEach(function (item) { %>
            <a class="footer-nav-link<%= active === item.page ? ' is-active' : '' %>" href="<%= item.href %>">
              <%= item.label %>
            </a>
          <% }); %>
        </div>

        <div class="footer-nav-column">
          <% footerNav.slice(3).forEach(function (item) { %>
            <a class="footer-nav-link" href="<%= item.href %>">
              <%= item.label %>
            </a>
          <% }); %>
        </div>
      </nav>

      <!-- Contacts -->
      <div class="footer-contacts">
        <a class="footer-contact-link" href="tel:+380756787784">
          <span class="footer-contact-icon" aria-hidden="true">
            <img class="footer-contact-icon-bg" src="/images/icons/icon-circle-bg.svg" alt="">
            <img class="footer-contact-icon-symbol" src="/images/icons/icon-phone-footer.png" alt="">
          </span>

          <span>+38 (075) 678 77 84</span>
        </a>

        <a class="footer-contact-link" href="mailto:commerce.renova@gmail.com">
          <span class="footer-contact-icon" aria-hidden="true">
            <img class="footer-contact-icon-bg" src="/images/icons/icon-circle-bg.svg" alt="">
            <img class="footer-contact-icon-symbol" src="/images/icons/icon-at-sign-footer.png" alt="">
          </span>

          <span class="footer-contact-text">
            commerce.renova@gmail.com
          </span>
        </a>
      </div>
    </div>
  </div>
</footer>

<button type="button" class="to-top" data-to-top aria-label="Догори">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M6 15l6-6 6 6"></path>
  </svg>
</button>
