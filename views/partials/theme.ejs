<style>
  /* Шрифти захостовано локально (assets/fonts), без залежності від fonts.googleapis.com —
     раніше сторінка мовчки відкочувалась на системний Arial, якщо Google Fonts
     був недоступний у мережі користувача (корпоративний проксі, блокувальники тощо). */
  @font-face {
    font-family: 'Geologica';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/geologica-cyrillic.woff2') format('woff2');
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }
  @font-face {
    font-family: 'Geologica';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/geologica-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Open Sans';
    font-style: normal;
    font-weight: 300 800;
    font-display: swap;
    src: url('/fonts/opensans-cyrillic.woff2') format('woff2');
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }
  @font-face {
    font-family: 'Open Sans';
    font-style: normal;
    font-weight: 300 800;
    font-display: swap;
    src: url('/fonts/opensans-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
</style>
<%
/**
 * ЄДИНЕ ДЖЕРЕЛО ПРАВДИ для дизайн-токенів усього сайту.
 * Підключається з кожної сторінки через include('../partials/theme').
 *
 * Мапа адаптивних одиниць (базово 1rem = 16px, як у браузері за замовчуванням).
 *
 * Відступи (padding/gap/margin) навмисно НЕ копіюють Figma піксель-в-піксель —
 * дизайн подекуди використовує значення, не кратні 4 (15px, 25px, 30px, 37px, 50px).
 * Замість купи власних spacing-токенів під кожне з них, усі відступи зведено
 * до мінімального набору стандартної шкали Tailwind (яка вже кратна 4px і
 * не потребує кастомних ключів): 2 (8px), 3 (12px), 4 (16px), 5 (20px),
 * 6 (24px), 7 (28px), 8 (32px), 10 (40px), 12 (48px), 14 (56px), 20 (80px), 24 (96px).
 * Ці самі кілька значень перевикористовуються по всьому шаблону.
 *
 * Розміри скруглень лишаються 1:1 з дизайном:
 *   px (Figma) → rem     → токен
 *   8px        → 0.5rem  → rounded-pill   (кнопки/чіпи)
 *   20px       → 1.25rem → rounded-blob   (таби "Про нас")
 *   30px       → 1.875rem → rounded-card
 *   35px       → 2.1875rem → rounded-hero (блок "Потрібна допомога")
 *   1760px     → 110rem  → max-w-shell (ширина контенту, замість вузького max-w-[1180px])
 *
 * ШРИФТИ (text-h1/h2/h3) — ГЛОБАЛЬНЕ налаштування, одне на весь сайт:
 * замість того, щоб на кожному заголовку вручну прописувати max-lg:/lg:/xl:/2xl:
 * (як було раніше — і його довелось дублювати в hero, "Потрібна допомога?" тощо),
 * розмір тепер computed один раз тут через CSS clamp(мінімум, в'язка до ширини
 * екрана, максимум). Токен масштабується сам, скрізь однаково:
 *   h1: 32px (мобільний мінімум) → 64px (десктопний максимум, 1:1 з Figma)
 *   h2: 24px → 40px
 *   h3: 18px → 24px
 * Мінімум/максимум і швидкість наростання підібрані так, щоб текст влазив
 * в один рядок навіть у найвужчих колонках сайту (hero, форма "Потрібна
 * допомога?"), тож локальних винятків більше не потрібно.
 */
%>
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: { navy: '#012a4a', sky: '#eff6f9', steel: '#527b8d' },
        fontFamily: {
          sans: ['Open Sans', 'Arial', 'sans-serif'],
          display: ['Geologica', 'Arial', 'sans-serif']
        },
        borderRadius: {
          pill: '0.5rem',   /* 8px  — кнопки, чіпи, поля форми */
          blob: '1.25rem',  /* 20px — таб-список "Про нас" */
          card: '1.875rem', /* 30px — білі картки-секції */
          hero: '2.1875rem' /* 35px — блок "Потрібна допомога" */
        },
        maxWidth: {
          /* 122rem = 1952px: контентна зона з дизайну (1760px) + компенсація
             власного 2xl:px-24 (96px * 2), щоб на великих екранах фактична
             ширина контенту (після відступів) дорівнювала точно 1760px. */
          shell: '122rem'
        },
        fontSize: {
          /* Глобальне адаптивне масштабування через clamp(мін, в'язка-до-vw, макс) —
             єдине джерело правди для розмірів заголовків по всьому сайту.
             h2 і h3 — це h1, помножений на сталий коефіцієнт (0.625 і 0.375,
             тобто 40/64 і 24/64), тому h1 > h2 > h3 гарантовано на БУДЬ-якій
             ширині екрана — раніше формули підбирались незалежно одна від
             одної й на певних ширинах h3 ставав більшим за h2. */
          h1: ['clamp(2rem, 0.5rem + 3.125vw, 4rem)', { lineHeight: '0.9', letterSpacing: '-0.03em' }],
          h2: ['clamp(1.25rem, 0.3125rem + 1.953125vw, 2.5rem)', { lineHeight: '1.05', letterSpacing: '-0.03em' }],
          h3: ['clamp(1.125rem, 0.1875rem + 1.171875vw, 1.5rem)', { lineHeight: '1.05', letterSpacing: '-0.03em' }]
        }
      }
    }
  };
</script>

<style>
  /* Плавний скрол для переходів за якорями (кнопки навігації). scroll-padding-top
     компенсує липку шапку, щоб заголовок секції не ховався під нею. */
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
    --reveal-ease: cubic-bezier(.16, 1, .3, 1); /* спільний м'який easing появи */
  }

  /* Плавний перехід МІЖ сторінками (крос-документні View Transitions). Браузери
     з підтримкою (Chromium 126+) роблять м'який кросфейд між навігаціями головна↔
     послуги; інші — звичайний перехід. Під prefers-reduced-motion API вимикається сам. */
  @view-transition { navigation: auto; }
  ::view-transition-old(root),
  ::view-transition-new(root) { animation-duration: .35s; }

  /* ── Поява блоків при скролі ─────────────────────────────────────────────
     Кожен "листовий" блок (секція без вкладених секцій — працює на обох
     сторінках) спершу приховано й зсунуто вниз, а IntersectionObserver додає
     .is-visible, коли блок входить у в'юпорт, і він плавно з'являється.
     Ховаємо ЛИШЕ коли:
       • JS увімкнено (клас .reveal-ready на <html> додає скрипт нижче) — інакше
         без JS блоки просто лишаються видимими;
       • користувач не просив зменшену анімацію (prefers-reduced-motion). */
  @media (prefers-reduced-motion: no-preference) {
    /* УСІ "листові" блоки з'являються однаково — поява "з центру": підйом + м'який
       зум + легке розмиття, що плавно сходить. Стосується й перших блоків над
       згином (вони анімуються при завантаженні, зокрема під час переходу сторінок). */
    html.reveal-ready main section:not(:has(section)) {
      opacity: 0;
      transform: translateY(44px) scale(.94);
      filter: blur(6px);
    }
    html.reveal-ready main section:not(:has(section)).is-visible {
      opacity: 1;
      transform: none;
      filter: none;
      transition: opacity .85s var(--reveal-ease),
                  transform .85s var(--reveal-ease),
                  filter .85s var(--reveal-ease);
    }

    /* Картки та схеми з іконками ([data-stagger]) — елементи ДОДАТКОВО з'являються
       по черзі, зі зростаючою затримкою, коли їхній блок відкривається. */
    html.reveal-ready [data-stagger] > * {
      opacity: 0;
      transform: translateY(26px) scale(.97);
    }
    html.reveal-ready main section.is-visible [data-stagger] > * {
      opacity: 1;
      transform: none;
      transition: opacity .55s var(--reveal-ease),
                  transform .55s var(--reveal-ease);
    }
    html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(1)  { transition-delay: 0s;   }
    html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(2)  { transition-delay: .06s; }
    html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(3)  { transition-delay: .12s; }
    html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(4)  { transition-delay: .18s; }
    html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(5)  { transition-delay: .24s; }
    html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(6)  { transition-delay: .30s; }
    html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(7)  { transition-delay: .36s; }
    html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(8)  { transition-delay: .42s; }
    html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(9)  { transition-delay: .48s; }
    html.reveal-ready main section.is-visible [data-stagger] > *:nth-child(n+10) { transition-delay: .54s; }

    /* Аварійний показ (IntersectionObserver не спрацював, напр. середовище без
       композитингу) — миттєво, без анімації, щоб контент не лишився прихованим. */
    html.reveal-ready main section:not(:has(section)).revealed-instant,
    html.reveal-ready main section.revealed-instant [data-stagger] > * {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>

<script>
  // Додаємо клас якнайраніше (скрипт стоїть ПЕРЕД контентом сторінки), щоб
  // блоки були приховані вже з першого кадру — без "мигання".
  document.documentElement.classList.add('reveal-ready');

  document.addEventListener('DOMContentLoaded', function () {
    // Поважаємо системну "зменшену анімацію" (у цьому режимі CSS блоки й не ховає).
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // "Листові" блоки — секції без вкладених секцій (на головній це прямі секції
    // <main>, на сторінці послуг — підсекції всередині макроблоків).
    var blocks = Array.prototype.filter.call(
      document.querySelectorAll('main section'),
      function (s) { return !s.querySelector('section'); }
    );
    var vh = function () { return window.innerHeight || document.documentElement.clientHeight; };
    // Блок вважаємо "у в'юпорті", коли його верх зайшов приблизно на третину екрана
    // (top < 65% висоти) — тоді поява починається, коли блок уже помітно в кадрі, а
    // не біля самого нижнього краю, де рух майже не видно.
    var inView = function (el) { return el.getBoundingClientRect().top < vh() * 0.65; };

    var pending = blocks.slice();
    var anyRevealed = false;
    var drop = function (el) { var i = pending.indexOf(el); if (i > -1) pending.splice(i, 1); };
    var showAnim = function (el) { // показати З АНІМАЦІЄЮ (над згином — на завантаженні, решта — на скролі)
      if (el.classList.contains('revealed-instant') || el.classList.contains('is-visible')) return;
      el.classList.add('is-visible'); drop(el); anyRevealed = true;
    };
    var showInstant = function (el) { // аварійний показ без анімації (лише як підстраховка)
      if (el.classList.contains('revealed-instant') || el.classList.contains('is-visible')) return;
      el.classList.add('revealed-instant'); drop(el); anyRevealed = true;
    };

    // Основний механізм — IntersectionObserver: анімує кожен блок, коли той входить
    // у в'юпорт. Блоки над згином теж анімуються — обсервер показує їх на старті,
    // тож перший блок «в'їжджає», а не з'являється миттєво (важливо при переходах).
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          showAnim(e.target);
          io.unobserve(e.target);
        });
      }, { threshold: 0, rootMargin: '0px 0px -35% 0px' });
      pending.slice().forEach(function (b) { io.observe(b); });
    }

    // Резерв на scroll: показує блок (з анімацією) ЛИШЕ коли він реально входить у
    // в'юпорт — нічого передчасно. Страхує, якщо IntersectionObserver не спрацьовує.
    var onScroll = function () {
      for (var i = pending.length - 1; i >= 0; i--) {
        if (inView(pending[i])) showAnim(pending[i]);
      }
      if (!pending.length) window.removeEventListener('scroll', onScroll);
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // На завантаженні одразу (з анімацією) показуємо блоки ПЕРШОГО ЕКРАНА — навіть
    // ті, що в нижній частині в'юпорта (напр. смуга фактів під хіро), щоб вони
    // з'являлись БЕЗ ГОРТАННЯ, а не чекали, доки їх доскролять.
    var revealFirstScreen = function () {
      var h = window.innerHeight || document.documentElement.clientHeight;
      for (var i = pending.length - 1; i >= 0; i--) {
        if (pending[i].getBoundingClientRect().top < h - 24) showAnim(pending[i]);
      }
    };
    window.addEventListener('load', function () {
      revealFirstScreen();
      // Підстраховка для середовищ без композитингу кадрів: якщо переходи не рухаються
      // (перший блок лишається прихованим) — знімаємо приховування зовсім, щоб контент
      // у жодному разі не лишився невидимим.
      setTimeout(function () {
        if (blocks[0] && getComputedStyle(blocks[0]).opacity === '0') {
          document.documentElement.classList.remove('reveal-ready');
        }
      }, 1200);
    });
  });
</script>
