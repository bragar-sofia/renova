<%
const getStageLabel = (key) => {
  return (
    projectStageLabels[key] ||
    key ||
    'Не визначено'
  );
};

const formErrors = Array.isArray(errors)
  ? errors
  : [];

const initialStage =
  Array.isArray(projectStages) && projectStages.length > 0
    ? projectStages[0]
    : 'request-received';
%>

<section class="min-h-screen bg-slate-50 px-4 py-6 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">

    <!-- Навігація -->
    <nav
      class="mb-5 flex flex-wrap items-center gap-2 text-sm text-slate-500"
      aria-label="Навігація"
    >
      <a
        href="/admin/projects"
        class="transition hover:text-navy"
      >
        Проєкти та заявки
      </a>

      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>

      <span class="text-slate-700">
        Нова заявка
      </span>
    </nav>

    <!-- Шапка сторінки -->
    <div
      class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between"
    >
      <div>
        <h1 class="text-2xl font-semibold text-slate-900 sm:text-3xl">
          Нова заявка
        </h1>

        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
          Додайте основну інформацію про обладнання та заплановані
          ремонтні роботи. Номер заявки буде створено автоматично.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a
          href="/admin/projects"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>

          До списку
        </a>

        <button
          type="submit"
          form="project-create-form"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-navy px-5 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-[#0b527b]"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M12 5v14"></path>
            <path d="M5 12h14"></path>
          </svg>

          Створити заявку
        </button>

        <%- include('../partials/logout-button') %>
      </div>
    </div>

    <!-- Помилки -->
    <% if (formErrors.length > 0) { %>
      <div
        class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-4 text-sm text-red-800"
        role="alert"
      >
        <div class="flex items-start gap-3">
          <svg
            class="mt-0.5 h-5 w-5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 8v5"></path>
            <path d="M12 17h.01"></path>
          </svg>

          <div>
            <p class="font-semibold">
              Перевірте введені дані:
            </p>

            <ul class="mt-2 list-disc space-y-1 pl-5">
              <% formErrors.forEach((error) => { %>
                <li><%= error %></li>
              <% }) %>
            </ul>
          </div>
        </div>
      </div>
    <% } %>

    <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_360px]">

      <!-- Основна форма -->
      <form
        id="project-create-form"
        action="/admin/projects"
        method="post"
        class="space-y-6"
      >
        <!-- Основна інформація -->
        <div
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
        >
          <div>
            <h2 class="text-lg font-semibold text-slate-900">
              Основна інформація
            </h2>

            <p class="mt-1 text-sm leading-6 text-slate-500">
              Назва проєкту, обладнання та основний вид ремонтних робіт.
            </p>
          </div>

          <div class="mt-6 space-y-5">
            <div>
              <label
                for="title"
                class="block text-sm font-semibold text-slate-700"
              >
                Заголовок проєкту
                <span class="text-red-500">*</span>
              </label>

              <input
                id="title"
                type="text"
                name="title"
                value="<%= project.title || '' %>"
                required
                autofocus
                class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-navy focus:ring-2 focus:ring-navy/10"
                placeholder="Наприклад: Капітальний ремонт токарного верстата 16К20"
              >

              <p class="mt-2 text-xs leading-5 text-slate-500">
                Цей заголовок відображатиметься в адмінпанелі та на сайті.
              </p>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <div>
                <label
                  for="equipment"
                  class="block text-sm font-semibold text-slate-700"
                >
                  Обладнання
                  <span class="text-red-500">*</span>
                </label>

                <input
                  id="equipment"
                  type="text"
                  name="equipment"
                  value="<%= project.equipment || '' %>"
                  required
                  class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-navy focus:ring-2 focus:ring-navy/10"
                  placeholder="Тип, виробник і модель"
                >

                <p class="mt-2 text-xs leading-5 text-slate-500">
                  Наприклад: токарний верстат 16К20.
                </p>
              </div>

              <div>
                <label
                  for="repairType"
                  class="block text-sm font-semibold text-slate-700"
                >
                  Вид ремонту
                  <span class="text-red-500">*</span>
                </label>

                <input
                  id="repairType"
                  type="text"
                  name="repairType"
                  value="<%= project.repairType || '' %>"
                  required
                  class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-navy focus:ring-2 focus:ring-navy/10"
                  placeholder="Наприклад: Капітальний ремонт"
                >

                <p class="mt-2 text-xs leading-5 text-slate-500">
                  Вкажіть основний вид або склад запланованих робіт.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Початковий етап -->
        <div
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
        >
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold text-slate-900">
                Початковий етап
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Після створення проєкт автоматично почне свою хронологію
                з першого етапу.
              </p>
            </div>

            <span
              class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700"
            >
              <%= getStageLabel(initialStage) %>
            </span>
          </div>

          <div class="mt-5">
            <label
              for="currentStageNote"
              class="block text-sm font-semibold text-slate-700"
            >
              Коментар до початкового етапу
            </label>

            <textarea
              id="currentStageNote"
              name="currentStageNote"
              rows="4"
              class="mt-2 block w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm leading-6 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-navy focus:ring-2 focus:ring-navy/10"
              placeholder="Наприклад: Отримано звернення щодо несправності шпиндельного вузла"
            ><%= project.currentStageNote || '' %></textarea>

            <p class="mt-2 text-xs leading-5 text-slate-500">
              Коментар буде додано до першого запису в хронології проєкту.
            </p>
          </div>
        </div>

        <!-- Опис -->
        <div
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
        >
          <div>
            <h2 class="text-lg font-semibold text-slate-900">
              Опис проєкту
            </h2>

            <p class="mt-1 text-sm leading-6 text-slate-500">
              Додайте відому на цей момент інформацію про несправність,
              стан обладнання та заплановані роботи.
            </p>
          </div>

          <div class="mt-5">
            <label
              for="description"
              class="sr-only"
            >
              Опис проєкту
            </label>

            <textarea
              id="description"
              name="description"
              rows="18"
              class="block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm leading-6 text-slate-900 outline-none transition focus:border-navy focus:ring-2 focus:ring-navy/10"
            ><%= project.description || '' %></textarea>
          </div>
        </div>

        <!-- Видимість -->
        <div
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
        >
          <h2 class="text-lg font-semibold text-slate-900">
            Відображення на сайті
          </h2>

          <label
            for="isVisible"
            class="mt-5 flex cursor-pointer items-start gap-4 rounded-xl border border-slate-200 p-4 transition hover:bg-slate-50"
          >
            <input
              id="isVisible"
              type="checkbox"
              name="isVisible"
              value="true"
              <%= project.isVisible ? 'checked' : '' %>
              class="mt-0.5 h-5 w-5 shrink-0 rounded border-slate-300 text-navy focus:ring-navy"
            >

            <span>
              <span class="block text-sm font-semibold text-slate-900">
                Показувати проєкт на сайті
              </span>

              <span class="mt-1 block text-sm leading-6 text-slate-500">
                Проєкт буде доступний у публічному переліку поточних робіт.
                Після завершення він автоматично перейде до портфоліо.
              </span>
            </span>
          </label>
        </div>

        <!-- Кнопки -->
        <div
          class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between"
        >
          <a
            href="/admin/projects"
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
          >
            Скасувати
          </a>

          <button
            type="submit"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-navy px-6 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-[#0b527b]"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M12 5v14"></path>
              <path d="M5 12h14"></path>
            </svg>

            Створити заявку
          </button>
        </div>
      </form>

      <!-- Права колонка -->
      <aside class="space-y-6">

        <!-- Автоматичні дані -->
        <div
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
        >
          <h2 class="text-base font-semibold text-slate-900">
            Буде створено автоматично
          </h2>

          <ul class="mt-5 space-y-4">
            <li class="flex items-start gap-3">
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-navy"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M5 4h14v16H5z"></path>
                  <path d="M9 8h6"></path>
                  <path d="M9 12h6"></path>
                </svg>
              </span>

              <div>
                <p class="text-sm font-semibold text-slate-900">
                  Номер заявки
                </p>

                <p class="mt-1 text-xs leading-5 text-slate-500">
                  Система згенерує унікальний шестизначний номер.
                </p>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-navy"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>
              </span>

              <div>
                <p class="text-sm font-semibold text-slate-900">
                  Дата створення
                </p>

                <p class="mt-1 text-xs leading-5 text-slate-500">
                  Дата створення заявки та початку першого етапу буде встановлена автоматично.
                </p>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-navy"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M4 12h16"></path>
                  <path d="m14 6 6 6-6 6"></path>
                </svg>
              </span>

              <div>
                <p class="text-sm font-semibold text-slate-900">
                  Початкова хронологія
                </p>

                <p class="mt-1 text-xs leading-5 text-slate-500">
                  У масив stages буде додано перший етап
                  «<%= getStageLabel(initialStage) %>».
                </p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Послідовність етапів -->
        <div
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
        >
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-base font-semibold text-slate-900">
              Етапи проєкту
            </h2>

            <span class="text-xs text-slate-500">
              <%= projectStages.length %>
            </span>
          </div>

          <ol class="mt-5 space-y-3">
            <% projectStages.forEach((stageKey, index) => { %>
              <li class="flex items-center gap-3">
                <span
                  class="<%= index === 0
                    ? 'border-navy bg-navy text-white'
                    : 'border-slate-300 bg-white text-slate-500'
                  %> flex h-7 w-7 shrink-0 items-center justify-center rounded-full border text-xs font-semibold"
                >
                  <%= index + 1 %>
                </span>

                <span
                  class="<%= index === 0
                    ? 'font-semibold text-slate-900'
                    : 'text-slate-500'
                  %> text-sm"
                >
                  <%= getStageLabel(stageKey) %>
                </span>
              </li>
            <% }) %>
          </ol>
        </div>

        <!-- Підказка -->
        <div
          class="rounded-2xl border border-amber-200 bg-amber-50 p-5"
        >
          <div class="flex items-start gap-3">
            <svg
              class="mt-0.5 h-5 w-5 shrink-0 text-amber-700"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 11v5"></path>
              <path d="M12 8h.01"></path>
            </svg>

            <div>
              <h2 class="text-sm font-semibold text-amber-900">
                Після створення
              </h2>

              <p class="mt-1 text-xs leading-5 text-amber-800">
                Ви перейдете на сторінку редагування, де зможете
                змінювати опис і переводити проєкт на наступні етапи.
              </p>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const editorElement = document.querySelector('#description');

    if (editorElement && window.ClassicEditor) {
      window.ClassicEditor
        .create(editorElement)
        .catch(function (error) {
          console.error(
            'CKEditor initialization error:',
            error
          );
        });
    }
  });
</script>
