<div class="min-h-screen bg-sky font-sans text-navy antialiased">
  <main>
    <section
      class="mx-auto flex min-h-[calc(100svh-5rem)] max-w-shell items-center px-6 py-10 lg:px-8 lg:py-14 xl:px-16 2xl:px-24"
    >
      <div
        class="relative grid w-full overflow-hidden rounded-hero bg-white shadow-[0_16px_42px_rgba(7,49,78,0.07)] lg:grid-cols-[minmax(0,1fr)_minmax(380px,0.8fr)]"
      >
        <!-- Контент -->
        <div
          class="relative z-10 flex flex-col justify-center px-6 py-12 sm:px-10 sm:py-16 lg:px-14 lg:py-20"
        >
          <p
            class="font-display text-[clamp(5rem,15vw,11rem)] font-normal leading-[0.8] text-steel/30"
            aria-hidden="true"
          >
            500
          </p>

          <h1
            class="mt-6 max-w-2xl font-display text-h1 font-normal text-navy"
          >
            Сталася помилка
          </h1>

          <p
            class="mt-4 max-w-xl text-base leading-7 text-steel"
          >
            Не вдалося виконати запит через тимчасову помилку сервера.
            Спробуйте оновити сторінку або поверніться трохи пізніше.
          </p>

          <div
            class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap"
          >
            <button
              type="button"
              class="inline-flex min-h-12 items-center justify-center rounded-pill bg-navy px-7 py-3 font-display text-base font-bold text-white transition hover:bg-[#0b527b]"
              onclick="window.location.reload()"
            >
              Спробувати ще раз
            </button>

            <a
              href="/"
              class="inline-flex min-h-12 items-center justify-center rounded-pill border-2 border-navy px-7 py-3 font-display text-base font-bold text-navy transition hover:bg-navy hover:text-white"
            >
              На головну
            </a>
          </div>

          <div
            class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-steel/20 pt-6 text-sm"
          >
            <a
              href="/services"
              class="group inline-flex items-center gap-2 font-semibold text-navy transition hover:text-steel"
            >
              Наші послуги

              <img
                class="h-3 w-auto -rotate-90 object-contain transition group-hover:translate-x-1"
                src="/images/icons/icon-chevron-inactive.svg"
                alt=""
                aria-hidden="true"
              >
            </a>

            <a
              href="/projects"
              class="group inline-flex items-center gap-2 font-semibold text-navy transition hover:text-steel"
            >
              Наші проєкти

              <img
                class="h-3 w-auto -rotate-90 object-contain transition group-hover:translate-x-1"
                src="/images/icons/icon-chevron-inactive.svg"
                alt=""
                aria-hidden="true"
              >
            </a>

            <a
              href="/#contacts"
              class="group inline-flex items-center gap-2 font-semibold text-navy transition hover:text-steel"
            >
              Зв'язатися з нами

              <img
                class="h-3 w-auto -rotate-90 object-contain transition group-hover:translate-x-1"
                src="/images/icons/icon-chevron-inactive.svg"
                alt=""
                aria-hidden="true"
              >
            </a>
          </div>
        </div>

        <!-- Візуальна частина -->
        <div
          class="relative min-h-[300px] overflow-hidden bg-steel lg:min-h-[560px]"
        >
          <span
            class="absolute inset-0 bg-gradient-to-br from-steel via-steel to-navy/80"
            aria-hidden="true"
          ></span>

          <img
            class="absolute inset-0 h-full w-full object-cover object-center opacity-70 mix-blend-multiply"
            src="/images/lathe-broken.png"
            alt=""
            aria-hidden="true"
          >

          <img
            class="pointer-events-none absolute -bottom-12 -right-12 w-[95%] max-w-[620px] opacity-35 mix-blend-multiply"
            src="/images/tools.png"
            alt=""
            aria-hidden="true"
          >

          <!-- Декоративний номер -->
          <div
            class="absolute inset-0 flex items-center justify-center"
            aria-hidden="true"
          >
            <span
              class="select-none font-display text-[clamp(8rem,20vw,17rem)] font-normal leading-none text-white/10"
            >
              500
            </span>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>
